+      {/* Строка состояния сканера — всегда на экране, как в сортировке (ff-sorting-scan-message) */}
+      <Typography
+        variant="caption"
+        color="text.secondary"
+        data-testid="ff-mp-pick-cell-scan-message"
+        data-task-id="MPFBO-01"
+        sx={{ display: 'block', mb: 1 }}
