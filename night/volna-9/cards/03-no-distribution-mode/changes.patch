+        collide = true;
+        collideWithBarcode = true;
+      }
+
+      if (!collide) {
+        var textEls = contentEl.querySelectorAll(".lb-text");
+        for (var ti = 0; ti < textEls.length && !collide; ti++) {
+          var range = document.createRange();
+          range.selectNodeContents(textEls[ti]);
+          var rects = range.getClientRects();
+          for (var ri = 0; ri < rects.length; ri++) {
+            if (overlapsEac(rects[ri])) { collide = true; break; }
+          }
+        }
+      }
+
+      corner.classList.toggle("eac-collide", collide);
+      cornerBanner.style.display = collide ? "flex" : "none";
+      if (collide) {
+        cornerBanner.textContent = collideWithBarcode
+          ? "⚠ Знак EAC в углу налезает на штрихкод — в этом углу на этом размере этикетки не хватает места, выберите другой угол или «Отдельной строкой»"
+          : "⚠ Текст наезжает на знак EAC в углу — сократите текст или уберите поле";
+      }
+    }
+
+    // counter + capacity lock
+    // used/cap считают только текстовые строки, которые выбирает пользователь. Штрихкод
+    // несъёмный и всегда один — включать его в счёт незачем и вводит в заблуждение (заказчик
+    // читал "6 из 6" как "шесть полей", хотя реально выбираемых строк было пять). Штрихкод и
+    // его зона показаны отдельно, в мм, в пояснении ниже.
+    var used = enabled.length;
+    document.getElementById("counterText").textContent = "Занято " + used + " из " + cap + " строк";
+    var pct = Math.min(100, Math.round((used / cap) * 100));
+    document.getElementById("counterFill").style.width = pct + "%";
+    var wrap = document.getElementById("counterWrap");
+    wrap.classList.toggle("full", used >= cap);
+    var noteEl = document.getElementById("counterNote");
+    var geomNote = "Предел — не число из головы: строка текста ≈ " +
+      (geom.bodyLineBoxMm + geom.lineGapMm).toFixed(1) + " мм. Штрихкод с цифрами занимает свою " +
+      "фиксированную зону наверху ≈ " + geom.barcodeZoneMm.toFixed(1) + " мм из " + size.h +
+      " мм высоты этикетки и в счёт строк не входит — как и знак EAC в углу.";
+    if (used >= cap) {
+      noteEl.textContent = "Свободных строк не осталось — чтобы включить другое поле, сначала выключите текущее. " + geomNote;
+    } else if (!noteEl.textContent || noteEl.textContent.indexOf("не помещалась") === -1) {
+      noteEl.textContent = geomNote;
+    }
+
+    var atCap = used >= cap;
+    order.forEach(function(k){
+      var cb = document.getElementById("chk-" + k);
+      var row = document.getElementById("row-" + k);
+      // a free-floating EAC (corner placement) doesn't cost a block, so it's never locked by cap
+      if (!state.checked[k] && atCap && costsBudget(k)) {
+        cb.disabled = true;
+        row.classList.add("locked");
+        row.title = "Свободных строк не осталось — сначала уберите другое поле";
+      } else {
+        cb.disabled = false;
+        row.classList.remove("locked");
+        row.removeAttribute("title");
+      }
+    });
+
+    // EAC "line" placement button: locked the same way a field checkbox locks at cap — refuse
+    // to let the user switch into a mode that would take a block with no free row for it.
+    var btnEacLine = document.getElementById("btnEacLine");
+    if (btnEacLine) {
+      var lineLocked = eacLineWouldOverflow();
+      btnEacLine.disabled = lineLocked;
+      btnEacLine.classList.toggle("locked", lineLocked);
+      if (lineLocked) {
+        btnEacLine.title = "Нет свободной строки — уберите одно поле или оставьте знак в углу";
+      } else {
+        btnEacLine.removeAttribute("title");
+      }
+    }
+  }
+
+  // initial paint
+  var initFreeText = document.getElementById("freeTextInput");
+  if (state.checked.freeText) initFreeText.classList.add("visible");
+  if (state.checked.eac) document.getElementById("eacPlacementWrap").classList.add("visible");
+  syncEacButtons();
+  syncAlignButtons();
+  render();
+
+})();
+</script>
+</body>
