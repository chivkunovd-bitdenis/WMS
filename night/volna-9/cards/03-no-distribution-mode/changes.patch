+      command: `npm run dev -- --host 0.0.0.0 --port ${e2eWebPort}`,
+      cwd: frontendDir,
+      env: {
+        ...process.env,
+        VITE_API_PROXY: `http://127.0.0.1:${e2eApiPort}`,
+        E2E_SELLER_PATH_PREFIX: '/seller',
