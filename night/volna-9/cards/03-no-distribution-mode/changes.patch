+  if (!res.ok) {
+    throw new Error(`emulator read stock -> ${res.status}: ${await res.text()}`)
+  }
+  const body = await res.json()
+  const row = (body.stocks ?? []).find((item) => Number(item.chrtId) === WB_CHRT_ID)
