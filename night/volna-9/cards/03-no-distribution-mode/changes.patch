+        >
+          {html ? (
+            <iframe
+              title="Предпросмотр этикетки"
+              srcDoc={html}
+              sandbox=""
+              style={{
+                display: 'block',
+                border: 0,
+                width: nativeWidthPx,
+                height: nativeHeightPx,
