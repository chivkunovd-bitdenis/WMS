+async function evalJs(page, expression, awaitPromise = true) {
+  const res = await page.send('Runtime.evaluate', {
+    expression,
+    awaitPromise,
+    returnByValue: true,
+  })
+  if (res.exceptionDetails) {
+    throw new Error(JSON.stringify(res.exceptionDetails))
+  }
+  return res.result?.value
+}
