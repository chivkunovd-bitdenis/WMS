+    </style>
+  </head>
+  <body>
+    <h1>Лист приёмки</h1>
+    <dl class="rs-head">
+      <div><dt>Номер</dt><dd>${escapeLabelHtml(documentNumberLabel)}</dd></div>
+      <div><dt>Селлер</dt><dd>${escapeLabelHtml(data.sellerName ?? '—')}</dd></div>
+      <div><dt>Склад</dt><dd>${escapeLabelHtml(data.warehouseName)}</dd></div>
