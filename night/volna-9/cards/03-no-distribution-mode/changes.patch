+            return (
+              <Accordion
+                key={product.product_id}
+                variant="outlined"
+                disableGutters
+                expanded={isExpanded}
+                onChange={(_e, nextExpanded) =>
+                  setExpandedByProductId((prev) => ({
+                    ...prev,
+                    [product.product_id]: nextExpanded,
+                  }))
+                }
+                sx={{
+                  minWidth: 0,
+                  '&:before': { display: 'none' },
+                  ...(done
