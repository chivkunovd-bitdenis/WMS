+
+  renderSellerChips();
+
+  // ---------- text alignment (segmented, same pattern as EAC placement) ----------
+  var btnAlignLeft = document.getElementById("btnAlignLeft");
+  var btnAlignCenter = document.getElementById("btnAlignCenter");
+  var btnAlignRight = document.getElementById("btnAlignRight");
+
+  function syncAlignButtons(){
+    btnAlignLeft.classList.toggle("active", state.textAlign === "left");
+    btnAlignCenter.classList.toggle("active", state.textAlign === "center");
+    btnAlignRight.classList.toggle("active", state.textAlign === "right");
+  }
+  function setTextAlign(align){
+    state.textAlign = align;
+    syncAlignButtons();
+    render();
+  }
+  btnAlignLeft.addEventListener("click", function(){ setTextAlign("left"); });
+  btnAlignCenter.addEventListener("click", function(){ setTextAlign("center"); });
+  btnAlignRight.addEventListener("click", function(){ setTextAlign("right"); });
+
+  // ---------- reset to standard template ----------
+  document.getElementById("btnResetStandard").addEventListener("click", function(){
+    optionalOrder().forEach(function(k){
+      var isStandard = STANDARD_FIELD_KEYS.indexOf(k) !== -1;
+      state.checked[k] = isStandard;
+      var cb = document.getElementById("chk-" + k);
+      if (cb) cb.checked = isStandard;
+    });
+    var ftInput = document.getElementById("freeTextInput");
+    if (ftInput) ftInput.classList.remove("visible");
+    state.eacPlacement = "br";
+    document.getElementById("eacPlacementWrap").classList.remove("visible");
+    syncEacButtons();
+    setTextAlign("left"); // also calls render()
+  });
+
+  // ---------- interaction ----------
+  function optionalOrder(){
+    return FIELD_DEFS.filter(function(f){ return f.group !== "missing"; }).map(function(f){ return f.key; });
+  }
+
+  // EAC in any corner placement (tl/tr/bl/br) overlays free space and never takes a block from
+  // the budget — only "line" placement does. This filters it out wherever we count blocks
+  // against CAPACITY.
+  function isEacCornerMode(){
+    return state.eacPlacement !== "line";
+  }
+  function costsBudget(key){
+    return !(key === "eac" && isEacCornerMode());
+  }
+
+  function checkedOptionalCount(){
+    var n = 0;
+    optionalOrder().forEach(function(k){ if (state.checked[k] && costsBudget(k)) n++; });
+    return n;
+  }
+
+  // Switching EAC from a free corner (tl/tr/bl/br) to "line" (costs a block) can push the block
+  // count past CAPACITY if there's no free row left — the counter would then show "6 из 5" and
+  // the switch button needs to be locked, the same way a field checkbox locks when the cap is full.
+  function eacLineWouldOverflow(){
+    if (!state.checked.eac) return false;
+    if (state.eacPlacement === "line") return false; // already there, nothing changes
+    return checkedOptionalCount() + 1 > CAPACITY[state.sizeKey];
+  }
+
+  function toggleField(key, isChecked){
+    state.checked[key] = isChecked;
+    if (key === "freeText") {
+      var input = document.getElementById("freeTextInput");
+      input.classList.toggle("visible", isChecked);
+      if (!isChecked) { /* keep typed text remembered but block disappears */ }
+    }
+    if (key === "eac") {
+      document.getElementById("eacPlacementWrap").classList.toggle("visible", isChecked);
+    }
+    render();
+  }
+
+  function setEacPlacement(mode){
+    if (mode === "line" && eacLineWouldOverflow()) return; // no free row — refuse the switch
+    state.eacPlacement = mode;
+    syncEacButtons();
+    render();
+  }
+
+  var CORNER_NOTE_NAMES = {
+    tl: "левом верхнем",
+    tr: "правом верхнем",
+    bl: "левом нижнем",
+    br: "правом нижнем"
+  };
+
+  function syncEacButtons(){
+    ["tl", "tr", "bl", "br"].forEach(function(corner){
+      var btn = document.getElementById("btnEac" + corner.toUpperCase());
+      if (btn) btn.classList.toggle("active", state.eacPlacement === corner);
+    });
+    document.getElementById("btnEacLine").classList.toggle("active", state.eacPlacement === "line");
+    var note = document.getElementById("eacPlacementNote");
+    if (isEacCornerMode()) {
+      note.innerHTML = "Не входит в счётчик строк — накладывается на свободное поле в " +
+        CORNER_NOTE_NAMES[state.eacPlacement] + " углу, отдельной строки не занимает.";
+    } else {
+      note.innerHTML = "Занимает отдельную строку и входит в счётчик строк — как остальные поля.";
+    }
+  }
+
+  function selectSize(key){
+    state.sizeKey = key;
+    SIZE_ORDER.forEach(function(k){
+      document.getElementById("size-" + k).classList.toggle("active", k === key);
+    });
+    // if the new size can't fit currently selected fields, trim from the tail
+    // of the fixed order (last-listed fields lose first) until it fits again
+    var cap = CAPACITY[key];
+    var order = optionalOrder();
+    var trimmed = false;
+    for (var i = order.length - 1; i >= 0; i--) {
+      if (checkedOptionalCount() <= cap) break;
+      var k2 = order[i];
+      if (!costsBudget(k2)) continue; // disabling a free-floating EAC wouldn't free a block anyway
+      if (state.checked[k2]) {
+        state.checked[k2] = false;
+        var cbEl = document.getElementById("chk-" + k2);
+        if (cbEl) cbEl.checked = false;
+        if (k2 === "freeText") {
+          var ftInput = document.getElementById("freeTextInput");
+          if (ftInput) ftInput.classList.remove("visible");
+        }
+        trimmed = true;
+      }
+    }
+    render();
+    if (trimmed) {
+      var note = document.getElementById("counterNote");
+      note.textContent = "На этом размере часть полей не помещалась — их пришлось выключить.";
+    }
+  }
+
+  // ---------- render ----------
+  function fieldText(key){
+    var p = PRODUCTS[state.demo];
+    switch(key){
+      case "name": return p.name;
+      case "sellerArticle": return "Арт. продавца: " + p.sellerArticle;
+      case "wbArticle": return "Артикул WB: " + p.wbArticle;
+      case "size": return "Размер: " + p.size;
+      case "color": return "Цвет: " + p.color;
+      case "brand": return "Бренд: " + p.brand;
+      case "composition": return "Состав: " + p.composition;
+      case "freeText": return state.freeText;
+      default: return "";
+    }
+  }
+
+  function render(){
+    var size = SIZES[state.sizeKey];
+    var cap = CAPACITY[state.sizeKey];
+    var geom = labelGeom(size);
+
+    // size label + physical dimensions
+    var labelEl = document.getElementById("label");
+    var wPx = size.w * SCALE, hPx = size.h * SCALE;
+    labelEl.style.width = wPx + "px";
+    labelEl.style.height = hPx + "px";
+    labelEl.classList.remove("is-overflow");
+    document.getElementById("labelDimsCaption").textContent = size.label;
+
+    // Все внутренние размеры этикетки — из мм реальной печати (labelGeom), переведённых
+    // в px тем же коэффициентом SCALE, что и корпус этикетки. Прописываем их как CSS-переменные
+    // (см. :root в <style>), чтобы штрихкод, цифры под ним и текст были в одном честном масштабе.
+    var root = document.documentElement.style;
+    root.setProperty("--lb-pad-top", (geom.padTopMm * SCALE) + "px");
+    root.setProperty("--lb-pad-side", (geom.padSideMm * SCALE) + "px");
+    root.setProperty("--lb-pad-bottom", (geom.padBottomMm * SCALE) + "px");
+    root.setProperty("--lb-barcode-w", (geom.barcodeWidthMm * SCALE) + "px");
+    root.setProperty("--lb-barcode-bars-h", (geom.barcodeBarsMm * SCALE) + "px");
+    root.setProperty("--lb-barcode-gap", (geom.digitsMarginTopMm * SCALE) + "px");
+    root.setProperty("--lb-barcode-margin-bottom", (geom.barcodeWrapMarginBottomMm * SCALE) + "px");
+    root.setProperty("--lb-digits-font", (geom.digitsFontPt * PT_TO_MM * SCALE) + "px");
+    root.setProperty("--lb-body-margin-top", (geom.bodyTopGapMm * SCALE) + "px");
+    root.setProperty("--lb-body-row-gap", (geom.lineGapMm * SCALE) + "px");
+    root.setProperty("--lb-text-font", (geom.bodyFontPt * PT_TO_MM * SCALE) + "px");
+    root.setProperty("--lb-name-font", (geom.nameFontPt * PT_TO_MM * SCALE) + "px");
+
+    document.getElementById("labelScaleCaption").textContent =
+      "содержимое (ШК, цифры, текст) в реальном масштабе печати, крупнее натуральной величины в ≈1.6× (6px/мм при экране ~96dpi)";
+
+    // available height for stacked field blocks — та же геометрия, что и в CAPACITY,
+    // чтобы визуальное обрезание совпадало с тем, что показывает счётчик строк.
+    var contentH = geom.availableForLinesMm * SCALE;
+    if (contentH < 0) contentH = 0;
+
+    var contentEl = document.getElementById("labelContent");
+    contentEl.style.height = contentH + "px";
+    contentEl.innerHTML = "";
+    // Выравнивание применяется ко всему текстовому блоку разом (наследуется всеми .lb-text
+    // внутри) — счётчик и штрихкод с цифрами лежат вне #labelContent и не наследуют его.
+    contentEl.style.textAlign = state.textAlign;
+
+    var order = optionalOrder();
+    // EAC in any corner placement is rendered separately as an absolute overlay (see below),
+    // not as a block in the flow — so it's excluded here from both layout and the block count.
+    var enabled = order.filter(function(k){
+      if (!state.checked[k]) return false;
+      if (k === "eac" && isEacCornerMode()) return false;
+      return true;
+    });
+
+    enabled.forEach(function(key, idx){
+      var block = document.createElement("div");
+      block.className = "label-block field-" + key;
+      if (key === "name") block.className += " field-name-block";
+
+      if (key === "eac") {
+        block.innerHTML = EAC_SVG;
+      } else {
+        var textVal = fieldText(key);
+        var span = document.createElement("div");
+        span.className = "lb-text";
+        if (key === "freeText" && !textVal) {
+          span.innerHTML = '<span class="freetext-placeholder">текст не задан</span>';
+        } else {
+          span.textContent = textVal;
+        }
+        block.appendChild(span);
+      }
+      contentEl.appendChild(block);
+    });
+
+    // mark first/last for clamp + shrink rules
+    var kids = Array.prototype.slice.call(contentEl.children);
+    kids.forEach(function(c, i){
+      c.classList.remove("is-mid", "is-last", "shrink-1", "shrink-2");
+      c.classList.add(i === kids.length - 1 ? "is-last" : "is-mid");
+    });
+
+    // shrink only the bottom (last enabled) block, progressively, until it fits
+    var overflowBanner = document.getElementById("overflowBanner");
+    overflowBanner.style.display = "none";
+    if (kids.length) {
+      var last = kids[kids.length - 1];
+      var fits = function(){ return contentEl.scrollHeight <= contentEl.clientHeight; };
+      if (!fits()) {
+        last.classList.add("shrink-1");
+      }
+      if (!fits()) {
+        last.classList.add("shrink-2");
+      }
+      if (!fits()) {
+        overflowBanner.style.display = "flex";
+        labelEl.classList.add("is-overflow");
+      }
+    }
+
+    // EAC corner overlay: rendered independently of the block flow, at its true minimum
+    // legible size (5mm), pinned to whichever corner the user picked (state.eacPlacement:
+    // tl/tr/bl/br). We then check whether the corner box visually overlaps something real —
+    // either a rendered text line, or (relevant mainly for the top corners, which sit right
+    // next to the wide barcode) the barcode block itself — using the same rectangle-overlap
+    // test for both, just applied to a different obstacle. If it overlaps, the mockup must
+    // show that collision rather than hide it.
+    var cornerBanner = document.getElementById("cornerCollisionBanner");
+    cornerBanner.style.display = "none";
+    var existingCorner = labelEl.querySelector(".eac-corner");
+    if (existingCorner) existingCorner.parentNode.removeChild(existingCorner);
+
+    if (state.checked.eac && isEacCornerMode()) {
+      var eacHeightPx = EAC_MIN_HEIGHT_MM * SCALE;
+      var eacWidthPx = eacHeightPx * EAC_ASPECT;
+      var corner = document.createElement("div");
+      corner.className = "eac-corner pos-" + state.eacPlacement;
+      corner.style.width = eacWidthPx + "px";
+      corner.style.height = eacHeightPx + "px";
+      corner.title = "Знак ЕАС: минимальная высота по требованиям к маркировке — 5 мм, меньше знак нечитаем";
+      corner.innerHTML = EAC_SVG;
+      labelEl.appendChild(corner);
+
+      var eacRect = corner.getBoundingClientRect();
+      function overlapsEac(r){
+        return r.left < eacRect.right && r.right > eacRect.left && r.top < eacRect.bottom && r.bottom > eacRect.top;
+      }
+
+      var collide = false;
+      var collideWithBarcode = false;
+
+      // Same rectangle-overlap test as for text below, applied to the barcode block's own
+      // box first — this is the case that matters for the top-left/top-right corners, since
+      // the barcode is wide (52mm of the label's width) and sits right where those corners are.
+      var barcodeWrap = labelEl.querySelector(".label-barcode");
