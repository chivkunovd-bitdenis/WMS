+    positiveStatus,
+  })
+
+  await browser.close()
+}
+
+try {
+  await main()
+} catch (error) {
+  evidence.status = 'BROWSER_PRODUCT_QA_FAILED'
+  evidence.error = error instanceof Error ? { message: error.message, stack: error.stack } : String(error)
