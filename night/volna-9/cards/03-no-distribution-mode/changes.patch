+  const [labelSize, setLabelSize] = useState<LabelSize>(() => resolveLabelSize(loadLabelSizeId(scope)))
+
+  useEffect(() => {
+    if (open) {
+      setLabelSize(resolveLabelSize(loadLabelSizeId(scope)))
+    }
+  }, [open, scope])
+
+  return (
+    <Dialog open={open} onClose={busy ? undefined : onClose} maxWidth="xs" fullWidth data-testid={testId}>
+      <DialogTitle>{title}</DialogTitle>
+      <DialogContent>
+        <Stack spacing={2} sx={{ pt: 0.5 }}>
+          {description ? (
+            <Typography variant="body2" color="text.secondary">
+              {description}
+            </Typography>
+          ) : null}
+          <LabelSizeSelect
+            value={labelSize.id}
+            onChange={setLabelSize}
+            scope={scope}
+            disabled={busy}
+            testId={`${testId}-size`}
+          />
+        </Stack>
+      </DialogContent>
+      <DialogActions>
+        <Button onClick={onClose} disabled={busy}>
+          Отмена
+        </Button>
+        <Button
+          variant="contained"
+          startIcon={<PrintOutlinedIcon />}
+          disabled={busy}
+          onClick={() => onConfirm(labelSize)}
+          data-testid={`${testId}-confirm`}
+        >
+          Печать
+        </Button>
+      </DialogActions>
+    </Dialog>
+  )
+}
