{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WMS Pipeline Budget Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "policy_version", "status", "currency", "purpose", "accounting", "limits", "hard_stop", "usage_receipt", "owner_override", "recovery_packet", "rules"],
  "properties": {
    "$schema": {"const": "./budget-policy.schema.json"},
    "policy_version": {"const": "1.0"},
    "status": {"const": "ACTIVE_FOR_DISPATCH"},
    "currency": {"const": "USD"},
    "purpose": {"type": "string", "minLength": 1},
    "accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_receipt_required", "runtime_enforcement_implemented", "runtime_gap"],
      "properties": {
        "runtime_receipt_required": {"const": true},
        "runtime_enforcement_implemented": {"const": false},
        "runtime_gap": {"type": "string", "minLength": 1}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["wave", "task", "card", "stage_tier"],
      "properties": {
        "wave": {"$ref": "#/$defs/scoped_limit"},
        "task": {"$ref": "#/$defs/scoped_limit"},
        "card": {"$ref": "#/$defs/scoped_limit"},
        "stage_tier": {
          "type": "object", "additionalProperties": false,
          "required": ["cheap", "moderate", "expensive"],
          "properties": {
            "cheap": {"$ref": "#/$defs/tier_limit"},
            "moderate": {"$ref": "#/$defs/tier_limit"},
            "expensive": {"$ref": "#/$defs/tier_limit"}
          }
        }
      }
    },
    "hard_stop": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "on_missing_usage_receipt", "on_budget_exceeded", "blocker_type", "reason_code"],
      "properties": {
        "enabled": {"const": true},
        "on_missing_usage_receipt": {"const": "block_next_stage"},
        "on_budget_exceeded": {"const": "hold_task"},
        "blocker_type": {"type": "string", "minLength": 1},
        "reason_code": {"const": "BUDGET_HARD_STOP"}
      }
    },
    "usage_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["required_fields"],
      "properties": {"required_fields": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}}}
    },
    "owner_override": {
      "type": "object", "additionalProperties": false,
      "required": ["marker", "requires_reason", "requires_new_limit", "expires_after_hours"],
      "properties": {
        "marker": {"type": "string", "pattern": "^PIPELINE_BUDGET_OVERRIDE"},
        "requires_reason": {"const": true},
        "requires_new_limit": {"const": true},
        "expires_after_hours": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "recovery_packet": {
      "type": "object", "additionalProperties": false,
      "required": ["required_on_hard_stop", "required_fields"],
      "properties": {
        "required_on_hard_stop": {"const": true},
        "required_fields": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "scoped_limit": {
      "type": "object", "additionalProperties": false,
      "required": ["max_usd", "max_tokens", "warning_ratio", "hard_stop_ratio"],
      "properties": {
        "max_usd": {"type": "number", "exclusiveMinimum": 0},
        "max_tokens": {"type": "integer", "exclusiveMinimum": 0},
        "warning_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "hard_stop_ratio": {"const": 1.0}
      }
    },
    "tier_limit": {
      "type": "object", "additionalProperties": false,
      "required": ["max_usd", "max_tokens"],
      "properties": {
        "max_usd": {"type": "number", "exclusiveMinimum": 0},
        "max_tokens": {"type": "integer", "exclusiveMinimum": 0}
      }
    }
  }
}
