{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WMS Pipeline Task State Snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id",
    "source_hash",
    "pipeline_version",
    "pipeline_hash",
    "traits",
    "required_stages",
    "current_stage",
    "status",
    "base_sha",
    "branch",
    "worktree",
    "owner_agent",
    "attempt",
    "lease_until",
    "heartbeat_at",
    "verdicts",
    "commits"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "source_hash": {"type": "string"},
    "pipeline_version": {"const": "2.0"},
    "pipeline_hash": {"type": "string"},
    "traits": {"type": "array", "items": {"type": "string"}},
    "required_stages": {"type": "array", "items": {"type": "string"}},
    "current_stage": {"type": "string"},
    "status": {"type": "string"},
    "base_sha": {"type": "string"},
    "branch": {"type": "string"},
    "worktree": {"type": "string"},
    "environment_id": {"type": "string"},
    "database": {"type": "string"},
    "redis_namespace": {"type": "string"},
    "celery_queue": {"type": "string"},
    "emulator_namespace": {"type": "string"},
    "owner_agent": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "lease_until": {"type": "string"},
    "heartbeat_at": {"type": "string"},
    "last_valid_receipt": {"type": ["string", "null"]},
    "blocker": {"type": ["object", "null"]},
    "resume_condition": {"type": ["object", "null"]},
    "verdicts": {"type": "object"},
    "commits": {"type": "array", "items": {"type": "string"}}
  }
}
