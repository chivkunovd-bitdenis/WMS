{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic check request",
  "type": "object",
  "additionalProperties": false,
  "required": ["check_id", "why_now", "working_directory", "argv", "timeout_seconds"],
  "properties": {
    "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"},
    "why_now": {"type": "string", "minLength": 20},
    "working_directory": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
    "expected_exit_codes": {"type": "array", "items": {"type": "integer"}, "default": [0]},
    "env_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,80}$"},
      "default": []
    }
  }
}
