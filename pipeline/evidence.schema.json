{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WMS Evidence Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id",
    "wave_id",
    "source_hash",
    "pipeline_hash",
    "code_sha",
    "environment_id",
    "role",
    "tenant",
    "case_ids",
    "timestamps",
    "producer",
    "commands",
    "artifact_hashes",
    "redaction_status"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "wave_id": {"type": "string"},
    "source_hash": {"type": "string"},
    "pipeline_hash": {"type": "string"},
    "code_sha": {"type": "string"},
    "integration_sha": {"type": "string"},
    "artifact_digests": {"type": "object"},
    "release_manifest_digest": {"type": "string"},
    "migration_head": {"type": "string"},
    "environment_id": {"type": "string"},
    "role": {"type": "string"},
    "tenant": {"type": "string"},
    "case_ids": {"type": "array", "items": {"type": "string"}},
    "fixture_versions": {"type": "object"},
    "browser": {"type": "object"},
    "device": {"type": "object"},
    "timestamps": {"type": "object"},
    "producer": {"type": "string"},
    "commands": {"type": "array", "items": {"type": "string"}},
    "artifact_hashes": {"type": "object"},
    "redaction_status": {"enum": ["REDACTION_VERIFIED"]}
  }
}
