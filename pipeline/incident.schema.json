{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WMS Incident Registry Entry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "source",
    "detected_at",
    "reported_at",
    "symptom",
    "business_damage",
    "screen",
    "zone",
    "process",
    "surface",
    "expected_behavior",
    "oracle",
    "reproduction_status",
    "fingerprint",
    "disposition",
    "status"
  ],
  "properties": {
    "id": {"type": "string"},
    "source": {"type": "string"},
    "detected_at": {"enum": ["production", "staging", "test", "review"]},
    "reported_at": {"type": "string"},
    "symptom": {"type": "string"},
    "business_damage": {"type": "string"},
    "screen": {"type": "string"},
    "zone": {"type": "string"},
    "process": {"type": "string"},
    "surface": {"type": "array", "items": {"type": "string"}},
    "actor_role": {"type": "string"},
    "tenant_scope": {"type": "string"},
    "expected_behavior": {"type": "string"},
    "oracle": {"type": "string"},
    "reproduction_status": {"type": "string"},
    "fixture": {"type": "string"},
    "root_cause": {"type": "string"},
    "escaped_because": {"type": "string"},
    "fingerprint": {"type": "string"},
    "fingerprint_version": {"type": "string"},
    "fingerprint_fields": {"type": "array", "items": {"type": "string"}},
    "reopened_from": {"type": ["string", "null"]},
    "regression_cases": {"type": "array", "items": {"type": "string"}},
    "fix_sha": {"type": ["string", "null"]},
    "code_review_verdict": {"type": ["string", "null"]},
    "functional_verdict": {"type": ["string", "null"]},
    "product_browser_verdict": {"type": ["string", "null"]},
    "production_trace": {"type": ["string", "null"]},
    "disposition": {
      "enum": [
        "FIXED_RELEASED",
        "FIXED_NOT_RELEASED",
        "NO_DEFECT",
        "DUPLICATE",
        "CANNOT_REPRODUCE_MONITORING",
        "REGRESSION_AFTER_FIX"
      ]
    },
    "status": {"type": "string"}
  }
}
