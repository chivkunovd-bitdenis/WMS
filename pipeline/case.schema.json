{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WMS Pipeline Case Card",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "screen",
    "zone",
    "process",
    "actor_role",
    "fixture",
    "steps",
    "executor_type",
    "automation_status",
    "oracle",
    "status"
  ],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "screen": {"type": "string"},
    "zone": {"type": "string"},
    "process": {"type": "string"},
    "actor_role": {"type": "string"},
    "tenant": {"type": "string"},
    "seller": {"type": "string"},
    "warehouse": {"type": "string"},
    "device": {"type": "string"},
    "fixture": {"type": "string"},
    "fixture_version": {"type": "string"},
    "fixture_builder": {"type": "string"},
    "external_mode": {"type": "string"},
    "preconditions": {"type": "array"},
    "adjacent_state": {"type": "string"},
    "variant": {"type": "string"},
    "steps": {"type": "array", "minItems": 1},
    "executor_type": {"type": "string"},
    "executable_ref": {"type": "string"},
    "test_id": {"type": "string"},
    "automation_status": {"type": "string"},
    "timeout": {"type": "string"},
    "expected_ui": {},
    "expected_api": {},
    "expected_authorization": {},
    "expected_transaction": {},
    "expected_db": {},
    "expected_worker": {},
    "expected_external": {},
    "expected_print": {},
    "read_back": {},
    "reload_assertion": {},
    "oracle": {"type": "string"},
    "oracle_version": {"type": "string"},
    "related_blocks": {"type": "array", "items": {"type": "string"}},
    "related_incidents": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["GOLD", "SNAPSHOT", "QUESTION", "FLAKY", "QUARANTINED"]}
  }
}
