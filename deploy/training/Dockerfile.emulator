FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY requirements-emulator.txt /tmp/requirements-emulator.txt
RUN pip install --no-cache-dir -r /tmp/requirements-emulator.txt
COPY src/emulator/wb_emulator /app/wb_emulator
RUN mkdir /data
CMD ["uvicorn", "wb_emulator.main:app", "--host", "0.0.0.0", "--port", "8000"]
