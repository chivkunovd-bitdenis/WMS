# Copy this file to .env on the production server and replace every value.
# Keep the real .env only on the server or in secret storage.

# Public HTTPS endpoint. DNS A/AAAA records must point to the server before first start.
WMS_PUBLIC_DOMAIN=wms.example.com
WMS_HTTP_PORT=80
WMS_HTTPS_PORT=443

# PostgreSQL container bootstrap.
POSTGRES_DB=wms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-long-random-password

# API database connection inside Docker network.
DATABASE_URL=postgresql+psycopg_async://postgres:replace-with-long-random-password@db:5432/wms

# Background jobs.
CELERY_BROKER_URL=redis://redis:6379/0

# API security. Generate unique production values.
# JWT must be at least 16 characters (enforced by backend settings).
JWT_SECRET_KEY=replace-with-long-random-secret-at-least-16-chars
# Optional Fernet key (urlsafe base64). If unsure, generate a real Fernet key for production.
WMS_SECRETS_FERNET_KEY=replace-with-real-fernet-key-or-leave-empty

# Seller portal: comma-separated emails allowed to pick/switch other shops (e.g. manager account).
# Also works for emails containing "vitalik" or users.can_manage_seller_shops in DB.
WMS_SHOP_MANAGER_EMAILS=

# --- WMS-377..383: адрес, почта, подписка ---

# Публичный адрес системы. Из него собираются ссылки в письмах-приглашениях и
# при восстановлении пароля. Без него ссылка соберётся из адреса запроса и за
# обратным прокси окажется неправильной.
WMS_PUBLIC_BASE_URL=https://wms.sellerfocus.pro

# Почта для приглашений и восстановления пароля. Пока WMS_SMTP_HOST пуст, письма
# не отправляются, а ссылка пишется в лог — систему можно поднять до того, как
# заведён ящик, и ничего не сломается.
WMS_SMTP_HOST=mail.nic.ru
WMS_SMTP_PORT=465
WMS_SMTP_USER=noreply@sellerfocus.pro
WMS_SMTP_PASSWORD=
WMS_MAIL_FROM=noreply@sellerfocus.pro
WMS_MAIL_FROM_NAME=Короб ВМС
# Сколько часов живёт ссылка из письма.
WMS_AUTH_LINK_TTL_HOURS=72

# Регистрация организации со страницы входа. Держим выключенной: до 06.09.2026
# любой человек из интернета заводил себе тенант в боевой системе.
WMS_ALLOW_PUBLIC_REGISTRATION=false

# Сумма подписки за месяц, рублей. Сама дата оплаты живёт в поле
# tenants.subscription_paid_until и проставляется владельцем.
WMS_SUBSCRIPTION_PRICE_RUB=10000
