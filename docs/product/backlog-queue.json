    {
      "id": "BLG-KC01",
      "title": "Развернуть клиентские входящие по приёмке, навигации, остаткам, отгрузке и печати",
      "source_section": "клиентский список 1-14",
      "client_items": [
        {
          "id": "KC-01",
          "title": "Красные бейджи входящих документов от селлера",
          "business_meaning": "Показывать цифры/единички напротив поставок и отгрузок, созданных селлером. Это сигнал ФФ, что появился входящий документ от селлера; это не счётчик расхождений или брака."
        },
        {
          "id": "KC-02",
          "title": "Счётчик приёмки по коробам",
          "business_meaning": "В приёмке оператор должен видеть прогресс по коробам, а не только по товарам или строкам."
        },
        {
          "id": "KC-03",
          "title": "Выбор склада на приёмке",
          "business_meaning": "Если складов несколько, товар должен приниматься на правильный склад; если склад один, лишний выбор не должен мешать."
        },
        {
          "id": "KC-04",
          "title": "Клик по логотипу ведёт на главную",
          "business_meaning": "Оператору нужен быстрый возврат на главный экран без поиска навигации."
        },
        {
          "id": "KC-05",
          "title": "Скрывать FBS-склады в общем списке",
          "business_meaning": "Служебные FBS-склады не должны мешать обычным складским сценариям и выбору рабочих складов."
        },
        {
          "id": "KC-06",
          "title": "Подтверждение закрытия при несохранённых изменениях",
          "business_meaning": "Введённая оператором работа не должна пропадать молча при закрытии экрана, модалки, Escape или клике вне окна."
        },
        {
          "id": "KC-07",
          "title": "Общий пул остатков не умножается по складам",
          "business_meaning": "Если всего доступно 500 единиц, система не должна разрешать поставить по 500 на каждый склад и переобещать товар маркетплейсу."
        },
        {
          "id": "KC-08",
          "title": "При скане отгрузки нельзя руками менять количество",
          "business_meaning": "Сканирование фиксирует физический факт отгрузки; ручное количество в scanner-flow ломает достоверность складского факта."
        },
        {
          "id": "KC-09",
          "title": "Убрать ячейку из коробов",
