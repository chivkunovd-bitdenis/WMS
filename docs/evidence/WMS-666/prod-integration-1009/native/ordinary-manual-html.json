[
  "<html><head>\n    <meta charset=\"utf-8\">\n    <title>Честный знак</title>\n    <style>\n  @page { size: 60mm 80mm; margin: 0; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body { font-family: Arial, Helvetica, sans-serif; color: #111; background: #fff; }\n  .label {\n    width: 60mm;\n    height: 78.5mm;\n    overflow: hidden;\n    page-break-inside: avoid;\n    break-inside: avoid;\n    page-break-after: always;\n    break-after: page;\n  }\n  .label:last-child { page-break-after: auto; break-after: auto; }\n  .label--cz {\n    padding: 1.55mm;\n    display: flex;\n    flex-direction: row;\n    align-items: stretch;\n  }\n  .cz-layout {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 1.03mm;\n  }\n  .cz-matrix {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 0;\n  }\n  .cz-matrix img {\n    width: 33.6mm;\n    height: 33.6mm;\n    object-fit: contain;\n    display: block;\n  }\n  .cz-info {\n    flex: 1 1 auto;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-start;\n    padding: 0.21mm 0 0;\n  }\n  .cz-brand {\n    margin: 0;\n    font-size: 7.8pt;\n    font-weight: 700;\n    line-height: 1.05;\n    letter-spacing: -0.02em;\n    text-transform: uppercase;\n  }\n  .cz-mark {\n    margin: 0.41mm 0 0.62mm;\n    width: 7.91mm;\n    height: 7.91mm;\n    border: 0.5mm solid #111;\n    border-radius: 0.86mm;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 7.2pt;\n    font-weight: 700;\n    line-height: 1;\n  }\n  .cz-field {\n    margin: 0;\n    font-size: 7.2pt;\n    line-height: 1.15;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .cz-field + .cz-field { margin-top: 0.36mm; }\n  .cz-field-label {\n    font-weight: 700;\n    margin-right: 0.52mm;\n  }\n  .cz-code {\n    margin: auto 0 0;\n    padding-top: 0.52mm;\n    font-size: 6.6pt;\n    line-height: 1.1;\n    word-break: break-all;\n  }\n  .label--cz-artifact {\n    padding: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .cz-artifact-img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n  }\n  .label--wb-qr {\n    padding: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n  }\n  .wb-qr-img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n  }\n  .wb-qr-position {\n    position: absolute;\n    top: 1.03mm;\n    right: 1.03mm;\n    min-width: 7.24mm;\n    padding: 0.62mm 1.03mm;\n    border: 0.31mm solid #111;\n    border-radius: 0.83mm;\n    background: #fff;\n    color: #111;\n    font-size: 11.5pt;\n    font-weight: 700;\n    line-height: 1;\n    text-align: center;\n  }\n  .label:not(.label--cz):not(.label--wb-qr) {\n    /* Take the allowance from whitespace, preserving the barcode/text area. */\n    padding: 0mm 1.86mm 0.98mm;\n    display: flex;\n    flex-direction: column;\n  }\n  \n  .barcode-wrap {\n    flex: 0 0 auto;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n    margin-bottom: 0.83mm;\n  }\n  .barcode-wrap img {\n    width: 53.79mm;\n    max-width: 100%;\n    height: auto;\n    max-height: 14.48mm;\n    object-fit: contain;\n    display: block;\n  }\n  .digits {\n    margin: 0.31mm 0 0;\n    font-size: 9.3pt;\n    letter-spacing: 0.04em;\n    text-align: center;\n    font-family: Arial, Helvetica, sans-serif;\n    line-height: 1.2;\n  }\n  .body {\n    --product-label-body-scale: 1;\n    flex: 1 1 auto;\n    min-height: 0;\n    overflow: hidden;\n    margin-top: 0.64mm;\n    line-height: 1.35;\n    font-size: calc(7.9pt * var(--product-label-body-scale));\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-start;\n  }\n  /*\n   * Межстрочный зазор — через margin-bottom, а не flex \"gap\": рендер термопринтера\n   * (и старые движки печати) часто игнорируют flex gap → строки слипаются и длинное\n   * название наезжает на «Артикул» (как на фото ИП Горячкина). margin работает везде.\n   */\n  .body > p {\n    margin: 0 0 calc(0.98mm * var(--product-label-body-scale));\n    flex: 0 0 auto;\n    flex-shrink: 0;\n  }\n  .body > p:last-child {\n    margin-bottom: 0;\n  }\n  .seller {\n    font-size: calc(7.9pt * var(--product-label-body-scale));\n    line-height: 1.35;\n    min-height: 3.75mm;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  /*\n   * Без max-height/overflow: название уже обрезано по символам в JS, поэтому строк\n   * ровно столько, сколько влезает, и они идут обычным потоком — «Артикул» всегда\n   * ниже названия и не может напечататься поверх (баг на термопринтере).\n   */\n  .name {\n    font-size: calc(8.1pt * var(--product-label-body-scale));\n    font-weight: 400;\n    line-height: 1.35;\n    word-break: break-word;\n  }\n  .meta {\n    line-height: 1.35;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .meta-composition {\n    white-space: nowrap;\n  }\n  .footer {\n    flex: 0 0 auto;\n    margin: 0.36mm 0 0;\n    font-size: 7.4pt;\n    text-align: left;\n    line-height: 1.2;\n  }\n\n</style>\n  </head>\n  <body><section class=\"label label--wb-qr\" data-testid=\"fbs-order-qr-label\" data-tape-block=\"wb_qr\">\n  <img class=\"wb-qr-img\" src=\"data:image/png;base64,\" alt=\"QR WB заказа\" data-testid=\"fbs-order-qr-img\">\n  <span class=\"wb-qr-position\" data-testid=\"fbs-order-qr-position\">№1</span>\n</section><section class=\"label label--cz\" data-testid=\"marking-thermal-label\" data-tape-block=\"cz\">\n  <div class=\"cz-layout\">\n    <div class=\"matrix cz-matrix\"><img src=\"data:image/png;base64,\" alt=\"ЧЗ\"></div>\n    <div class=\"cz-info\" data-testid=\"cz-label-info\">\n      <p class=\"cz-brand\">Честный<br>знак</p>\n      <div class=\"cz-mark\" aria-hidden=\"true\">ЧЗ</div>\n      <p class=\"cz-field cz-field--gtin\"><span class=\"cz-field-label\">GTIN</span>4600000000001</p>\n      <p class=\"cz-field cz-field--serial\"><span class=\"cz-field-label\">КМ</span>SERIAL-A</p>\n      <p class=\"cz-code\">…D\u001d92signed-A</p>\n    </div>\n  </div>\n</section><section class=\"label label--cz\" data-testid=\"marking-thermal-label\" data-tape-block=\"cz\">\n  <div class=\"cz-layout\">\n    <div class=\"matrix cz-matrix\"><img src=\"data:image/png;base64,\" alt=\"ЧЗ\"></div>\n    <div class=\"cz-info\" data-testid=\"cz-label-info\">\n      <p class=\"cz-brand\">Честный<br>знак</p>\n      <div class=\"cz-mark\" aria-hidden=\"true\">ЧЗ</div>\n      <p class=\"cz-field cz-field--gtin\"><span class=\"cz-field-label\">GTIN</span>4600000000001</p>\n      <p class=\"cz-field cz-field--serial\"><span class=\"cz-field-label\">КМ</span>SERIAL-A</p>\n      <p class=\"cz-code\">…D\u001d92signed-A</p>\n    </div>\n  </div>\n</section>\n</body></html>"
]