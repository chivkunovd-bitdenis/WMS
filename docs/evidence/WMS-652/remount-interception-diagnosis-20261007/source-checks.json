    "33-47": "33: class CDP {\n34:   constructor(url) {\n35:     this.ws = new WebSocket(url); this.next = 0; this.pending = new Map(); this.listeners = new Map();\n36:     this.ready = new Promise((resolve, reject) => { this.ws.onopen = resolve; this.ws.onerror = reject; });\n37:     this.ws.onmessage = event => {\n38:       const msg = JSON.parse(event.data);\n39:       if (msg.id) { const p = this.pending.get(msg.id); this.pending.delete(msg.id); if (p) { clearTimeout(p.timer); msg.error ? p.reject(Error(JSON.stringify(msg.error))) : p.resolve(msg.result); } }\n40:       else for (const f of this.listeners.get(msg.method) ?? []) Promise.resolve(f(msg.params)).catch(e => errors.push(String(e)));\n41:     };\n42:   }\n43:   async send(method, params = {}) {\n44:     await this.ready; const id = ++this.next;\n45:     return new Promise((resolve, reject) => { const timer = setTimeout(() => { this.pending.delete(id); reject(Error(`CDP timeout ${method}`)); }, 12000); this.pending.set(id, { resolve, reject, timer }); this.ws.send(JSON.stringify({ id, method, params })); });\n46:   }\n47:   on(method, callback) { this.listeners.set(method, [...this.listeners.get(method) ?? [], callback]); }",
    "60-63": "60: async function fulfill(id, body, status = 200, type = 'application/json') {\n61:   const bytes = Buffer.isBuffer(body) ? body : Buffer.from(JSON.stringify(body));\n62:   await cdp.send('Fetch.fulfillRequest', { requestId: id, responseCode: status, responseHeaders: [{ name: 'Content-Type', value: type }, { name: 'Access-Control-Allow-Origin', value: '*' }, { name: 'Access-Control-Allow-Headers', value: '*' }], body: bytes.toString('base64') });\n63: }",
    "75-91": "75: async function intercept({requestId,request}) {\n76:   const u=new URL(request.url),path=u.pathname.replace(/^\\/api/,'');\n77:   if(u.origin===ORIGIN&&!u.pathname.startsWith('/api/')&&!path.startsWith('/assets/qr-'))return cdp.send('Fetch.continueRequest',{requestId});\n78:   if(u.origin==='http://127.0.0.1:17843'&&path==='/print'){\n79:     if(request.method==='OPTIONS')return fulfill(requestId,{});\n80:     const job=JSON.parse(request.postData);printLog.push(job);trace.push(`print:${job.idempotencyKey}`);\n81:     const key=job.idempotencyKey;\n82:     if(!acceptedPrints.has(key))acceptedPrints.set(key,{job,receipt:`synthetic-${acceptedPrints.size+1}`});\n83:     if(receiptMode==='held'&&printLog.length===1){heldPrint=()=>fulfill(requestId,{receipt:acceptedPrints.get(key).receipt});return;}\n84:     if(receiptMode==='lost'&&!lostAck){lostAck=true;return cdp.send('Fetch.failRequest',{requestId,errorReason:'ConnectionClosed'});}\n85:     return fulfill(requestId,{receipt:acceptedPrints.get(key).receipt});\n86:   }\n87:   if(u.origin!==ORIGIN){blocked.push(request.url);return cdp.send('Fetch.failRequest',{requestId,errorReason:'BlockedByClient'});}\n88:   const body=request.postData?JSON.parse(request.postData):null;\n89:   requestLog.push({method:request.method,path:path+u.search,body});\n90:   const ws=path.match(/^\\/operations\\/fbs-supplies\\/([^/]+)\\/workspace$/);\n91:   if(ws)return fulfill(requestId,state[ws[1]]);",
    "159-162": "159:   cdp=new CDP(tabs.find(t=>t.type==='page').webSocketDebuggerUrl);cdp.on('Fetch.requestPaused',intercept);\n160:   cdp.on('Runtime.exceptionThrown',e=>errors.push(e.exceptionDetails));\n161:   await cdp.send('Page.enable');await cdp.send('Runtime.enable');\n162:   await cdp.send('Fetch.enable',{patterns:[{urlPattern:'*',requestStage:'Request'}]});",
    "388-403": "388:       }else if(receiptMode==='lost'){\n389:         for(let i=0;i<70&&!lostAck;i++)await sleep(100);\n390:         assert(lostAck,'fixture must lose native response after accepting job');await sleep(300);\n391:         assert.equal(trace.includes('pack:wb-a-order'),false,'lost accepted response cannot silently pack');\n392:         assert.equal(acceptedPrints.size,1,'one accepted print intent before explicit recovery');\n393:         if(variant==='remount-after-lost-ack'){\n394:           restored=true;\n395:           const saved=await evaluate('JSON.stringify(localStorage)');assert(saved.includes('wb-a-order'),'unfinished order intent must persist before remount');\n396:           await cdp.send('Page.navigate',{url:url+'&preserve=1'});\n397:           await until(`document.querySelector('[data-order-id=\"wb-a-order\"]')&&document.querySelector('[data-testid=\"fbs-unified-scan\"]')`);\n398:         }\n399:         await scan(qrCodes[0]);\n400:         for(let i=0;i<70&&!trace.includes('pack:wb-a-order');i++)await sleep(100);\n401:         assert(trace.includes('pack:wb-a-order'),'same QR must recover original order after uncertain receipt');\n402:         assert.deepEqual(printLog.map(j=>j.idempotencyKey),['scan-wb-a-order','scan-wb-a-order'],'retry must reconcile same accepted print key');\n403:         await scan(qrCodes[1]);await scan(cises[1]);",
