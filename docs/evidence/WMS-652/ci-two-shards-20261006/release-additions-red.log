rking-directory: backend\n        run: pytest -n auto tests/guards\n      - uses: actions/setup-node@v4\n        if: steps.integrity.outputs.frontend_tests != \'0\'\n        with:\n          node-version: "20"\n          cache: npm\n          cache-dependency-path: frontend/package-lock.json\n      - name: Approved frontend guards\n        if: steps.integrity.outputs.frontend_tests != \'0\'\n        working-directory: frontend\n        run: |\n          npm ci\n          npx vitest run src/guards\n\n  printer-windows:\n    timeout-minutes: 10\n    runs-on: windows-2022\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          persist-credentials: false\n      - uses: actions/setup-python@v5\n        with:\n          python-version: "3.13"\n      - run: python -m pip install pytest\n      - name: Persist receipt and recover unknown outcome on Windows\n        run: python -m pytest -q tools/print-agent/test_wms_print_direct.py tools/print-agent/test_wms_print_runtime.py -k "not test_safe_synthetic_queue_runs_real_child_process_once and not test_actual_process_exit_after_spool_acceptance_recovers_without_second_submit" --junitxml=native-print-windows.xml\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: printer-windows-contracts-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: native-print-windows.xml\n          retention-days: 14\n\n  process-proof:\n    # Required by the deployment verifier. Branch enforcement needs a separately\n    # installed trusted anchor; this candidate workflow cannot protect itself.\n    needs: [baseline, backend, frontend-build, guards, print-regressions, printer-windows]\n    timeout-minutes: 5\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-python@v5\n        with:\n          python-version: "3.11"\n      - uses: actions/download-artifact@v4\n        with:\n          name: backend-executed-contracts-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/process-proof\n      - uses: actions/download-artifact@v4\n        with:\n          name: frontend-executed-contracts-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/process-proof\n      - uses: actions/download-artifact@v4\n        with:\n          name: printer-windows-contracts-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/process-proof\n      - uses: actions/download-artifact@v4\n        with:\n          name: release-print-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/process-proof/print\n      - uses: actions/download-artifact@v4\n        with:\n          name: guard-executed-contracts-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/process-proof\n      - name: Verify every required named case and bind evidence to this attempt\n        env:\n          BASE_SHA: ${{ needs.baseline.outputs.base_sha }}\n          CANDIDATE_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n        run: python scripts/ci/build_process_proof.py --reports "$RUNNER_TEMP/process-proof" --base "$BASE_SHA"\n      - uses: actions/upload-artifact@v4\n        with:\n          name: process-proof-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/process-proof-final\n          if-no-files-found: error\n          retention-days: 30\n'

