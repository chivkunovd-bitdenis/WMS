+    @POST suspend fun post(@Url path: String, @Body body: JsonObject): Response<JsonElement>
+    @PATCH suspend fun patch(@Url path: String, @Body body: JsonObject): Response<JsonElement>
+    @PUT suspend fun put(@Url path: String, @Body body: JsonObject): Response<JsonElement>
+    @DELETE suspend fun delete(@Url path: String): Response<JsonElement>
+}
