--- /dev/null
+++ b/android/app/src/main/java/ru/wms/tsd/features/inbound/InboundDraftViewModel.kt
@@ -0,0 +1,223 @@
+package ru.wms.tsd.features.inbound
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.ViewModelProvider
+import androidx.lifecycle.viewModelScope
+import java.util.UUID
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.decodeFromString
+import kotlinx.serialization.json.*
+import ru.wms.tsd.core.api.ApiProvider
+import ru.wms.tsd.core.api.inbound.*
+import ru.wms.tsd.core.api.networkErrorText
+import ru.wms.tsd.core.api.readableError
+import ru.wms.tsd.ui.patterns.ScanFlash
+
+@Serializable data class IntakeAttempt(val method: String, val path: String, val body: JsonObject, val kind: String = "mutation")
+@Serializable data class IntakeLocal(
+    val warehouseId: String = "", val sellerId: String = "",
+    val totals: Map<String, String> = emptyMap(), val pending: IntakeAttempt? = null, val createdId: String? = null,
+)
+data class InboundDraftState(
+    val loading: Boolean = true, val busy: Boolean = false, val error: String? = null,
+    val request: DraftRequest? = null, val sellers: List<DraftChoice> = emptyList(),
+    val warehouses: List<DraftChoice> = emptyList(), val catalog: List<DraftProduct> = emptyList(),
+    val local: IntakeLocal = IntakeLocal(), val createdId: String? = null,
+    val containerKind: String? = null, val containerId: String? = null,
+    val flash: ScanFlash = ScanFlash.None,
+)
+
+internal fun intakeQuantity(raw: String): Int? =
+    raw.takeIf { it.matches(Regex("[0-9]+")) }?.toIntOrNull()?.takeIf { it in 0..1_000_000_000 }
+
+class InboundDraftViewModel(private val id: String?, private val api: ApiProvider) : ViewModel() {
+    private val json = Json { ignoreUnknownKeys = true }
+    private val scope = api.inboundScope()
+    private val document = id ?: "create"
+    private val base = "operations/inbound-intake-requests"
+    private val _state = MutableStateFlow(InboundDraftState())
+    val state: StateFlow<InboundDraftState> = _state
+    private val scans = Channel<String>(32)
+    private var catalogVersion = 0
+
+    init {
+        try {
+            val local = api.pendingInbound(scope, document)?.let { json.decodeFromString<IntakeLocal>(it) } ?: IntakeLocal()
+            _state.update { it.copy(local = local, createdId = local.createdId) }
+            load()
+        } catch (_: Exception) {
+            _state.update { it.copy(loading = false, error = "Не удалось восстановить сохранённый запрос приёмки.") }
+        }
+        viewModelScope.launch { for (barcode in scans) scan(barcode) }
+    }
+
+    private fun persist(local: IntakeLocal) {
+        check(api.inboundScope() == scope) { "Сотрудник или сервер изменился. Откройте приёмку заново." }
+        api.saveInbound(scope, document, json.encodeToString(local))
+        _state.update { it.copy(local = local) }
+    }
+    private fun fail(message: String) { _state.update { it.copy(error = message, flash = ScanFlash.Error(message, System.nanoTime())) } }
+    fun setSelection(warehouse: String = state.value.local.warehouseId, seller: String = state.value.local.sellerId) {
+        if (state.value.local.pending != null) return
+        runCatching { persist(state.value.local.copy(warehouseId = warehouse, sellerId = seller)) }.onFailure { fail(it.message ?: networkErrorText()) }
+    }
+    fun editTotal(lineId: String, value: String) {
+        val current = state.value.request?.lines?.firstOrNull { it.id == lineId }?.acceptedQty
+        val totals = if (current != null && intakeQuantity(value) == current) {
+            state.value.local.totals - lineId
+        } else {
+            state.value.local.totals + (lineId to value)
+        }
+        runCatching { persist(state.value.local.copy(totals = totals)) }.onFailure { fail(it.message ?: networkErrorText()) }
+    }
+    fun selectContainer(kind: String?, containerId: String?) { _state.update { it.copy(containerKind = kind, containerId = containerId, error = null) } }
+    fun load() {
+        viewModelScope.launch {
+            try {
+                if (id == null) {
+                    val sellers = api.inboundDraft().sellers()
+                    val warehouses = api.inboundDraft().warehouses()
+                    check(sellers.isSuccessful) { sellers.readableError() }
+                    check(warehouses.isSuccessful) { warehouses.readableError() }
+                    _state.update { it.copy(sellers = sellers.body().orEmpty(), warehouses = warehouses.body().orEmpty()) }
+                    if (state.value.local.pending == null) {
+                        setSelection(state.value.local.warehouseId.ifBlank { state.value.warehouses.singleOrNull()?.id.orEmpty() },
+                            state.value.local.sellerId.ifBlank { state.value.sellers.singleOrNull()?.id.orEmpty() })
+                    }
+                } else refresh()
+                _state.update { it.copy(loading = false) }
+            } catch (e: Exception) { if (e is CancellationException) throw e; _state.update { it.copy(loading = false) }; fail(e.message ?: networkErrorText()) }
+        }
+    }
+    private suspend fun refresh() {
+        if (id == null) return
+        val response = api.inboundDraft().get(id)
+        check(response.isSuccessful) { response.readableError() }
+        _state.update { it.copy(request = response.body()) }
+    }
+    fun searchCatalog(search: String) {
+        val version = ++catalogVersion
+        viewModelScope.launch {
+            try {
+                val request = state.value.request ?: return@launch
+                val result = api.inboundDraft().catalog(request.sellerId, search)
+                check(result.isSuccessful) { result.readableError() }
+                if (version == catalogVersion) _state.update { it.copy(catalog = result.body().orEmpty()) }
+            } catch (e: Exception) { if (e is CancellationException) throw e; fail(e.message ?: networkErrorText()) }
+        }
+    }
+    private fun attempt(method: String, path: String, body: JsonObject = buildJsonObject {}, kind: String = "mutation") {
+        if (state.value.busy || state.value.local.pending != null) { fail("Сначала проверьте результат предыдущего запроса."); return }
+        viewModelScope.launch { execute(IntakeAttempt(method, path, body, kind)) }
+    }
+    private suspend fun execute(attempt: IntakeAttempt) {
+        if (state.value.local.pending != null && state.value.local.pending != attempt) { fail("Проверьте предыдущий запрос."); return }
+        try {
+            persist(state.value.local.copy(pending = attempt)) // durable before HTTP
+            _state.update { it.copy(busy = true, error = null) }
+            val service = api.inboundDraft()
+            val response = when (attempt.method) {
+                "PATCH" -> service.patch(attempt.path, attempt.body)
+                "PUT" -> service.put(attempt.path, attempt.body)
+                "DELETE" -> service.delete(attempt.path)
+                else -> service.post(attempt.path, attempt.body)
+            }
+            if (!response.isSuccessful) {
+                val message = response.readableError()
+                // A definite refusal did not apply the operation; the user's total stays in the form.
+                if (response.code() in 400..499 && response.code() !in listOf(408, 429)) persist(state.value.local.copy(pending = null))
+                fail(if (message.contains("actual_below_container_total")) "В таре больше товара. Уточните количество в конкретном коробе или грузоместе, затем сохраните введённое количество." else message)
+                return
+            }
+            val created = if (attempt.kind == "create") response.body()?.jsonObject?.get("id")?.jsonPrimitive?.content else null
+            val lineId = when (attempt.method) {
+                "PATCH" -> attempt.path.substringBeforeLast('/').substringAfterLast('/')
+                "DELETE" -> attempt.path.substringAfterLast('/')
+                else -> null
+            }
+            persist(state.value.local.copy(pending = null, createdId = created ?: state.value.local.createdId, totals = state.value.local.totals - setOfNotNull(lineId)))
+            _state.update { it.copy(createdId = created, flash = ScanFlash.Success(System.nanoTime())) }
+            if (id != null) refresh()
+        } catch (e: Exception) {
+            if (e is CancellationException) throw e
+            fail(if (state.value.local.pending != null) "Ответ не получен. Проверьте результат запроса." else (e.message ?: networkErrorText()))
+        } finally { _state.update { it.copy(busy = false) } }
+    }
+    fun retry() {
+        val pending = state.value.local.pending ?: return load()
+        if (state.value.busy) return
+        viewModelScope.launch {
+            if (pending.kind == "container") {
+                // Legacy container creation has no retry receipt. Inspect its result, never duplicate it blindly.
+                try { refresh(); persist(state.value.local.copy(pending = null)); fail("Список тары обновлён. Проверьте созданные короба и грузоместа.") }
+                catch (e: Exception) { if (e is CancellationException) throw e; fail(networkErrorText()) }
+            } else execute(pending)
+        }
+    }
+    fun acknowledgeCreated() { persist(state.value.local.copy(createdId = null)) }
+    fun create() {
+        val local = state.value.local
+        if (local.warehouseId.isBlank() || local.sellerId.isBlank()) { fail("Выберите склад и селлера."); return }
+        attempt("POST", base, buildJsonObject { put("warehouse_id", local.warehouseId); put("seller_id", local.sellerId); put("client_request_id", UUID.randomUUID().toString()) }, "create")
+    }
+    fun addProduct(productId: String, raw: String) {
+        val quantity = intakeQuantity(raw)?.takeIf { it > 0 } ?: return fail("Введите целое количество больше нуля.")
+        if (state.value.request?.editable != true) return
+        attempt("POST", "$base/$id/lines", buildJsonObject { put("product_id", productId); put("expected_qty", quantity); put("increment", true); put("mutation_id", UUID.randomUUID().toString()) })
+    }
+    fun saveTotal(lineId: String) {
+        val qty = intakeQuantity(state.value.local.totals[lineId].orEmpty()) ?: return fail("Введите целое неотрицательное количество.")
+        attempt("PATCH", "$base/$id/lines/$lineId/expected", buildJsonObject { put("expected_qty", qty); put("mutation_id", UUID.randomUUID().toString()) })
+    }
+    fun deleteLine(lineId: String) { attempt("DELETE", "$base/$id/lines/$lineId") }
+    fun createContainer(kind: String) { attempt("POST", "$base/$id/$kind", buildJsonObject { put("quantity", 1) }, "container") }
+    fun saveContainer(productId: String, raw: String) {
+        val qty = intakeQuantity(raw)?.takeIf { it <= 100_000 } ?: return fail("Введите целое количество от 0 до 100000.")
+        val current = state.value
+        attempt("PUT", "$base/$id/${current.containerKind}/${current.containerId}/lines/$productId", buildJsonObject { put("quantity", qty); put("mutation_id", UUID.randomUUID().toString()) })
+    }
+    fun complete() {
+        if (state.value.local.totals.isNotEmpty()) { fail("Сохраните введённое количество перед завершением приёмки."); return }
+        attempt("POST", "$base/$id/complete-receiving", buildJsonObject { put("mutation_id", UUID.randomUUID().toString()) }, "complete")
+    }
+    fun onScan(barcode: String) { if (!scans.trySend(barcode.trim()).isSuccess) fail("Дождитесь обработки сканов и повторите сканирование.") }
+    private suspend fun scan(barcode: String) {
+        val current = state.value
+        val request = current.request ?: return
+        if (!request.editable || barcode.isEmpty()) return
+        if (current.local.pending != null || current.busy) { fail("Проверьте предыдущий запрос и повторите скан."); return }
+        val container = request.boxes.firstOrNull { it.barcode == barcode } ?: request.cargoPlaces.firstOrNull { it.barcode == barcode }
+        if (container != null) { selectContainer(if (container.boxNumber != null) "boxes" else "cargo-places", container.id); return }
+        if (current.containerId != null) {
+            _state.update { it.copy(busy = true) }
+            try {
+                val response = api.inboundDraft().catalog(request.sellerId, barcode)
+                check(response.isSuccessful) { response.readableError() }
+                val matches = response.body().orEmpty().filter { barcode in it.barcodes }
+                val product = matches.singleOrNull() ?: return fail(if (matches.isEmpty()) "Товар не найден. Выберите товар в каталоге." else "Несколько товаров с этим кодом. Выберите товар в каталоге.")
+                execute(IntakeAttempt("POST", "$base/$id/${current.containerKind}/${current.containerId}/scan", buildJsonObject { put("barcode", barcode); put("product_id", product.id); put("mutation_id", UUID.randomUUID().toString()) }))
+            } catch (e: Exception) { if (e is CancellationException) throw e; fail(e.message ?: networkErrorText()) }
+            finally { _state.update { it.copy(busy = false) } }
+        } else {
+            _state.update { it.copy(busy = true) }
+            try {
+                val response = api.inboundDraft().catalog(request.sellerId, barcode)
+                check(response.isSuccessful) { response.readableError() }
+                val matches = response.body().orEmpty().filter { barcode in it.barcodes }
+                val product = matches.singleOrNull() ?: return fail(if (matches.isEmpty()) "Товар не найден. Выберите товар в каталоге." else "Несколько товаров с этим кодом. Выберите товар в каталоге.")
+                execute(IntakeAttempt("POST", "$base/$id/lines", buildJsonObject { put("product_id", product.id); put("expected_qty", 1); put("increment", true); put("mutation_id", UUID.randomUUID().toString()) }))
+            } catch (e: Exception) { if (e is CancellationException) throw e; fail(e.message ?: networkErrorText()) }
+            finally { _state.update { it.copy(busy = false) } }
+        }
+    }
+    class Factory(private val id: String?, private val api: ApiProvider) : ViewModelProvider.Factory {
+        @Suppress("UNCHECKED_CAST") override fun <T : ViewModel> create(modelClass: Class<T>): T = InboundDraftViewModel(id, api) as T
+    }
+}
