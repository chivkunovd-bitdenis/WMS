+fun looseRemaining(
+    line: InboundIntakeLineOut,
+    boxes: List<InboundIntakeBoxOut>,
+    cargoPlaces: List<SortingCargoPlaceOut> = emptyList(),
+): Int {
     val lineRemaining = (line.actualQty ?: 0) - line.postedQty
     val inBoxes = boxes.sumOf { box ->
         box.lines.orEmpty().filter { it.productId == line.productId }.sumOf { it.remainingQty ?: 0 }
     }
-    return (lineRemaining - inBoxes).coerceAtLeast(0)
+    val inCargo = cargoPlaces.sumOf { place ->
+        place.lines.filter { it.productId == line.productId }.sumOf { it.remainingQty ?: 0 }
+    }
+    return (lineRemaining - inBoxes - inCargo).coerceAtLeast(0)
 }
