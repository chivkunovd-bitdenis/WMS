+package ru.wms.tsd.features.sorting
+
+import io.mockk.every
+import io.mockk.mockk
+import kotlinx.coroutines.runBlocking
+import okhttp3.mockwebserver.MockWebServer
+import org.junit.Assert.*
+import org.junit.Test
+import ru.wms.tsd.core.api.ApiProvider
+import ru.wms.tsd.core.api.sorting.LoosePutawayBody
+import ru.wms.tsd.core.api.sorting.CargoPlacePutawayBody
+import ru.wms.tsd.core.auth.AuthManager
+import ru.wms.tsd.core.auth.AuthSession
+import ru.wms.tsd.core.auth.AuthStore
+
+class SortingSessionTest {
+    @Test
+    fun `pending intent is isolated by server employee and document and old screen cannot send as new user`() = runBlocking {
+        val server = MockWebServer()
+        server.start()
+        try {
+            var url = server.url("/").toString()
+            var user = AuthSession(
+                userId = "first-user-id",
+                organizationSlug = "tenant",
+                displayName = "First",
+                jobTitle = null,
+                token = "fixture",
+            )
+            val store = mockk<AuthStore>()
+            val auth = mockk<AuthManager>()
+            val disk = mutableMapOf<List<String>, String?>()
+            every { store.getBaseUrl() } answers { url }
+            every { auth.getCurrentSession() } answers { user }
+            every { store.getLoosePutaway(any(), any(), any()) } answers { disk[listOf("loose", firstArg(), secondArg(), thirdArg())] }
+            every { store.saveLoosePutaway(any(), any(), any(), any()) } answers {
+                disk[listOf("loose", firstArg(), secondArg(), thirdArg())] = arg(3)
+            }
+            every { store.saveCargoPutaway(any(), any(), any(), any(), any()) } answers {
+                disk[listOf("cargo", firstArg(), secondArg(), thirdArg())] = arg(3)
+            }
+            every { store.getCargoPutaway(any(), any(), any()) } answers { disk[listOf("cargo", firstArg(), secondArg(), thirdArg())] }
+            val api = ApiProvider(store, auth)
+            val first = api.sortingContext()
+            val body = LoosePutawayBody("operation", "product", "cell", 1)
+            api.saveLoosePutaway(first, "document", body)
+            assertEquals(body, api.pendingLoosePutaway(first, "document"))
+            assertNull(api.pendingLoosePutaway(first, "other-document"))
+            val cargo = CargoPlacePutawayBody("cargo_place", "cargo", "cell", "document", "operation")
+            api.saveCargoPutaway(first, "document", cargo)
+            assertEquals(cargo, api.pendingCargoPutaway(first, "document"))
+            assertNull(api.pendingCargoPutaway(first, "other-document"))
+            val oldScreenApi = api.sorting(first)
+            user = user.copy(userId = "second-user-id")
+            assertNull(api.pendingLoosePutaway(api.sortingContext(), "document"))
+            assertNull(api.pendingCargoPutaway(api.sortingContext(), "document"))
+            assertTrue(runCatching { oldScreenApi.loosePutaway("document", body) }.isFailure)
+            assertEquals(0, server.requestCount)
+            user = user.copy(userId = "first-user-id")
+            url = server.url("/another/").toString()
+            assertNull(api.pendingLoosePutaway(api.sortingContext(), "document"))
+            assertNull(api.pendingCargoPutaway(api.sortingContext(), "document"))
+            assertTrue(runCatching { oldScreenApi.loosePutaway("document", body) }.isFailure)
+            assertEquals(0, server.requestCount)
+            // Returning to the original scope can recover the original intent.
+            url = server.url("/").toString()
+            assertEquals(body, api.pendingLoosePutaway(api.sortingContext(), "document"))
+            assertEquals(cargo, api.pendingCargoPutaway(api.sortingContext(), "document"))
+        } finally { server.shutdown() }
+    }
+}
