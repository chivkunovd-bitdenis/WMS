+        OutlinedButton(onClick = { open = true }, enabled = enabled, modifier = Modifier.fillMaxWidth()) { Text("$label: ${choices.firstOrNull { it.id == value }?.label ?: "Выбрать"}") }
+        if (open) AlertDialog(onDismissRequest = { open = false }, title = { Text(label) }, text = {
+            Column {
+                OutlinedTextField(query, { query = it }, label = { Text("Поиск") }, singleLine = true)
+                LazyColumn(Modifier.heightIn(max = 300.dp)) { items(choices.filter { it.label.contains(query, true) }, key = { it.id }) { choice ->
+                    TextButton(onClick = { onSelect(choice.id); open = false }, modifier = Modifier.fillMaxWidth()) { Text(choice.label) }
+                } }
+            }
+        }, confirmButton = { TextButton(onClick = { open = false }) { Text("Закрыть") } })
+    }
+}
diff --git a/android/app/src/main/java/ru/wms/tsd/features/inbound/InboundDraftViewModel.kt b/android/app/src/main/java/ru/wms/tsd/features/inbound/InboundDraftViewModel.kt
