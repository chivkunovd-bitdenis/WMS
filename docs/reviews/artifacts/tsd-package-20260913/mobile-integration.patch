+    @SerialName("seller_name") val sellerName: String? = null,
+    @SerialName("planned_delivery_date") val plannedDeliveryDate: String? = null,
+    @SerialName("planned_box_count") val plannedBoxCount: Int? = null,
+    @SerialName("actual_box_count") val actualBoxCount: Int? = null,
+    @SerialName("has_discrepancy") val hasDiscrepancy: Boolean? = null,
+    @SerialName("boxes_discrepancy") val boxesDiscrepancy: Boolean? = null,
+) { val isFfDraft get() = status == "draft" && operationType == "inbound" && createdBySellerId == null }
+@Serializable data class DraftRequest(
+    val id: String, val status: String, @SerialName("seller_id") val sellerId: String?,
+    @SerialName("seller_name") val sellerName: String? = null,
+    @SerialName("display_number") val displayNumber: String? = null,
+    @SerialName("operation_type") val operationType: String,
+    @SerialName("created_by_seller_id") val createdBySellerId: String? = null,
+    val lines: List<DraftLine> = emptyList(), val boxes: List<DraftContainer> = emptyList(),
