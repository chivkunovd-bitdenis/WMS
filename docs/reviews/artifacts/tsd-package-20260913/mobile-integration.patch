+package ru.wms.tsd.core.api.fbs
+
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import retrofit2.Response
+import retrofit2.http.GET
+
+/** Identity returned by the existing authenticated `/auth/me` endpoint. */
+@Serializable
+data class FbsPendingIdentity(
+    val id: String,
+    @SerialName("tenant_id") val tenantId: String,
+)
+
+/**
+ * A process-safe copy of the one create/add intent. It is keyed outside this
+ * object by server, tenant and user, and is removed only after the server
+ * confirms the same idempotency body.
+ */
+@Serializable
+data class PendingFbsSupplyAdd(
+    val supplyId: String,
+    val body: SupplyOrdersBody,
+)
+
+/** Hand-written so the generated API jar is not regenerated for one read. */
+interface FbsPendingIdentityApi {
+    @GET("auth/me")
+    suspend fun me(): Response<FbsPendingIdentity>
+}
