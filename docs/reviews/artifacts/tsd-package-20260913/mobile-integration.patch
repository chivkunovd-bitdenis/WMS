+package ru.wms.tsd.core.auth
+
+import kotlinx.serialization.Serializable
+import retrofit2.Response
+import retrofit2.http.Body
+import retrofit2.http.GET
+import retrofit2.http.Header
+import retrofit2.http.POST
+
+@Serializable
+data class NameLoginBody(val full_name: String, val password: String)
+
+@Serializable
+data class NameLoginResponse(val access_token: String)
+
+@Serializable
+data class IdentityMeResponse(
+    val id: String,
+    val display_name: String,
+    val job_title: String? = null,
+    val organization_slug: String,
+)
+
+/** Small hand-written extension until the generated API jar is renewed. */
+interface IdentityAuthApi {
+    @POST("auth/login-by-name")
+    suspend fun loginByName(@Body body: NameLoginBody): Response<NameLoginResponse>
+
+    @GET("auth/me")
+    suspend fun me(@Header("Authorization") authorization: String): Response<IdentityMeResponse>
+}
