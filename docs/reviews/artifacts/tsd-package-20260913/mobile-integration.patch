+                    FilledTonalButton(onClick = { vm.createContainer("boxes") }, enabled = editable, modifier = Modifier.weight(1f)) { Text("Создать короб") }
+                    FilledTonalButton(onClick = { vm.createContainer("cargo-places") }, enabled = editable, modifier = Modifier.weight(1f)) { Text("Создать грузоместо") }
+                }
+            }
+        }
+    }
+    editLine?.let { lineId ->
+        val line = request?.lines?.firstOrNull { it.id == lineId }
+        if (line != null) ModalBottomSheet(onDismissRequest = { editLine = null }) {
+            Column(Modifier.fillMaxWidth().imePadding().padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                Text(line.skuCode, style = MaterialTheme.typography.titleLarge)
+                Text(line.productName)
+                QuantityField(state.local.totals[lineId] ?: line.effectiveActualQty.toString(), { vm.editTotal(lineId, it) }, "Всего принято", editable)
+                state.error?.let { Text(it, color = WmsColors.Error) }
+                if (state.local.pending != null) TextButton(onClick = vm::retry, enabled = !state.busy) { Text("Проверить результат") }
+                Button(onClick = { vm.saveTotal(lineId) }, enabled = editable && state.local.totals[lineId] != null, modifier = Modifier.fillMaxWidth().height(WmsDimens.PrimaryButtonHeight)) { Text("Сохранить") }
+                if (request.boxes.isNotEmpty() || request.cargoPlaces.isNotEmpty()) TextButton(onClick = { editLine = null; containersOpen = true }) { Text("Уточнить тару") }
+                TextButton(onClick = { editLine = null }) { Text("К составу приёмки") }
+            }
+        }
+    }
+    containerProduct?.let { productId ->
+        ModalBottomSheet(onDismissRequest = { containerProduct = null }) {
+            Column(Modifier.fillMaxWidth().imePadding().padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                Text(activeContainer?.label.orEmpty(), style = MaterialTheme.typography.titleLarge)
+                Text(request?.lines?.firstOrNull { it.productId == productId }?.productName.orEmpty())
+                QuantityField(containerQty, { containerQty = it }, "В таре", editable)
+                state.error?.let { Text(it, color = WmsColors.Error) }
+                if (state.local.pending != null) TextButton(onClick = vm::retry, enabled = !state.busy) { Text("Проверить результат") }
+                Button(onClick = { vm.saveContainer(productId, containerQty) }, enabled = editable, modifier = Modifier.fillMaxWidth()) { Text("Сохранить") }
+                TextButton(onClick = { containerProduct = null }) { Text("К составу тары") }
+            }
+        }
+    }
+}
+
+@Composable private fun QuantityField(value: String, onChange: (String) -> Unit, label: String, enabled: Boolean = true) {
+    val focusManager = androidx.compose.ui.platform.LocalFocusManager.current
+    OutlinedTextField(value, onChange, enabled = enabled, label = { Text(label) }, modifier = Modifier.fillMaxWidth(), singleLine = true,
+        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number, imeAction = ImeAction.Done),
+        keyboardActions = androidx.compose.foundation.text.KeyboardActions(onDone = { focusManager.clearFocus() }),
+        isError = intakeQuantity(value) == null)
+}
+
+@Composable private fun ChoiceField(label: String, choices: List<DraftChoice>, value: String, enabled: Boolean, onSelect: (String) -> Unit) {
+    var open by remember { mutableStateOf(false) }
+    var query by remember { mutableStateOf("") }
+    Column {
+        OutlinedButton(onClick = { open = true }, enabled = enabled, modifier = Modifier.fillMaxWidth()) { Text("$label: ${choices.firstOrNull { it.id == value }?.label ?: "Выбрать"}") }
+        if (open) AlertDialog(onDismissRequest = { open = false }, title = { Text(label) }, text = {
+            Column {
+                OutlinedTextField(query, { query = it }, label = { Text("Поиск") }, singleLine = true)
+                LazyColumn(Modifier.heightIn(max = 300.dp)) { items(choices.filter { it.label.contains(query, true) }, key = { it.id }) { choice ->
+                    TextButton(onClick = { onSelect(choice.id); open = false }, modifier = Modifier.fillMaxWidth()) { Text(choice.label) }
+                } }
+            }
+        }, confirmButton = { TextButton(onClick = { open = false }) { Text("Закрыть") } })
+    }
+}
diff --git a/android/app/src/main/java/ru/wms/tsd/features/inbound/InboundDraftViewModel.kt b/android/app/src/main/java/ru/wms/tsd/features/inbound/InboundDraftViewModel.kt
