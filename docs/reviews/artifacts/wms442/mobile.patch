+    fun sorting(context: SortingContext): SortingApi {
+        // Смена сотрудника/сервера не должна отправить старое намерение от имени
+        // нового пользователя. Проверка выполняется в момент HTTP, не только UI.
+        val builder = OkHttpClient.Builder().addInterceptor { chain ->
+            val session = authManager.getCurrentSession()
+            if (session == null || session.email.lowercase() != context.user || baseUrl() != context.server) {
+                throw IOException("Сотрудник или сервер изменился. Откройте документ заново.")
+            }
+            val response = chain.proceed(chain.request().newBuilder()
+                .header("Authorization", "Bearer ${session.token}").build())
+            if (response.code == 401 && authManager.getCurrentSession() == session) authManager.notifySessionExpired()
+            response
+        }
+        return ApiClient(baseUrl = context.server, okHttpClientBuilder = builder)
+            .createService(SortingApi::class.java)
+    }
 }
