+import ru.wms.tsd.core.api.generated.models.InboundIntakeLineOut
+
+/**
+ * Подтверждённое размещение товара без короба.
+ *
+ * [operationId] заводится один раз на подтверждение оператора и живёт до ясного
+ * ответа сервера: повтор того же тела после обрыва связи сервер узнаёт и второй
+ * раз товар не двигает. Новый идентификатор на повторе означал бы вторую
+ * проводку — ровно то, чего размещение не прощает.
+ */
+@Serializable
+data class LoosePutawayBody(
+    @SerialName("operation_id") val operationId: String,
+    @SerialName("product_id") val productId: String,
+    @SerialName("storage_location_id") val storageLocationId: String,
+    @SerialName("quantity") val quantity: Int,
+)
+
+/**
+ * Размещение россыпи. Эндпоинта нет в сгенерированном клиенте (jar собран до
+ * него), поэтому интерфейс написан руками — как это уже сделано для FBS.
+ */
+// Только поля рабочего экрана. Обязательный остаток/состав не превращаем в
+// ноль при неполном ответе. Старый generated jar не знает cargo_places.
+@Serializable
+data class SortingRequestOut(
+    val id: String,
+    @SerialName("warehouse_id") val warehouseId: String,
+    val status: String,
+    val lines: List<InboundIntakeLineOut>,
+    @SerialName("sorting_remaining_qty") val sortingRemainingQty: Int,
+    val boxes: List<InboundIntakeBoxOut>,
+    @SerialName("cargo_places") val cargoPlaces: List<SortingCargoPlaceOut>,
+    @SerialName("display_number") val displayNumber: String? = null,
+    @SerialName("document_number") val documentNumber: String? = null,
+    @SerialName("seller_name") val sellerName: String? = null,
+    /** Площадка документа нужна только для честной подписи товарной этикетки. */
+    val marketplace: String? = null,
+)
+
+@Serializable
+data class SortingCargoPlaceOut(
+    val id: String,
+    @SerialName("place_number") val placeNumber: Int,
+    @SerialName("internal_barcode") val internalBarcode: String,
+    val lines: List<InboundIntakeBoxLineOut>,
+)
+
+/** Existing warehouse-map operation for one cargo place, kept separate from loose items. */
+@Serializable
+data class CargoPlacePutawayBody(
+    val kind: String = "cargo_place",
+    val id: String,
+    @SerialName("cell_id") val cellId: String,
+)
+
+@Serializable
+data class SortingObjectPlaceOut(
+    val id: String,
+    @SerialName("moved_qty") val movedQty: Int? = null,
+)
+
+data class SortingContext(val server: String, val user: String)
+
+@Serializable
+data class PrintDestinationOut(
+    @SerialName("connection_id") val connectionId: String,
+    @SerialName("queue_name") val queueName: String,
+    val platform: String,
+    @SerialName("warehouse_id") val warehouseId: String,
+    val paired: Boolean,
+    @SerialName("is_default") val isDefault: Boolean,
+    @SerialName("last_seen_at") val lastSeenAt: String? = null,
+    val online: Boolean,
+)
+
+@Serializable
+data class PrintDestinationResponse(val destination: PrintDestinationOut? = null)
+
+@Serializable
+data class SortingLabelPreview(
+    val barcode: String = "",
+    @SerialName("label_title") val labelTitle: String = "",
+    @SerialName("label_subtitle") val labelSubtitle: String = "",
+    @SerialName("warehouse_id") val warehouseId: String = "",
+    val printable: Boolean = false,
+    @SerialName("error_message") val errorMessage: String? = null,
+)
+
+/** Ровно это тело сохраняется перед POST и используется при восстановлении. */
+@Serializable
+data class SortingPrintJobBody(
+    @SerialName("job_id") val jobId: String,
+    val kind: String,
+    @SerialName("object_id") val objectId: String,
+    val marketplace: String? = null,
+    val copies: Int = 1,
+    @SerialName("connection_id") val connectionId: String,
+)
+
+@Serializable
+data class SortingPrintJobOut(
+    val id: String,
+    val status: String,
+    @SerialName("status_text") val statusText: String,
+    @SerialName("queue_receipt") val queueReceipt: String? = null,
+    @SerialName("error_message") val errorMessage: String? = null,
+    @SerialName("queue_name") val queueName: String? = null,
+    val copies: Int = 1,
+    val barcode: String? = null,
+    @SerialName("label_title") val labelTitle: String? = null,
+    @SerialName("label_subtitle") val labelSubtitle: String? = null,
+)
+
+interface SortingApi {
+    @GET("operations/inbound-intake-requests/{requestId}")
+    suspend fun request(@Path("requestId") requestId: String): Response<SortingRequestOut>
+
+    @POST("operations/inbound-intake-requests/{requestId}/loose-putaway")
+    suspend fun loosePutaway(
+        @Path("requestId") requestId: String,
+        @Body body: LoosePutawayBody,
+    ): Response<SortingRequestOut>
+
+    @POST("warehouses/{warehouseId}/sorting-objects/place")
+    suspend fun putawayCargoPlace(
+        @Path("warehouseId") warehouseId: String,
+        @Body body: CargoPlacePutawayBody,
+    ): Response<SortingObjectPlaceOut>
+
+    @GET("operations/print/warehouses/{warehouseId}/destination")
+    suspend fun printDestination(
+        @Path("warehouseId") warehouseId: String,
+    ): Response<PrintDestinationResponse>
+
+    @GET("operations/print/sorting/{requestId}/label")
+    suspend fun printLabelPreview(
+        @Path("requestId") requestId: String,
+        @retrofit2.http.Query("kind") kind: String,
+        @retrofit2.http.Query("object_id") objectId: String,
+        @retrofit2.http.Query("marketplace") marketplace: String? = null,
+    ): Response<SortingLabelPreview>
+
+    @POST("operations/print/sorting/{requestId}/jobs")
+    suspend fun createSortingPrintJob(
+        @Path("requestId") requestId: String,
+        @Body body: SortingPrintJobBody,
+    ): Response<SortingPrintJobOut>
+
+    @GET("operations/print/jobs/{jobId}")
+    suspend fun sortingPrintJob(@Path("jobId") jobId: String): Response<SortingPrintJobOut>
+}
