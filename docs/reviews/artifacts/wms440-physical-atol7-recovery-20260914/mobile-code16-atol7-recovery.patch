From 38d85f909e4019510d638db9925d1cd93ac026f4 Mon Sep 17 00:00:00 2001
From: Denis Civkunov <denischivkunov@icloud.com>
Date: Mon, 14 Sep 2026 15:05:22 +0300
Subject: [PATCH 2/2] fix(WMS-440): parameterize Android 7 release signing

---
 android/app/build.gradle.kts | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/android/app/build.gradle.kts b/android/app/build.gradle.kts
index 4d06535..c833efe 100644
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -7,6 +7,10 @@ plugins {
     alias(libs.plugins.kotlin.serialization)
 }
 
+val releaseSigningStoreFile = providers.environmentVariable("WMS_TSD_SIGNING_STORE_FILE").orNull
+val releaseSigningStorePassword = providers.environmentVariable("WMS_TSD_SIGNING_STORE_PASSWORD").orNull
+val releaseSigningKeyPassword = providers.environmentVariable("WMS_TSD_SIGNING_KEY_PASSWORD").orNull
+
 android {
     namespace = "ru.wms.tsd"
     compileSdk = 35
@@ -26,6 +30,20 @@ android {
     }
 
     signingConfigs {
+        if (
+            releaseSigningStoreFile != null &&
+            releaseSigningStorePassword != null &&
+            releaseSigningKeyPassword != null
+        ) {
+            create("atol7Release") {
+                storeFile = file(releaseSigningStoreFile)
+                storePassword = releaseSigningStorePassword
+                keyAlias = "wmstsd"
+                keyPassword = releaseSigningKeyPassword
+                enableV1Signing = true
+                enableV2Signing = true
+            }
+        }
         getByName("debug") {
             enableV1Signing = true
             enableV2Signing = true
@@ -35,8 +53,7 @@ android {
     buildTypes {
         release {
             isMinifyEnabled = false
-            // Intentionally unsigned in this isolated Cursor workspace.
-            // Signing material is outside the workspace and must not be read or changed.
+            signingConfig = signingConfigs.findByName("atol7Release")
         }
         debug {
             signingConfig = signingConfigs.getByName("debug")
-- 
