From 36f35523284911cf866809f7f7b51fcebab87736 Mon Sep 17 00:00:00 2001
From: Denis Civkunov <denischivkunov@icloud.com>
Date: Mon, 14 Sep 2026 14:47:48 +0300
Subject: [PATCH 1/2] fix(WMS-440): verify Android 7 dual signing

---
 android/app/build.gradle.kts | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/android/app/build.gradle.kts b/android/app/build.gradle.kts
index f01fb3a..4d06535 100644
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -1,3 +1,5 @@
+import java.io.ByteArrayOutputStream
+
 plugins {
     alias(libs.plugins.android.application)
     alias(libs.plugins.kotlin.android)
@@ -13,8 +15,8 @@ android {
         applicationId = "ru.wms.tsd"
         minSdk = 24
         targetSdk = 35
-        versionCode = 15
-        versionName = "0.1.14-profile-migration-fix"
+        versionCode = 16
+        versionName = "0.1.15-android7-dualsign-verified"
         buildConfigField("String", "APK_UPDATE_MANIFEST_URL", "\"https://github.com/oyster-labs-cy/wms-tsd-updates/releases/download/tsd-preview/update.json\"")
         buildConfigField(
             "String",
@@ -55,6 +57,25 @@ android {
     }
 }
 
+tasks.register("verifyDebugDualSigning") {
+    dependsOn("assembleDebug")
+    doLast {
+        val output = ByteArrayOutputStream()
+        exec {
+            commandLine(
+                android.sdkDirectory.resolve("build-tools/35.0.0/apksigner").absolutePath,
+                "verify", "--verbose", "--min-sdk-version", "18", "--max-sdk-version", "35",
+                layout.buildDirectory.file("outputs/apk/debug/app-debug.apk").get().asFile.absolutePath,
+            )
+            standardOutput = output
+            errorOutput = output
+        }
+        val verification = output.toString()
+        check("Verified using v1 scheme (JAR signing): true" in verification) { verification }
+        check("Verified using v2 scheme (APK Signature Scheme v2): true" in verification) { verification }
+    }
+}
+
 dependencies {
     coreLibraryDesugaring("com.android.tools:desugar_jdk_libs:2.1.4")
     implementation(files("libs/wms-api-generated.jar"))
-- 
