+package ru.wms.tsd.core.api.packaging
+
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import retrofit2.Response
+import retrofit2.http.Body
+import retrofit2.http.POST
+import retrofit2.http.Path
+import ru.wms.tsd.core.api.generated.models.PackagingTaskOut
+
+/**
+ * Обычная (не FBS) упаковка ФБО, написанная руками поверх готового JAR по двум
+ * причинам: сгенерированный PackProgressIn не умеет idempotency_key, а его ответ
+ * до сих пор плоский PackagingTaskOut, хотя сервер отдаёт {"packaging_task": …}.
+ * order_id в этой ветке не шлём: с ключом сервер считает его чужим телом.
+ */
+interface PackagingApi {
+    @POST("operations/packaging-tasks/{taskId}/lines/{lineId}/pack")
+    suspend fun pack(
+        @Path("taskId") taskId: String,
+        @Path("lineId") lineId: String,
+        @Body body: PackAttemptBody,
+    ): Response<PackProgressResult>
+}
+
+@Serializable
+data class PackAttemptBody(
+    val quantity: Int,
+    @SerialName("idempotency_key") val idempotencyKey: String,
+)
+
+@Serializable
+data class PackProgressResult(
+    @SerialName("packaging_task") val packagingTask: PackagingTaskOut,
+)
+
+/**
+ * Одна физическая упаковка, сохранённая на устройстве до отправки. Сервер, документ
+ * и строка лежат в ключе хранения, поэтому здесь только то, что обязано совпасть
+ * при повторе: сам UUID, точное количество и сотрудник, который его набрал.
+ */
+@Serializable
+data class PackAttempt(
+    val key: String,
+    val quantity: Int,
+    val actor: String,
+)
