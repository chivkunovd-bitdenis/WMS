+package ru.wms.tsd.features.outbound
+
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.every
+import io.mockk.mockk
+import java.io.IOException
+import java.util.UUID
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import retrofit2.Response
+import ru.wms.tsd.core.api.ApiProvider
+import ru.wms.tsd.core.api.generated.apis.OperationsApi
+import ru.wms.tsd.core.api.generated.models.MarketplaceUnloadLineOut
+import ru.wms.tsd.core.api.generated.models.MarketplaceUnloadRequestDetailOut
+import ru.wms.tsd.core.api.generated.models.PackagingTaskLineOut
+import ru.wms.tsd.core.api.generated.models.PackagingTaskOut
+import ru.wms.tsd.core.api.packaging.PackAttempt
+import ru.wms.tsd.core.api.packaging.PackAttemptBody
+import ru.wms.tsd.core.api.packaging.PackProgressResult
+import ru.wms.tsd.core.api.packaging.PackagingApi
+import ru.wms.tsd.core.auth.AuthManager
+import ru.wms.tsd.core.auth.AuthSession
+import ru.wms.tsd.core.auth.AuthStore
+
+/**
+ * WMS-444 / D1. Одна физическая упаковка = один UUID, сохранённый до запроса.
+ * Проверяем, что потеря ответа, повтор и переоткрытие экрана не создают вторую
+ * единицу работы, а следующая законная упаковка получает новый ключ.
+ */
+@OptIn(ExperimentalCoroutinesApi::class)
+class OutboundPackAttemptTest {
+
+    private val requestId: UUID = UUID.fromString("3280dc0e-1871-41c9-a6c5-0f8c2a5f59ea")
+    private val taskId = "a6e0c1b7-097f-4a41-8aa4-b96bcad02825"
+    private val lineA = "11111111-2222-3333-4444-555555555555"
+    private val lineB = "99999999-8888-7777-6666-555555555555"
+
+    private lateinit var ops: OperationsApi
+    private lateinit var packing: PackagingApi
+    private lateinit var api: ApiProvider
+    private val attempts = mutableMapOf<String, PackAttempt>()
+
+    @Before
+    fun setUp() {
+        Dispatchers.setMain(UnconfinedTestDispatcher())
+        ops = mockk()
+        packing = mockk()
+        attempts.clear()
+        api = mockk {
+            every { operations() } returns ops
+            every { packaging() } returns packing
+            every { currentActor() } returns "packer@ff.ru"
+            every { pendingPackAttempt(any(), any()) } answers { attempts["${firstArg<String>()}:${secondArg<String>()}"] }
+            every { savePackAttempt(any(), any(), any()) } answers {
+                val at = "${firstArg<String>()}:${secondArg<String>()}"
+                val attempt = thirdArg<PackAttempt?>()
+                if (attempt == null) attempts.remove(at) else attempts[at] = attempt
+                Unit
+            }
+        }
+        stubDocument(task(line(lineA, done = 0, total = 3)))
+    }
+
+    @After
+    fun tearDown() = Dispatchers.resetMain()
+
+    // ---------- фикстуры ----------
+
+    private fun line(id: String, done: Int, total: Int) = PackagingTaskLineOut(
+        id = id,
+        productId = "prod-$id",
+        skuCode = "sku",
+        productName = "Товар",
+        storageLocationId = "loc-1",
+        storageLocationCode = "LOC-1",
+        packagingInstructions = null,
+        requiresHonestSign = false,
+        qtyTotal = total,
+        qtySuggestedPacked = 0,
+        qtyConfirmedPacked = 0,
+        qtyNeedPack = total,
+        qtyPackedInTask = done,
+        qtyDone = done,
+        qtyMarkingPrinted = done,
+        isComplete = done >= total,
+    )
+
+    private fun task(vararg lines: PackagingTaskLineOut) = PackagingTaskOut(
+        id = taskId,
+        warehouseId = "wh-1",
+        status = "in_progress",
+        marketplaceUnloadRequestId = requestId.toString(),
+        inboundIntakeRequestId = null,
+        isComplete = lines.all { it.isComplete },
+        lines = lines.toList(),
+    )
+
+    private fun <T> err(code: Int, detail: String): Response<T> = Response.error(
+        code,
+        """{"detail":"$detail"}""".toResponseBody("application/json".toMediaType()),
+    )
+
+    private fun stubDocument(packagingTask: PackagingTaskOut) {
+        coEvery { ops.getMarketplaceUnloadOperationsMarketplaceUnloadRequestsRequestIdGet(requestId) } returns
+            Response.success(
+                MarketplaceUnloadRequestDetailOut(
+                    id = requestId.toString(),
+                    warehouseId = "wh-1",
+                    warehouseName = "Склад",
+                    status = "collecting",
+                    createdAt = "2026-09-13T00:00:00Z",
+                    lines = listOf(
+                        MarketplaceUnloadLineOut(
+                            id = "unload-line-1",
+                            productId = "prod-1",
+                            skuCode = "sku",
+                            productName = "Товар",
+                            quantity = 3,
+                            pickedQty = 3,
+                        ),
+                    ),
+                    boxes = emptyList(),
+                ),
+            )
+        coEvery { ops.getPackagingTaskForUnloadOperationsPackagingTasksByUnloadUnloadIdGet(requestId) } returns
+            Response.success(packagingTask)
+        coEvery { ops.getPackagingTaskOperationsPackagingTasksTaskIdGet(UUID.fromString(taskId)) } returns
+            Response.success(packagingTask)
+    }
+
+    private fun openedVm(lineId: String = lineA) =
+        OutboundAssemblyViewModel(requestId, api).also { it.openPackLine(lineId) }
+
+    // ---------- сценарии ----------
+
+    @Test
+    fun `потерянный ответ сохраняет ключ, повтор уходит тем же телом и работа не удваивается`() = runTest {
+        val bodies = mutableListOf<PackAttemptBody>()
+        var call = 0
+        coEvery { packing.pack(taskId, lineA, any()) } answers {
+            bodies += thirdArg()
+            if (call++ == 0) throw IOException("ответ потерян")
+            Response.success(PackProgressResult(task(line(lineA, done = 1, total = 3))))
+        }
+
+        val vm = openedVm()
+        vm.submitPack(1)
+
+        // ответа нет — исход неизвестен, ключ обязан пережить попытку
+        assertEquals(1, attempts.size)
+        assertEquals(bodies[0].idempotencyKey, attempts["$taskId:$lineA"]?.key)
+
+        vm.submitPack(1)
+
+        assertEquals(2, bodies.size)
+        assertEquals(bodies[0], bodies[1])
+        assertEquals(1, vm.state.value.packaging?.lines?.first()?.qtyDone)
+        assertTrue(attempts.isEmpty())
+    }
+
+    @Test
+    fun `переоткрытие экрана повторяет ту же попытку, а не создаёт новую`() = runTest {
+        val bodies = mutableListOf<PackAttemptBody>()
+        var call = 0
+        coEvery { packing.pack(taskId, lineA, any()) } answers {
+            bodies += thirdArg()
+            if (call++ == 0) throw IOException("ответ потерян")
+            Response.success(PackProgressResult(task(line(lineA, done = 1, total = 3))))
+        }
+
+        openedVm().submitPack(1)
+        assertEquals(1, attempts.size)
+
+        // новый экран/процесс: ключ читается с диска
+        openedVm().submitPack(1)
+
+        assertEquals(2, bodies.size)
+        assertEquals(bodies[0].idempotencyKey, bodies[1].idempotencyKey)
+        assertEquals(1, bodies[1].quantity)
+        assertTrue(attempts.isEmpty())
+    }
+
+    @Test
+    fun `следующая физическая упаковка получает новый ключ`() = runTest {
+        val bodies = mutableListOf<PackAttemptBody>()
+        var done = 0
+        coEvery { packing.pack(taskId, lineA, any()) } answers {
+            bodies += thirdArg()
+            Response.success(PackProgressResult(task(line(lineA, done = ++done, total = 3))))
+        }
+
+        val vm = openedVm()
+        vm.submitPack(1)
+        vm.submitPack(1)
+
+        assertEquals(2, bodies.size)
+        assertNotEquals(bodies[0].idempotencyKey, bodies[1].idempotencyKey)
+        assertEquals(2, vm.state.value.packaging?.lines?.first()?.qtyDone)
+        assertTrue(attempts.isEmpty())
+    }
