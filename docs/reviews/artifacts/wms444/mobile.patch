+import ru.wms.tsd.core.api.generated.models.MarketplaceUnloadLineOut
+import ru.wms.tsd.core.api.generated.models.MarketplaceUnloadRequestDetailOut
+import ru.wms.tsd.core.api.generated.models.PackagingTaskLineOut
+import ru.wms.tsd.core.api.generated.models.PackagingTaskOut
+import ru.wms.tsd.core.api.packaging.PackAttempt
+import ru.wms.tsd.core.api.packaging.PackAttemptBody
+import ru.wms.tsd.core.api.packaging.PackProgressResult
+import ru.wms.tsd.core.api.packaging.PackagingApi
+import ru.wms.tsd.core.auth.AuthManager
+import ru.wms.tsd.core.auth.AuthSession
+import ru.wms.tsd.core.auth.AuthStore
+
+/**
+ * WMS-444 / D1. Одна физическая упаковка = один UUID, сохранённый до запроса.
+ * Проверяем, что потеря ответа, повтор и переоткрытие экрана не создают вторую
+ * единицу работы, а следующая законная упаковка получает новый ключ.
+ */
+@OptIn(ExperimentalCoroutinesApi::class)
+class OutboundPackAttemptTest {
+
+    private val requestId: UUID = UUID.fromString("3280dc0e-1871-41c9-a6c5-0f8c2a5f59ea")
+    private val taskId = "a6e0c1b7-097f-4a41-8aa4-b96bcad02825"
+    private val lineA = "11111111-2222-3333-4444-555555555555"
+    private val lineB = "99999999-8888-7777-6666-555555555555"
+
+    private lateinit var ops: OperationsApi
+    private lateinit var packing: PackagingApi
+    private lateinit var api: ApiProvider
+    private val attempts = mutableMapOf<String, PackAttempt>()
+
+    @Before
+    fun setUp() {
+        Dispatchers.setMain(UnconfinedTestDispatcher())
+        ops = mockk()
+        packing = mockk()
+        attempts.clear()
+        api = mockk {
+            every { operations() } returns ops
+            every { packaging(any()) } returns packing
+            every { currentActor() } returns "packer@ff.ru"
+            every { packServer() } returns "http://test/"
+            every { pendingPackAttempt(any(), any()) } answers { attempts["${firstArg<String>()}:${secondArg<String>()}"] }
+            every { savePackAttempt(any(), any(), any()) } answers {
+                val at = "${firstArg<String>()}:${secondArg<String>()}"
+                val attempt = thirdArg<PackAttempt?>()
+                if (attempt == null) attempts.remove(at) else attempts[at] = attempt
+                Unit
+            }
+            every { clearPackAttempt(any(), any(), any()) } answers {
+                attempts.remove("${firstArg<String>()}:${secondArg<String>()}")
+                Unit
+            }
+        }
+        stubDocument(task(line(lineA, done = 0, total = 3)))
+    }
+
+    @After
+    fun tearDown() = Dispatchers.resetMain()
+
+    // ---------- фикстуры ----------
+
+    private fun line(id: String, done: Int, total: Int) = PackagingTaskLineOut(
+        id = id,
+        productId = "prod-$id",
+        skuCode = "sku",
+        productName = "Товар",
+        storageLocationId = "loc-1",
+        storageLocationCode = "LOC-1",
+        packagingInstructions = null,
+        requiresHonestSign = false,
+        qtyTotal = total,
+        qtySuggestedPacked = 0,
+        qtyConfirmedPacked = 0,
+        qtyNeedPack = total,
+        qtyPackedInTask = done,
+        qtyDone = done,
+        qtyMarkingPrinted = done,
+        isComplete = done >= total,
+    )
+
+    private fun task(vararg lines: PackagingTaskLineOut) = PackagingTaskOut(
+        id = taskId,
+        warehouseId = "wh-1",
+        status = "in_progress",
+        marketplaceUnloadRequestId = requestId.toString(),
+        inboundIntakeRequestId = null,
+        isComplete = lines.all { it.isComplete },
+        lines = lines.toList(),
+    )
+
+    private fun <T> err(code: Int, detail: String): Response<T> = Response.error(
+        code,
+        """{"detail":"$detail"}""".toResponseBody("application/json".toMediaType()),
+    )
+
+    private fun stubDocument(packagingTask: PackagingTaskOut) {
+        coEvery { ops.getMarketplaceUnloadOperationsMarketplaceUnloadRequestsRequestIdGet(requestId) } returns
+            Response.success(
+                MarketplaceUnloadRequestDetailOut(
+                    id = requestId.toString(),
+                    warehouseId = "wh-1",
+                    warehouseName = "Склад",
+                    status = "collecting",
+                    createdAt = "2026-09-13T00:00:00Z",
+                    lines = listOf(
+                        MarketplaceUnloadLineOut(
+                            id = "unload-line-1",
+                            productId = "prod-1",
+                            skuCode = "sku",
+                            productName = "Товар",
+                            quantity = 3,
+                            pickedQty = 3,
+                        ),
+                    ),
+                    boxes = emptyList(),
+                ),
+            )
+        coEvery { ops.getPackagingTaskForUnloadOperationsPackagingTasksByUnloadUnloadIdGet(requestId) } returns
+            Response.success(packagingTask)
+        coEvery { ops.getPackagingTaskOperationsPackagingTasksTaskIdGet(UUID.fromString(taskId)) } returns
+            Response.success(packagingTask)
+    }
+
+    private fun openedVm(lineId: String = lineA) =
+        OutboundAssemblyViewModel(requestId, api).also { it.openPackLine(lineId) }
+
+    // ---------- сценарии ----------
+
+    @Test
+    fun `потерянный ответ сохраняет ключ, повтор уходит тем же телом и работа не удваивается`() = runTest {
+        val bodies = mutableListOf<PackAttemptBody>()
+        var call = 0
+        coEvery { packing.pack(taskId, lineA, any()) } answers {
+            bodies += thirdArg<PackAttemptBody>()
+            if (call++ == 0) throw IOException("ответ потерян")
+            Response.success(PackProgressResult(task(line(lineA, done = 1, total = 3))))
+        }
+
+        val vm = openedVm()
+        vm.submitPack(1)
+
+        // ответа нет — исход неизвестен, ключ обязан пережить попытку
+        assertEquals(1, attempts.size)
+        assertEquals(bodies[0].idempotencyKey, attempts["$taskId:$lineA"]?.key)
+
+        vm.submitPack(1)
+
+        assertEquals(2, bodies.size)
+        assertEquals(bodies[0], bodies[1])
+        assertEquals(1, vm.state.value.packaging?.lines?.first()?.qtyDone)
+        assertTrue(attempts.isEmpty())
+    }
+
+    @Test
+    fun `переоткрытие экрана повторяет ту же попытку, а не создаёт новую`() = runTest {
+        val bodies = mutableListOf<PackAttemptBody>()
+        var call = 0
+        coEvery { packing.pack(taskId, lineA, any()) } answers {
+            bodies += thirdArg<PackAttemptBody>()
+            if (call++ == 0) throw IOException("ответ потерян")
+            Response.success(PackProgressResult(task(line(lineA, done = 1, total = 3))))
+        }
+
+        openedVm().submitPack(1)
+        assertEquals(1, attempts.size)
+
+        // новый экран/процесс: ключ читается с диска
+        openedVm()
+
+        assertEquals(2, bodies.size)
+        assertEquals(bodies[0].idempotencyKey, bodies[1].idempotencyKey)
+        assertEquals(1, bodies[1].quantity)
+        assertTrue(attempts.isEmpty())
+    }
+
+    @Test
+    fun `следующая физическая упаковка получает новый ключ`() = runTest {
+        val bodies = mutableListOf<PackAttemptBody>()
+        var done = 0
+        coEvery { packing.pack(taskId, lineA, any()) } answers {
+            bodies += thirdArg<PackAttemptBody>()
+            Response.success(PackProgressResult(task(line(lineA, done = ++done, total = 3))))
+        }
+
+        val vm = openedVm()
+        vm.submitPack(1)
+        vm.submitPack(1)
+
+        assertEquals(2, bodies.size)
+        assertNotEquals(bodies[0].idempotencyKey, bodies[1].idempotencyKey)
+        assertEquals(2, vm.state.value.packaging?.lines?.first()?.qtyDone)
+        assertTrue(attempts.isEmpty())
+    }
+
+    @Test
+    fun `отказ сервера снимает ключ и не запирает следующую упаковку`() = runTest {
+        val bodies = mutableListOf<PackAttemptBody>()
+        coEvery { packing.pack(taskId, lineA, capture(bodies)) } returnsMany listOf(
+            err(409, "invalid_qty"),
+            Response.success(PackProgressResult(task(line(lineA, done = 1, total = 3)))),
+        )
+
+        val vm = openedVm()
+        vm.submitPack(9)
+
+        // сервер решил и ничего не записал — ключ отклонённой попытки не живёт дальше
+        assertTrue(attempts.isEmpty())
+
+        vm.submitPack(1)
+
+        assertEquals(2, bodies.size)
+        assertNotEquals(bodies[0].idempotencyKey, bodies[1].idempotencyKey)
+        assertEquals(1, vm.state.value.packaging?.lines?.first()?.qtyDone)
+    }
+
+    @Test
+    fun `ошибка сервера 5xx оставляет исход неизвестным и сохраняет ключ`() = runTest {
+        val bodies = mutableListOf<PackAttemptBody>()
+        coEvery { packing.pack(taskId, lineA, capture(bodies)) } returnsMany listOf(
+            err(502, "bad gateway"),
+            Response.success(PackProgressResult(task(line(lineA, done = 1, total = 3)))),
+        )
+
+        val vm = openedVm()
+        vm.submitPack(1)
+        assertEquals(1, attempts.size)
+
+        vm.submitPack(1)
+
+        assertEquals(bodies[0], bodies[1])
+        assertTrue(attempts.isEmpty())
+    }
+
+    @Test
+    fun `сбой записи на устройстве не даёт отправить упаковку`() = runTest {
+        every { api.savePackAttempt(any(), any(), any()) } throws IllegalStateException("Не удалось сохранить попытку")
+
+        val vm = openedVm()
+        vm.submitPack(1)
+
+        coVerify(exactly = 0) { packing.pack(any(), any(), any()) }
+        assertFalse(vm.state.value.packBusy)
+    }
+
+    @Test
+    fun `ключ строки не переносится на другую строку документа`() = runTest {
+        stubDocument(task(line(lineA, done = 0, total = 3), line(lineB, done = 0, total = 3)))
+        val bodies = mutableListOf<PackAttemptBody>()
+        coEvery { packing.pack(taskId, any(), capture(bodies)) } answers { throw IOException("ответ потерян") }
+
+        val vm = OutboundAssemblyViewModel(requestId, api)
+        vm.openPackLine(lineA)
+        vm.submitPack(1)
+        vm.openPackLine(lineB)
+        vm.submitPack(1)
+
+        assertEquals(2, bodies.size)
+        assertNotEquals(bodies[0].idempotencyKey, bodies[1].idempotencyKey)
+        assertEquals(2, attempts.size)
+        assertNotEquals(attempts["$taskId:$lineA"]?.key, attempts["$taskId:$lineB"]?.key)
+    }
+
+    @Test
+    fun `двойное нажатие при неизвестном ответе шлёт один запрос`() = runTest {
+        val gate = CompletableDeferred<Response<PackProgressResult>>()
+        coEvery { packing.pack(taskId, lineA, any()) } coAnswers { gate.await() }
+
+        val vm = openedVm()
+        vm.submitPack(1)
+        vm.submitPack(1)
+
+        assertTrue(vm.state.value.packBusy)
+        coVerify(exactly = 1) { packing.pack(any(), any(), any()) }
+
+        gate.complete(Response.success(PackProgressResult(task(line(lineA, done = 1, total = 3)))))
+        assertFalse(vm.state.value.packBusy)
+        assertTrue(attempts.isEmpty())
+    }
+
+    @Test
+    fun `тело обычной упаковки несёт только количество и ключ`() {
+        val json = Json.encodeToString(PackAttemptBody(quantity = 2, idempotencyKey = "key-1"))
+        assertEquals("""{"quantity":2,"idempotency_key":"key-1"}""", json)
+    }
+
+    @Test
+    fun `сохранённые попытки разделены по серверу tenant и user`() {
+        val store: AuthStore = mockk()
+        val auth: AuthManager = mockk()
+        val tenant = UUID.randomUUID().toString()
+        val userA = UUID.randomUUID().toString()
+        val userB = UUID.randomUUID().toString()
+        fun token(t: String, u: String): String {
+            val claims = """{"tenant_id":"$t","sub":"$u"}"""
+            return "header." + java.util.Base64.getUrlEncoder().withoutPadding()
+                .encodeToString(claims.toByteArray()) + ".signature"
+        }
+        every { auth.getCurrentSession() } returns AuthSession("same@example.com", "A", token(tenant, userA))
+        every { store.getBaseUrl() } returns "https://api.test/"
+        val provider = ApiProvider(store, auth)
+        val saved = mutableMapOf<String, String>()
+        every { store.getPackAttempt(any(), any(), any(), any()) } answers {
+            saved["${firstArg<String>()}|${secondArg<String>()}|${thirdArg<String>()}|${arg<String>(3)}"]
+        }
+        every { store.savePackAttempt(any(), any(), any(), any(), any()) } answers {
+            val slot = "${firstArg<String>()}|${secondArg<String>()}|${thirdArg<String>()}|${arg<String>(3)}"
+            val value = arg<String?>(4)
+            if (value == null) saved.remove(slot) else saved[slot] = value
+            Unit
+        }
+        val a = PackAttempt(UUID.randomUUID().toString(), 1, provider.currentActor(), provider.packServer())
+        provider.savePackAttempt(taskId, lineA, a)
+        assertEquals(a, provider.pendingPackAttempt(taskId, lineA))
+        every { auth.getCurrentSession() } returns AuthSession("same@example.com", "B", token(tenant, userB))
+        assertNull(provider.pendingPackAttempt(taskId, lineA))
+        val b = PackAttempt(UUID.randomUUID().toString(), 2, provider.currentActor(), provider.packServer())
+        provider.savePackAttempt(taskId, lineA, b)
+        assertEquals(b, provider.pendingPackAttempt(taskId, lineA))
+        provider.clearPackAttempt(taskId, lineA, a)
+        assertEquals(b, provider.pendingPackAttempt(taskId, lineA))
+        every { auth.getCurrentSession() } returns AuthSession("same@example.com", "B", token(UUID.randomUUID().toString(), userB))
+        assertNull(provider.pendingPackAttempt(taskId, lineA))
+        every { store.getBaseUrl() } returns "https://other.test/"
+        assertNull(provider.pendingPackAttempt(taskId, lineA))
+    }
+}
