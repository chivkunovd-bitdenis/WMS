+    private fun precedingBoxScan(marketplace: String, initialBox: String?) = runTest {
+        val a = FbsBox("A", 1, "BOX-A"); val b = FbsBox("B", 2, "BOX-B")
+        val item = order("1", "2026-09-08T09:00:00Z").copy(marketplace = marketplace,
+            positions = listOf(FbsPosition(id = "p1", productId = "product", name = "Item", quantity = 2, pickedQuantity = 0, barcode = "4600000000001")))
+        val initial = workspace(listOf(item)).let { it.copy(supply = it.supply.copy(marketplace = marketplace), boxes = listOf(a, b)) }
+        val assigned = initial.copy(boxes = listOf(a, if (marketplace == "wb") b.copy(assignedOrderIds = listOf("1")) else b.copy(assignedOrderProductIds = listOf("p1"))))
+        val delayed = kotlinx.coroutines.CompletableDeferred<Response<FbsWorkspace>>()
+        var reads = 0
+        var actual = initial
+        coEvery { service.workspace("supply") } coAnswers {
+            if (reads++ == 1) delayed.await() else Response.success(actual)
+        }
+        val recipients = mutableListOf<String>()
+        coEvery { service.assignOrders("supply", capture(recipients), any()) } answers {
+            actual = assigned
+            throw IOException("reply lost after assignment")
+        }
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.selectBox(initialBox)
+        vm.scan("boxes", "BOX-B")
+        assertTrue(vm.state.value.busy) // B's refresh is still pending.
+        vm.scan("boxes", "4600000000001")
+        // A later manual choice must not redirect this already queued product,
+        // and completion of B's refresh must not overwrite that manual choice.
+        vm.selectBox("A")
+        delayed.complete(Response.success(initial))
+        assertEquals(listOf("B"), recipients)
+        assertEquals("A", vm.state.value.selectedBoxId)
+        assertNotNull(vm.state.value.error)
+        vm.retry()
+        assertNull(vm.state.value.error)
+        assertEquals(listOf("B"), recipients) // Existing assignment reconciles, never repeats.
+        assertEquals(assigned, vm.state.value.workspace)
+    }
