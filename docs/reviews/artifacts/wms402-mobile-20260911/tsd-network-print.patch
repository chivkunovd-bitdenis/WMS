+private fun writeLabelsPdf(view: WebView, file: File, continuation: CancellableContinuation<ByteArray>) {
+    val adapter = view.createPrintDocumentAdapter("Этикетки FBS")
+    // Разрешение и цвет задаём сами: адаптер вызывается напрямую, без системного
+    // диалога, и неполные PrintAttributes он не принимает.
+    val attributes = PrintAttributes.Builder()
+        .setMediaSize(LABELS_MEDIA_SIZE)
+        .setResolution(PrintAttributes.Resolution("wms-58-40", "WMS", 300, 300))
+        .setColorMode(PrintAttributes.COLOR_MODE_MONOCHROME)
+        .setMinMargins(PrintAttributes.Margins.NO_MARGINS)
+        .build()
+    adapter.onStart()
+    adapter.onLayout(null, attributes, CancellationSignal(), object : PrintDocumentAdapter.LayoutResultCallback() {
+        override fun onLayoutFailed(error: CharSequence?) {
+            adapter.onFinish()
+            continuation.failIfActive(error, "Не удалось разметить этикетки")
+        }
+
+        override fun onLayoutFinished(info: PrintDocumentInfo?, changed: Boolean) {
+            val descriptor = ParcelFileDescriptor.open(
+                file,
+                ParcelFileDescriptor.MODE_READ_WRITE or ParcelFileDescriptor.MODE_TRUNCATE,
+            )
+            adapter.onWrite(arrayOf(PageRange.ALL_PAGES), descriptor, CancellationSignal(), object : PrintDocumentAdapter.WriteResultCallback() {
+                override fun onWriteFailed(error: CharSequence?) {
+                    closeWrite(adapter, descriptor)
+                    continuation.failIfActive(error, "Не удалось собрать файл этикеток")
+                }
+
+                override fun onWriteCancelled() {
+                    closeWrite(adapter, descriptor)
+                    continuation.failIfActive(null, "Сбор файла этикеток отменён")
+                }
+
+                override fun onWriteFinished(pages: Array<out PageRange>?) {
+                    closeWrite(adapter, descriptor)
+                    if (!continuation.isActive) return
+                    continuation.resumeWith(runCatching {
+                        val bytes = file.readBytes()
+                        require(bytes.isNotEmpty()) { "Файл этикеток пуст. Печать не начата." }
+                        require(bytes.size <= MAX_LABEL_FILE_BYTES) { LABEL_TOO_LARGE }
+                        bytes
+                    })
+                }
+            })
+        }
+    }, Bundle())
+}
+
+private fun closeWrite(adapter: PrintDocumentAdapter, descriptor: ParcelFileDescriptor) {
+    runCatching { descriptor.close() }
+    runCatching { adapter.onFinish() }
+}
+
+private fun CancellableContinuation<ByteArray>.failIfActive(error: CharSequence?, fallback: String) {
+    if (isActive) resumeWith(Result.failure(IllegalStateException(error?.toString()?.ifBlank { null } ?: fallback)))
+}
