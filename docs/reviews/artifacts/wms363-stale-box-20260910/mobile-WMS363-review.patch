+internal const val MAX_LABEL_FILE_BYTES = 16 * 1024 * 1024
+private const val LABEL_TOO_LARGE = "Файл этикеток превышает 16 МиБ. Печать не начата."
+
+/** Never buffer beyond the accepted file size, including chunked/unknown length. */
+internal fun okhttp3.ResponseBody.readLabelBytes(): ByteArray = use { body ->
+    require(body.contentLength() <= MAX_LABEL_FILE_BYTES) { LABEL_TOO_LARGE }
+    val output = java.io.ByteArrayOutputStream()
+    val buffer = ByteArray(8192)
+    body.byteStream().use { stream ->
+        while (true) {
+            // At the boundary read one byte only, to distinguish exact size from
+            // overflow. No bytes beyond the limit are written into the buffer.
+            val count = stream.read(buffer, 0, minOf(buffer.size, MAX_LABEL_FILE_BYTES - output.size() + 1))
+            if (count < 0) break
+            require(count <= MAX_LABEL_FILE_BYTES - output.size()) { LABEL_TOO_LARGE }
+            output.write(buffer, 0, count)
+        }
+    }
+    output.toByteArray()
+}
