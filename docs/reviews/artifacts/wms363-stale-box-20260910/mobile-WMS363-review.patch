+/** Generated stream: tests never allocate the full oversized server response. */
+internal class GeneratedLabelBody(val total: Long, private val declared: Long, private val fail: Boolean = false) : okhttp3.ResponseBody() {
+    var bytesRead = 0L
+    var closed = false
+    private val input = object : okio.Source {
+        private val chunk = ByteArray(8192)
+        override fun read(sink: okio.Buffer, byteCount: Long): Long {
+            if (fail) throw java.io.IOException("broken stream")
+            if (bytesRead == total) return -1
+            val count = minOf(byteCount, total - bytesRead, chunk.size.toLong()).toInt()
+            sink.write(chunk, 0, count); bytesRead += count; return count.toLong()
+        }
+        override fun timeout() = okio.Timeout.NONE
+        override fun close() { closed = true }
+    }.buffer()
+    override fun source(): okio.BufferedSource = input
+    override fun contentLength() = declared
+    override fun contentType() = "application/pdf".toMediaType()
+}
