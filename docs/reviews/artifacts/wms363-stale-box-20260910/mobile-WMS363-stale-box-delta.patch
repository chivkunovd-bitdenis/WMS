+    private fun staleBoxRecovery(recovery: String, failFirstRefresh: Boolean) = runTest {
+        for (marketplace in listOf("wb", "ozon")) for (initialBox in listOf("A", null)) {
+            val a = FbsBox("A", 1, "BOX-A"); val b = FbsBox("B", 2, "BOX-B")
+            val item = order("1", "2026-09-08T09:00:00Z").copy(marketplace = marketplace,
+                positions = listOf(FbsPosition(id = "p1", productId = "product", name = "Item", quantity = 2, pickedQuantity = 0, barcode = "4600000000001")))
+            val initial = workspace(listOf(item)).let { it.copy(supply = it.supply.copy(marketplace = marketplace), boxes = listOf(a)) }
+            val fresh = initial.copy(boxes = listOf(a, b))
+            val assigned = fresh.copy(boxes = listOf(a, if (marketplace == "wb") b.copy(assignedOrderIds = listOf("1")) else b.copy(assignedOrderProductIds = listOf("p1"))))
+            val delayed = kotlinx.coroutines.CompletableDeferred<Response<FbsWorkspace>>()
+            var reads = 0
+            coEvery { service.workspace("supply") } coAnswers {
+                when (reads++) { 0 -> Response.success(initial); 1 -> delayed.await(); else -> Response.success(fresh) }
+            }
+            val recipients = mutableListOf<String>()
+            coEvery { service.assignOrders("supply", capture(recipients), any()) } returns Response.success(assigned)
+            val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.selectBox(initialBox)
+            vm.scan("boxes", "BOX-B"); vm.scan("boxes", "4600000000001")
+            assertTrue(vm.state.value.busy)
+            delayed.complete(if (failFirstRefresh) Response.error(503, "temporarily unavailable".toResponseBody()) else Response.success(fresh))
+            if (failFirstRefresh) {
+                assertNotNull(vm.state.value.error)
+                // The consumer has already dequeued the product and is waiting on error.
+                vm.retry()
+            }
+            val staleMessage = vm.state.value.error
+            assertNotNull(staleMessage)
+            if (recovery.startsWith("rescan")) {
+                vm.scan("boxes", "BOX-B")
+                vm.scan("boxes", "4600000000001")
+            }
+            if (recovery.endsWith("retry")) vm.retry() else vm.dismissError()
+            assertEquals("$marketplace/$initialBox/$recovery", if (recovery.startsWith("rescan")) listOf("B") else emptyList<String>(), recipients)
+            assertNull(vm.state.value.error)
+            assertTrue(staleMessage!!.contains("ожидающих сканов"))
+            assertTrue(staleMessage.contains("1"))
+            // Only fresh scans after the explicit recovery may assign the product.
+            if (!recovery.startsWith("rescan")) {
+                vm.scan("boxes", "BOX-B"); vm.scan("boxes", "4600000000001")
+            }
+            assertEquals(listOf("B"), recipients)
+            assertNull(vm.state.value.error)
+        }
+    }
