+        stage = "boxes", progress = FbsProgress(0, 0, 0, 0, 2), serverNow = "2026-09-09T10:00:00Z",
+    )
+    private fun preflight(version: String = "version-1", canDeliver: Boolean = true) = FbsDeliveryPreflight(canDeliver, version, "2026-09-09T10:00:00Z")
+    private fun failure(code: String, status: Int = 409, retryable: Boolean = true) = Response.error<FbsWorkspace>(status,
+        """{"detail":{"code":"$code","message":"Отказ WB","retryable":$retryable}}""".toResponseBody())
+    @Before fun setup() {
