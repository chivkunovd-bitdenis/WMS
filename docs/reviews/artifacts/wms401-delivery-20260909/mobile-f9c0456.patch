+            every { fbs() } returns service
+            every { pendingFbsDelivery(any()) } answers { saved[firstArg()] }
+            every { saveFbsDelivery(any(), any()) } answers {
+                val id = firstArg<String>(); val body = secondArg<DeliverBody?>()
+                if (body == null) saved.remove(id) else saved[id] = body
+                Unit
+            }
+        }
+        coEvery { service.workspace(any()) } answers { Response.success(workspace(id = firstArg())) }
+        coEvery { service.deliveryPreflight("supply") } returns Response.success(preflight())
+        coEvery { service.deliver("supply", any()) } returns Response.success(workspace("in_delivery"))
+    }
+    @After fun teardown() { Dispatchers.resetMain() }
+
+    @Test fun `confirmation sends preflight version once and exposes confirmed server workspace`() = runTest {
+        val checks = listOf(FbsDeliveryCheck("marking", "Проверьте маркировку", false, "warning"))
+        val cancelled = listOf(FbsCancelledDeliveryOrder("order", 500047, "SKU", "Товар", listOf(FbsCancelledDeliveryBox(1, "BOX"))))
+        coEvery { service.deliveryPreflight("supply") } returns Response.success(preflight().copy(checks = checks, cancelledOrders = cancelled))
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation()
+        assertTrue(vm.state.value.deliveryConfirmationOpen)
+        assertEquals(cancelled, vm.state.value.deliveryPreflight?.cancelledOrders)
+        coVerify(exactly = 0) { service.deliver(any(), any()) }
+        vm.confirmDelivery(); vm.confirmDelivery(); vm.openDeliveryConfirmation()
+        coVerify(exactly = 1) { service.deliver("supply", match { it.confirmedPreflightVersion == "version-1" && it.idempotencyKey.isNotBlank() }) }
+        assertTrue(vm.state.value.workspace!!.deliveryConfirmed())
+        assertNull(vm.state.value.pendingDelivery); assertTrue(saved.isEmpty())
+        assertNull(vm.state.value.error)
+        // Delivery does not call a client-side pick, pack or write-off method.
+        coVerify(exactly = 0) { service.scan(any(), any(), any()); service.pack(any(), any(), any()) }
+    }
+    @Test fun `blocked preflight cannot deliver and cancelling never mutates supply`() = runTest {
+        coEvery { service.deliveryPreflight("supply") } returns Response.success(preflight(canDeliver = false))
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.confirmDelivery()
+        assertTrue(vm.state.value.deliveryConfirmationOpen)
+        vm.cancelDelivery()
+        assertFalse(vm.state.value.deliveryConfirmationOpen)
+        assertEquals("boxes", vm.state.value.workspace?.stage)
+        assertEquals(0, vm.state.value.workspace?.progress?.packed)
+        coVerify(exactly = 0) { service.deliver(any(), any()) }
+    }
+    @Test fun `failed preflight retains web option to confirm without a version`() = runTest {
+        coEvery { service.deliveryPreflight("supply") } throws IOException("offline")
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation()
+        assertNotNull(vm.state.value.error); assertTrue(vm.state.value.deliveryConfirmationOpen)
+        vm.confirmDelivery()
+        coVerify(exactly = 1) { service.deliver("supply", match { it.confirmedPreflightVersion == null }) }
+        assertTrue(vm.state.value.workspace!!.deliveryConfirmed())
+    }
+    @Test fun `unknown response keeps exact request across reopening and never refreshes its version`() = runTest {
+        val bodies = mutableListOf<DeliverBody>()
+        coEvery { service.deliver("supply", capture(bodies)) } returnsMany listOf(failure("wb_timeout", 504), Response.success(workspace("in_delivery")))
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.confirmDelivery()
+        assertFalse(vm.state.value.workspace!!.deliveryConfirmed())
+        assertTrue(vm.state.value.error!!.contains("неизвестен"))
+        assertEquals(bodies.single(), saved["supply"])
+        vm.dismissError()
+        val reopened = FbsViewModel(provider); reopened.loadSupply("supply"); reopened.openDeliveryConfirmation()
+        assertEquals(2, bodies.size); assertEquals(bodies[0], bodies[1])
+        assertTrue(reopened.state.value.workspace!!.deliveryConfirmed()); assertTrue(saved.isEmpty())
+        coVerify(exactly = 1) { service.deliveryPreflight("supply") }
+    }
+    @Test fun `connection loss preserves identity for explicit retry`() = runTest {
+        val bodies = mutableListOf<DeliverBody>(); var count = 0
+        coEvery { service.deliver("supply", capture(bodies)) } answers {
+            assertEquals(secondArg<DeliverBody>(), saved["supply"])
+            if (count++ == 0) throw IOException("response lost")
+            Response.success(workspace("in_delivery"))
+        }
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.confirmDelivery()
+        assertNotNull(vm.state.value.pendingDelivery); vm.retry()
+        assertEquals(bodies[0], bodies[1]); assertTrue(saved.isEmpty())
+    }
+    @Test fun `definitive WB refusal requires new confirmation and a new key even when retryable`() = runTest {
+        val bodies = mutableListOf<DeliverBody>()
+        coEvery { service.deliver("supply", capture(bodies)) } returnsMany listOf(failure("meta_validation_fail"), Response.success(workspace("in_delivery")))
+        coEvery { service.deliveryPreflight("supply") } returnsMany listOf(Response.success(preflight()), Response.success(preflight("version-2")))
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.confirmDelivery()
+        assertTrue(saved.isEmpty()); assertNull(vm.state.value.pendingDelivery)
+        vm.retry()
+        assertEquals(1, bodies.size); assertTrue(vm.state.value.deliveryConfirmationOpen)
+        vm.confirmDelivery()
+        assertNotEquals(bodies[0].idempotencyKey, bodies[1].idempotencyKey)
+        assertEquals("version-2", bodies[1].confirmedPreflightVersion)
+    }
+    @Test fun `disk write failure prevents delivery request`() = runTest {
+        every { provider.saveFbsDelivery(any(), any()) } throws IllegalStateException("disk unavailable")
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.confirmDelivery()
+        assertEquals("disk unavailable", vm.state.value.error)
+        coVerify(exactly = 0) { service.deliver(any(), any()) }
+    }
+    @Test fun `double tap while response pending sends only one request`() = runTest {
+        val response = CompletableDeferred<Response<FbsWorkspace>>()
+        coEvery { service.deliver("supply", any()) } coAnswers { response.await() }
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.confirmDelivery(); vm.confirmDelivery(); vm.openDeliveryConfirmation()
+        assertTrue(vm.state.value.busy)
+        coVerify(exactly = 1) { service.deliver(any(), any()) }
+        response.complete(Response.success(workspace("in_delivery")))
+        assertFalse(vm.state.value.busy)
+    }
+    @Test fun `unconfirmed successful HTTP response cannot become delivered`() = runTest {
+        coEvery { service.deliver("supply", any()) } returns Response.success(workspace())
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.confirmDelivery()
+        assertFalse(vm.state.value.workspace!!.deliveryConfirmed())
+        assertNotNull(vm.state.value.error); assertNotNull(vm.state.value.pendingDelivery)
+    }
+    @Test fun `confirmed workspace on reopen clears pending request and refresh uses tracking only`() = runTest {
+        saved["supply"] = DeliverBody("pending-key", "old-version")
+        coEvery { service.workspace("supply") } returns Response.success(workspace("in_delivery"))
+        coEvery { service.syncTracking("supply") } returns Response.success(workspace("done"))
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.syncDelivery()
+        assertTrue(saved.isEmpty()); assertEquals("done", vm.state.value.workspace?.supply?.status)
+        coVerify(exactly = 0) { service.deliver(any(), any()); service.deliveryPreflight(any()) }
+        coVerify(exactly = 1) { service.syncTracking("supply") }
+    }
+    @Test fun `pending request never migrates to a different supply`() = runTest {
+        saved["supply"] = DeliverBody("old-key", "old-version")
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.loadSupply("other")
+        assertNull(vm.state.value.pendingDelivery); assertFalse(vm.state.value.deliveryConfirmationOpen)
+        vm.retry()
+        assertEquals("old-key", saved["supply"]?.idempotencyKey)
+        coVerify(exactly = 0) { service.deliver(any(), any()) }
+    }
+    @Test fun `late delivery error stays attached to old supply after navigation`() = runTest {
+        val response = CompletableDeferred<Response<FbsWorkspace>>()
+        coEvery { service.deliver("supply", any()) } coAnswers { response.await() }
+        val vm = FbsViewModel(provider); vm.loadSupply("supply"); vm.openDeliveryConfirmation(); vm.confirmDelivery()
+        vm.loadSupply("other")
+        response.complete(failure("wb_timeout", 504))
+        assertEquals("other", vm.state.value.workspace?.supply?.id)
+        assertNull(vm.state.value.error); assertNull(vm.state.value.pendingDelivery)
+        assertNotNull(saved["supply"]); assertNull(saved["other"])
+        vm.retry()
+        coVerify(exactly = 1) { service.deliver("supply", any()) }
+        coVerify(exactly = 0) { service.deliver("other", any()) }
+    }
+    @Test fun `pending and unstructured errors preserve the request but definitive refusal does not`() {
+        for (code in listOf("wb_timeout", "wb_pending_confirmation", "operation_in_progress")) {
+            val error = runCatching { failure(code, 503).deliveryBody() }.exceptionOrNull() as FbsDeliveryError
+            assertTrue(error.keepRequest)
+        }
+        val proxy = runCatching { Response.error<Unit>(502, "Bad gateway".toResponseBody()).deliveryBody() }.exceptionOrNull() as FbsDeliveryError
+        assertTrue(proxy.keepRequest)
+        val refusal = runCatching { failure("meta_validation_fail").deliveryBody() }.exceptionOrNull() as FbsDeliveryError
+        assertFalse(refusal.keepRequest)
+    }
