+package ru.wms.tsd.core.api.fbs
+
+import kotlinx.serialization.json.*
+import retrofit2.Response
+
+/** Retain the complete request when the server cannot establish WB's result. */
+class FbsDeliveryError(message: String, val keepRequest: Boolean) : Exception(message)
+
+fun <T> Response<T>.deliveryBody(): T {
+    if (isSuccessful) return body() ?: throw FbsDeliveryError("Сервер не вернул результат передачи. Проверьте результат ещё раз.", true)
+    val detail = runCatching {
+        Json.parseToJsonElement(errorBody()?.string().orEmpty()).jsonObject["detail"] as? JsonObject
+    }.getOrNull()
+    val code = (detail?.get("code") as? JsonPrimitive)?.contentOrNull
+    val suppliedMessage = (detail?.get("message") as? JsonPrimitive)?.contentOrNull
+    val pending = code in setOf("wb_timeout", "wb_pending_confirmation", "operation_in_progress")
+    val message = when {
+        code() == 401 -> "Сессия истекла. Войдите заново и проверьте результат передачи."
+        pending -> "WB ещё не подтвердил передачу. Результат пока неизвестен. Повторите проверку через минуту."
+        code == "stale_preflight" -> "Данные поставки изменились. Проверьте поставку и подтвердите передачу ещё раз."
+        !suppliedMessage.isNullOrBlank() -> suppliedMessage
+        else -> "Не удалось получить результат передачи (HTTP ${code()}). Повторите проверку."
+    }
+    // A proxy error or expired session says nothing about an earlier request's outcome.
+    throw FbsDeliveryError(message, pending || code == null || code() in setOf(401, 403))
+}
+
+fun FbsWorkspace.deliveryConfirmed(): Boolean = supply.status in setOf("in_delivery", "done")
