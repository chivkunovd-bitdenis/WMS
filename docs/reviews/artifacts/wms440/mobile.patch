+/** FF draft reuses the intake scaffold and the existing bottom-sheet quantity editor. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun InboundDraftScreen(requestId: String?, onBack: () -> Unit, onCreated: (String) -> Unit = {}) {
+    val vm: InboundDraftViewModel = viewModel(factory = InboundDraftViewModel.Factory(requestId, AppGraph.apiProvider))
+    val state by vm.state.collectAsState()
+    var catalogOpen by remember { mutableStateOf(false) }
+    var containersOpen by remember { mutableStateOf(false) }
+    var editLine by remember { mutableStateOf<String?>(null) }
+    var containerProduct by remember { mutableStateOf<String?>(null) }
+    var containerQty by remember { mutableStateOf("") }
+    var query by remember { mutableStateOf("") }
+    var selectedProduct by remember { mutableStateOf<String?>(null) }
+    var addQty by remember { mutableStateOf("1") }
+    val request = state.request
+    val activeContainer = (request?.boxes.orEmpty() + request?.cargoPlaces.orEmpty()).firstOrNull { it.id == state.containerId }
+    val editable = request?.editable == true && !state.busy && state.local.pending == null
+    val acceptsScans by rememberUpdatedState(!catalogOpen && !containersOpen && editLine == null && containerProduct == null)
+    LaunchedEffect(Unit) { AppGraph.scannerManager.scans.collect { if (acceptsScans) vm.onScan(it.barcode) } }
+    LaunchedEffect(state.flash) { if (state.flash is ru.wms.tsd.ui.patterns.ScanFlash.Success) catalogOpen = false }
+    LifecycleResumeEffect(requestId) {
+        if (!state.busy) vm.load()
+        onPauseOrDispose { }
+    }
+    LaunchedEffect(state.createdId) { state.createdId?.let { onCreated(it); vm.acknowledgeCreated() } }
+    LaunchedEffect(request?.status) { if (request != null && !request.editable) onBack() }
+
+    ScanScaffold(
+        title = if (requestId == null) "Создать приёмку" else "Приёмка ${request?.displayNumber.orEmpty()}",
+        subtitle = request?.sellerName, flash = state.flash, onExit = onBack,
+        modifier = Modifier.imePadding(), cameraScanner = requestId != null,
+        primaryActionLabel = when { state.loading -> null; requestId == null -> "Создать приёмку"; activeContainer != null -> "К составу приёмки"; else -> "Завершить приёмку" },
+        primaryActionEnabled = !state.busy && state.local.pending == null,
+        onPrimaryAction = { if (requestId == null) vm.create() else if (activeContainer != null) vm.selectContainer(null, null) else vm.complete() },
+    ) {
+        Column(Modifier.fillMaxSize().padding(horizontal = 16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            if (state.loading || state.busy) LinearProgressIndicator(Modifier.fillMaxWidth())
+            state.error?.let { Text(it, color = WmsColors.Error) }
+            if (state.local.pending != null) {
+                Text("Предыдущий запрос требует проверки.")
+                TextButton(onClick = vm::retry, enabled = !state.busy) { Text("Проверить результат") }
+            } else if (state.error != null && request == null && requestId != null) {
+                TextButton(onClick = vm::load) { Text("Повторить загрузку") }
+            }
+            if (requestId == null) {
+                if (!state.loading && state.warehouses.isEmpty()) Text("Нет доступных складов. Обновите список после настройки склада.")
+                if (!state.loading && state.sellers.isEmpty()) Text("Нет доступных селлеров.")
+                if (state.error != null || state.warehouses.isEmpty() || state.sellers.isEmpty()) TextButton(onClick = vm::load, enabled = !state.busy) { Text("Обновить список") }
+                ChoiceField("Склад", state.warehouses, state.local.warehouseId, enabled = !state.busy && state.local.pending == null) { vm.setSelection(warehouse = it) }
+                ChoiceField("Селлер", state.sellers, state.local.sellerId, enabled = !state.busy && state.local.pending == null) { vm.setSelection(seller = it) }
+            } else if (request != null) {
+                if (activeContainer == null) {
+                    Text("Принято: ${request.lines.sumOf { it.acceptedQty }}", style = MaterialTheme.typography.titleMedium)
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        FilledTonalButton(onClick = { catalogOpen = true; vm.searchCatalog("") }, enabled = editable, modifier = Modifier.weight(1f)) { Text("Добавить товар") }
+                        OutlinedButton(onClick = { containersOpen = true }, modifier = Modifier.weight(1f)) { Text("Короба и грузоместа") }
+                    }
+                    LazyColumn(Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(8.dp), contentPadding = PaddingValues(vertical = 8.dp)) {
+                        items(request.lines, key = { it.id }) { line ->
+                            Surface(shape = MaterialTheme.shapes.medium, color = WmsColors.Surface, shadowElevation = 1.dp,
+                                modifier = Modifier.fillMaxWidth().clickable(enabled = editable) { editLine = line.id }) {
+                                Row(Modifier.padding(12.dp)) {
+                                    Column(Modifier.weight(1f)) {
+                                        Text(line.skuCode, style = MaterialTheme.typography.titleMedium)
+                                        Text(line.productName)
+                                        Text("Принято: ${line.acceptedQty}", color = WmsColors.Primary)
+                                        state.local.totals[line.id]?.let { Text("Введено: $it", color = WmsColors.Primary) }
+                                    }
+                                    IconButton(onClick = { vm.deleteLine(line.id) }, enabled = editable) { Icon(Icons.Default.DeleteOutline, "Удалить товар ${line.skuCode}") }
+                                }
+                            }
+                        }
+                    }
+                } else {
+                    Text(activeContainer.label, style = MaterialTheme.typography.titleMedium)
+                    Text(activeContainer.barcode, color = WmsColors.TextSecondary)
+                    Text("В таре: ${activeContainer.lines.sumOf { it.quantity }}")
+                    LazyColumn(Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                        items(request.lines, key = { it.id }) { line ->
+                            val qty = activeContainer.lines.firstOrNull { it.productId == line.productId }?.quantity ?: 0
+                            Surface(shape = MaterialTheme.shapes.medium, color = WmsColors.Surface, shadowElevation = 1.dp,
+                                modifier = Modifier.fillMaxWidth().clickable(enabled = editable) { containerProduct = line.productId; containerQty = qty.toString() }) {
+                                Column(Modifier.padding(12.dp)) { Text(line.skuCode, style = MaterialTheme.typography.titleMedium); Text(line.productName); Text("В таре: $qty · Всего принято: ${line.acceptedQty}") }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    if (catalogOpen) {
+        ModalBottomSheet(onDismissRequest = { catalogOpen = false }) {
+            Column(Modifier.fillMaxWidth().imePadding().padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Text("Добавить товар", style = MaterialTheme.typography.titleLarge)
+                OutlinedTextField(query, { query = it; vm.searchCatalog(it) }, label = { Text("Название, артикул или штрихкод") }, modifier = Modifier.fillMaxWidth(), singleLine = true)
+                LazyColumn(Modifier.heightIn(max = 280.dp)) {
+                    items(state.catalog, key = { it.id }) { product ->
+                        ListItem(headlineContent = { Text(product.skuCode) }, supportingContent = { Text(listOf(product.name, product.caption).filter { it.isNotEmpty() }.joinToString(" · ")) },
+                            leadingContent = { RadioButton(selectedProduct == product.id, onClick = { selectedProduct = product.id }) },
+                            modifier = Modifier.clickable { selectedProduct = product.id })
+                    }
+                }
+                QuantityField(addQty, { addQty = it }, "Количество")
+                state.error?.let { Text(it, color = WmsColors.Error) }
+                Button(onClick = { selectedProduct?.let { vm.addProduct(it, addQty) } }, enabled = editable && selectedProduct != null && (intakeQuantity(addQty) ?: 0) > 0, modifier = Modifier.fillMaxWidth()) { Text("Добавить") }
+                TextButton(onClick = { catalogOpen = false }) { Text("К составу приёмки") }
+            }
+        }
+    }
+    if (containersOpen) {
+        ModalBottomSheet(onDismissRequest = { containersOpen = false }) {
+            Column(Modifier.fillMaxWidth().padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
