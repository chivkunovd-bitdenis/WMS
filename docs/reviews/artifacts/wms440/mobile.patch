+    @Test fun unresolvedRequestPreventsAnotherMutation() = runTest {
+        disk["$scope:request"] = Json.encodeToString(IntakeLocal(pending = IntakeAttempt("POST", "$prefix/lines", buildJsonObject { put("mutation_id", "pending") })))
+        val vm = InboundDraftViewModel("request", provider)
+        vm.addProduct("product", "1"); advanceUntilIdle()
+        coVerify(exactly = 0) { service.post(any(), any()) }
+        assertEquals("pending", vm.state.value.local.pending!!.body["mutation_id"]!!.jsonPrimitive.content)
+    }
+    @Test fun completedResponseUsesActualQtyWhenEffectiveQtyIsNull() {
+        val response = Json { ignoreUnknownKeys = true }.decodeFromString<DraftRequest>(
+            """{"id":"request","status":"sorting","seller_id":"seller","operation_type":"inbound","lines":[{"id":"line","product_id":"product","sku_code":"SKU","product_name":"Товар","actual_qty":3,"effective_actual_qty":null,"defective_qty":0,"posted_qty":3}]}"""
+        )
+        assertEquals(3, response.lines.single().acceptedQty)
+    }
+}
