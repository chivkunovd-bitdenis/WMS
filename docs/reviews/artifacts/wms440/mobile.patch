+package ru.wms.tsd.features.inbound
+
+import io.mockk.*
+import java.io.IOException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.*
+import kotlinx.serialization.decodeFromString
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.*
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.*
+import org.junit.Assert.*
+import retrofit2.Response
+import ru.wms.tsd.core.api.ApiProvider
+import ru.wms.tsd.core.api.inbound.*
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class InboundDraftViewModelTest {
+    private val service = mockk<InboundDraftApi>()
+    private val provider = mockk<ApiProvider>()
+    private val disk = mutableMapOf<String, String?>()
+    private var scope = "http://test:tenant:operator"
+    private val prefix = "operations/inbound-intake-requests/request"
+    private val line = DraftLine("line", "product", "SKU", "Товар", 4)
+    private var request = DraftRequest("request", "draft", "seller", operationType = "inbound", lines = listOf(line))
+    @Before fun setUp() {
+        Dispatchers.setMain(UnconfinedTestDispatcher())
+        every { provider.inboundDraft() } returns service
+        every { provider.inboundScope() } answers { scope }
+        every { provider.pendingInbound(any(), any()) } answers { disk["${firstArg<String>()}:${secondArg<String>()}"] }
+        every { provider.saveInbound(any(), any(), any()) } answers { disk["${firstArg<String>()}:${secondArg<String>()}"] = thirdArg() }
+        coEvery { service.get("request") } answers { Response.success(request) }
+        coEvery { service.sellers() } returns Response.success(listOf(DraftChoice("seller", "Селлер")))
+        coEvery { service.warehouses() } returns Response.success(listOf(DraftChoice("warehouse", "Склад")))
+    }
+    @After fun tearDown() { Dispatchers.resetMain() }
+    @Test fun lostResponseSurvivesRestartAndUsesExactAttempt() = runTest {
+        val bodies = mutableListOf<JsonObject>()
+        coEvery { service.post("$prefix/lines", capture(bodies)) } coAnswers {
+            assertNotNull(disk["$scope:request"])
+            if (bodies.size == 1) throw IOException("lost response")
+            Response.success(buildJsonObject {})
+        }
+        val first = InboundDraftViewModel("request", provider)
+        first.addProduct("product", "3")
+        advanceUntilIdle()
+        assertNotNull(first.state.value.local.pending)
+        val restored = InboundDraftViewModel("request", provider)
+        restored.retry()
+        advanceUntilIdle()
+        assertEquals(2, bodies.size)
+        assertEquals(bodies[0], bodies[1])
+        assertNotNull(bodies[0]["mutation_id"])
+        assertNull(restored.state.value.local.pending)
+    }
+    @Test fun correctionRetainsTwoWhileOperatorEditsChosenTare() = runTest {
+        request = request.copy(boxes = listOf(DraftContainer("box", boxNumber = 1, lines = listOf(DraftContainerLine("product", 4)))))
+        var corrections = 0
+        coEvery { service.patch("$prefix/lines/line/expected", any()) } answers {
+            corrections++
+            if (corrections == 1) Response.error(409, "{\"detail\":\"actual_below_container_total\"}".toResponseBody())
+            else { request = request.copy(lines = listOf(line.copy(effectiveActualQty = 2))); Response.success(buildJsonObject {}) }
+        }
+        coEvery { service.put("$prefix/boxes/box/lines/product", any()) } answers {
+            request = request.copy(boxes = listOf(DraftContainer("box", boxNumber = 1, lines = listOf(DraftContainerLine("product", 2)))))
+            Response.success(buildJsonObject {})
+        }
+        val vm = InboundDraftViewModel("request", provider)
+        vm.editTotal("line", "2"); vm.saveTotal("line"); advanceUntilIdle()
+        assertEquals("2", vm.state.value.local.totals["line"])
+        assertNull(vm.state.value.local.pending)
+        val restored = InboundDraftViewModel("request", provider)
+        restored.selectContainer("boxes", "box"); restored.saveContainer("product", "2"); advanceUntilIdle()
+        assertEquals(4, restored.state.value.request!!.lines.single().effectiveActualQty)
+        assertEquals("2", restored.state.value.local.totals["line"])
+        restored.selectContainer(null, null); restored.saveTotal("line"); advanceUntilIdle()
+        assertEquals(2, restored.state.value.request!!.lines.single().effectiveActualQty)
+        assertTrue(restored.state.value.local.totals.isEmpty())
+    }
+    @Test fun independentScansReceiveDifferentMutationIds() = runTest {
+        coEvery { service.catalog("seller", "OZON-SKU") } returns Response.success(listOf(DraftProduct("product", "Ozon товар", "SKU", marketplaces = listOf("ozon"), ozonSku = "OZON-SKU")))
+        val bodies = mutableListOf<JsonObject>()
+        coEvery { service.post("$prefix/lines", capture(bodies)) } returns Response.success(buildJsonObject {})
+        val vm = InboundDraftViewModel("request", provider)
+        vm.onScan("OZON-SKU"); vm.onScan("OZON-SKU"); advanceUntilIdle()
+        assertEquals(2, bodies.size)
+        assertNotEquals(bodies[0]["mutation_id"], bodies[1]["mutation_id"])
+        assertEquals(JsonPrimitive(true), bodies[0]["increment"])
+    }
+    @Test fun ozonExternalBarcodeIsResolvedFromTheDraftCatalog() = runTest {
+        coEvery { service.catalog("seller", "OZN-EXTERNAL") } returns Response.success(listOf(
+            DraftProduct("product", "Ozon товар", "SKU", marketplaces = listOf("ozon"), marketplaceBindings = listOf(DraftMarketplaceBinding("ozon", listOf("OZN-EXTERNAL"))))
+        ))
+        val bodies = mutableListOf<JsonObject>()
