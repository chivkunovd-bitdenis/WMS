+            Column(Modifier.fillMaxWidth().imePadding().padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                Text(activeContainer?.label.orEmpty(), style = MaterialTheme.typography.titleLarge)
+                Text(request?.lines?.firstOrNull { it.productId == productId }?.productName.orEmpty())
+                QuantityField(containerQty, { containerQty = it }, "В таре", editable)
+                state.error?.let { Text(it, color = WmsColors.Error) }
+                if (state.local.pending != null) TextButton(onClick = vm::retry, enabled = !state.busy) { Text("Проверить результат") }
+                Button(onClick = { vm.saveContainer(productId, containerQty) }, enabled = editable, modifier = Modifier.fillMaxWidth()) { Text("Сохранить") }
+                TextButton(onClick = { containerProduct = null }) { Text("К составу тары") }
+            }
