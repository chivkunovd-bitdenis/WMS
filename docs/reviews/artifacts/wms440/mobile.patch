+package ru.wms.tsd.core.api.inbound
+
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import retrofit2.Response
+import retrofit2.http.*
+
+/** Additive intake API: the bundled client predates creator identity and cargo places. */
+interface InboundDraftApi {
+    @GET("operations/inbound-intake-requests") suspend fun list(): Response<List<DraftSummary>>
+    @GET("operations/inbound-intake-requests/{id}") suspend fun get(@Path("id") id: String): Response<DraftRequest>
+    @GET("sellers") suspend fun sellers(): Response<List<DraftChoice>>
+    @GET("warehouses") suspend fun warehouses(): Response<List<DraftChoice>>
+    @GET("products/linked-wb-catalog") suspend fun catalog(@Query("seller_id") sellerId: String?, @Query("search") search: String = ""): Response<List<DraftProduct>>
+    @POST suspend fun post(@Url path: String, @Body body: JsonObject): Response<JsonElement>
+    @PATCH suspend fun patch(@Url path: String, @Body body: JsonObject): Response<JsonElement>
+    @PUT suspend fun put(@Url path: String, @Body body: JsonObject): Response<JsonElement>
+    @DELETE suspend fun delete(@Url path: String): Response<JsonElement>
+}
+
+@Serializable data class DraftChoice(val id: String, val name: String = "", @SerialName("company_name") val companyName: String? = null) {
+    val label get() = companyName?.takeIf { it.isNotBlank() } ?: name
+}
+@Serializable data class DraftSummary(
+    val id: String, @SerialName("warehouse_id") val warehouseId: String, val status: String,
+    @SerialName("line_count") val lineCount: Int = 0, @SerialName("created_at") val createdAt: String = "",
+    @SerialName("operation_type") val operationType: String = "",
+    @SerialName("created_by_seller_id") val createdBySellerId: String? = null,
+    @SerialName("display_number") val displayNumber: String? = null,
+    @SerialName("document_number") val documentNumber: String? = null,
+    @SerialName("seller_name") val sellerName: String? = null,
+    @SerialName("planned_delivery_date") val plannedDeliveryDate: String? = null,
+    @SerialName("planned_box_count") val plannedBoxCount: Int? = null,
+    @SerialName("actual_box_count") val actualBoxCount: Int? = null,
+    @SerialName("has_discrepancy") val hasDiscrepancy: Boolean? = null,
+    @SerialName("boxes_discrepancy") val boxesDiscrepancy: Boolean? = null,
+) { val isFfDraft get() = status == "draft" && operationType == "inbound" && createdBySellerId == null }
+@Serializable data class DraftRequest(
+    val id: String, val status: String, @SerialName("seller_id") val sellerId: String?,
+    @SerialName("seller_name") val sellerName: String? = null,
+    @SerialName("display_number") val displayNumber: String? = null,
+    @SerialName("operation_type") val operationType: String,
+    @SerialName("created_by_seller_id") val createdBySellerId: String? = null,
+    val lines: List<DraftLine> = emptyList(), val boxes: List<DraftContainer> = emptyList(),
+    @SerialName("cargo_places") val cargoPlaces: List<DraftContainer> = emptyList(),
+) { val editable get() = status == "draft" && operationType == "inbound" && createdBySellerId == null }
+@Serializable data class DraftLine(
+    val id: String, @SerialName("product_id") val productId: String,
+    @SerialName("sku_code") val skuCode: String, @SerialName("product_name") val productName: String,
+    @SerialName("effective_actual_qty") val effectiveActualQty: Int? = null,
+    @SerialName("actual_qty") val actualQty: Int? = null,
+) {
+    /** After completion the server reports the persisted total as actual_qty. */
+    val acceptedQty get() = effectiveActualQty ?: actualQty ?: 0
+}
+@Serializable data class DraftContainer(
+    val id: String, @SerialName("box_number") val boxNumber: Int? = null,
+    @SerialName("place_number") val placeNumber: Int? = null,
+    @SerialName("internal_barcode") val barcode: String = "", val lines: List<DraftContainerLine> = emptyList(),
+) { val label get() = if (boxNumber != null) "Короб №$boxNumber" else "Грузоместо №$placeNumber" }
+@Serializable data class DraftContainerLine(@SerialName("product_id") val productId: String, val quantity: Int)
+@Serializable data class DraftMarketplaceBinding(
+    val marketplace: String,
+    @SerialName("external_barcodes") val externalBarcodes: List<String> = emptyList(),
+)
+@Serializable data class DraftProduct(
+    val id: String, val name: String, @SerialName("sku_code") val skuCode: String,
+    @SerialName("wb_barcodes") val wbBarcodes: List<String> = emptyList(),
+    @SerialName("wb_primary_barcode") val wbPrimaryBarcode: String? = null,
+    @SerialName("marketplaces") val marketplaces: List<String> = emptyList(),
+    @SerialName("marketplace_bindings") val marketplaceBindings: List<DraftMarketplaceBinding> = emptyList(),
+    @SerialName("ozon_sku") val ozonSku: String? = null,
+    @SerialName("ozon_offer_id") val ozonOfferId: String? = null,
+) {
+    val caption get() = (marketplaces.map { it.uppercase() } + listOfNotNull(ozonOfferId)).joinToString(" · ")
+    val barcodes get() = wbBarcodes + listOfNotNull(wbPrimaryBarcode, skuCode, ozonSku, ozonOfferId) + marketplaceBindings.flatMap { it.externalBarcodes }
+}
