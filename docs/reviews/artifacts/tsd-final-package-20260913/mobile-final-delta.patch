+
+        val vm = FbsViewModel(provider)
+        vm.loadOrders(); advanceUntilIdle()
+        vm.toggle(first)
+        vm.loadOrders(append = true); advanceUntilIdle()
+
+        assertEquals(listOf(second), vm.state.value.orders)
+        assertTrue(vm.state.value.selected.isEmpty())
+        coVerify(exactly = 2) { service.orders(marketplace = "wb", group = "tsd_working", cursor = null) }
+        coVerify(exactly = 0) { service.orders(marketplace = "wb", group = "tsd_working", cursor = "old-cursor") }
+    }
