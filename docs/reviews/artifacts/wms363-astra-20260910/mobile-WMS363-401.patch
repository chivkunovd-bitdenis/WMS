 @page{size:58mm 40mm;margin:0}body{margin:0;background:white;color:black}section{width:56mm;height:38mm;padding:1mm;page-break-after:always;overflow:hidden;text-align:center}section:last-child{page-break-after:auto}img,canvas{max-width:54mm;max-height:29mm;object-fit:contain}p{font:10px sans-serif;margin:1mm;overflow-wrap:anywhere}
 </style><script>$encoder</script></head><body>${pages.joinToString("")}</body></html>"""
+
+/** Render every page of an Ozon PDF locally; never discard later posting labels. */
+fun pdfLabelImages(bytes: ByteArray, cacheDirectory: java.io.File): List<String> {
+    require(bytes.size <= 16 * 1024 * 1024) { "Файл этикеток слишком большой" }
+    val file = java.io.File.createTempFile("fbs-label-", ".pdf", cacheDirectory)
+    try {
+        file.writeBytes(bytes)
+        return ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY).use { descriptor ->
+            android.graphics.pdf.PdfRenderer(descriptor).use { pdf ->
+                require(pdf.pageCount in 1..32) { "Некорректное число страниц этикеток" }
+                (0 until pdf.pageCount).map { index ->
+                    pdf.openPage(index).use { page ->
+                        val scale = 1000.0 / maxOf(page.width, page.height)
+                        val bitmap = android.graphics.Bitmap.createBitmap(
+                            (page.width * scale).toInt().coerceAtLeast(1),
+                            (page.height * scale).toInt().coerceAtLeast(1),
+                            android.graphics.Bitmap.Config.ARGB_8888,
+                        )
+                        try {
+                            bitmap.eraseColor(android.graphics.Color.WHITE)
+                            page.render(bitmap, null, null, android.graphics.pdf.PdfRenderer.Page.RENDER_MODE_FOR_PRINT)
+                            val output = java.io.ByteArrayOutputStream()
+                            check(bitmap.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, output))
+                            inlineImage(output.toByteArray(), "image/png")
+                        } finally { bitmap.recycle() }
+                    }
+                }
+            }
+        }
+    } finally { file.delete() }
+}
