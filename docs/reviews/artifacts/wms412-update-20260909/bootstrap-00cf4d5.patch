+++ b/android/app/src/main/java/ru/wms/tsd/features/update/UpdateInstaller.kt
@@ -0,0 +1,51 @@
+package ru.wms.tsd.features.update
+
+import android.content.ClipData
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageInfo
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import android.provider.Settings
+import androidx.core.content.FileProvider
+import java.io.File
+
+class UpdateFileProvider : FileProvider()
+
+class UpdateInstaller(private val context: Context) {
+    @Suppress("DEPRECATION")
+    fun verify(file: File, update: AppUpdate) {
+        val pm = context.packageManager
+        val flags = if (Build.VERSION.SDK_INT >= 28) PackageManager.GET_SIGNING_CERTIFICATES else PackageManager.GET_SIGNATURES
+        val installed = pm.getPackageInfo(context.packageName, flags)
+        val archive = requireNotNull(pm.getPackageArchiveInfo(file.absolutePath, flags)) { "Android не распознал файл обновления." }
+        verifyIdentity(installed.identity(), archive.identity(), update, Build.VERSION.SDK_INT)
+    }
+
+    fun allowed(): Boolean = Build.VERSION.SDK_INT < 26 || context.packageManager.canRequestPackageInstalls()
+
+    fun permissionIntent(): Intent = Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, Uri.parse("package:${context.packageName}"))
+
+    @Suppress("DEPRECATION")
+    fun installIntent(file: File): Intent {
+        val uri = FileProvider.getUriForFile(context, "${context.packageName}.updates", file)
+        return Intent(Intent.ACTION_INSTALL_PACKAGE).apply {
+            setDataAndType(uri, "application/vnd.android.package-archive")
+            clipData = ClipData.newRawUri("Обновление WMS ТСД", uri)
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            putExtra(Intent.EXTRA_RETURN_RESULT, true)
+        }
+    }
+}
+
+@Suppress("DEPRECATION")
+private fun PackageInfo.identity(): ApkIdentity {
+    val certificates = if (Build.VERSION.SDK_INT >= 28) signingInfo?.apkContentsSigners else signatures
+    return ApkIdentity(
+        packageName,
+        if (Build.VERSION.SDK_INT >= 28) longVersionCode else versionCode.toLong(),
+        requireNotNull(applicationInfo).minSdkVersion,
+        certificates.orEmpty().map { it.toCharsString() }.toSet(),
+    )
+}
diff --git a/android/app/src/main/java/ru/wms/tsd/features/update/UpdateRepository.kt b/android/app/src/main/java/ru/wms/tsd/features/update/UpdateRepository.kt
new file mode 100644
index 0000000..5953239
--- /dev/null
+++ b/android/app/src/main/java/ru/wms/tsd/features/update/UpdateRepository.kt
@@ -0,0 +1,153 @@
+package ru.wms.tsd.features.update
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import okhttp3.CacheControl
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import ru.wms.tsd.BuildConfig
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+import java.security.MessageDigest
+import java.util.concurrent.TimeUnit
+import kotlin.coroutines.coroutineContext
+
+private const val MAX_APK_BYTES = 120L * 1024 * 1024
+
+@Serializable
+data class AppUpdate(
+    val versionCode: Long,
+    val versionName: String,
+    val apkUrl: String,
+    val sha256: String,
+    val sizeBytes: Long,
+    val minSdk: Int,
+    val notes: String = "",
+) {
+    fun validate() {
+        require(versionCode > 0 && versionName.isNotBlank() && versionName.length <= 100) { "Не удалось прочитать версию обновления." }
+        require(sizeBytes in 1..MAX_APK_BYTES && minSdk >= 24) { "Некорректный размер или версия Android в обновлении." }
+        require(sha256.matches(Regex("[a-fA-F0-9]{64}"))) { "В обновлении отсутствует контрольная сумма." }
+        val url = apkUrl.toHttpUrl()
+        require(url.isHttps && url.username.isEmpty() && url.password.isEmpty()) { "Обновление должно загружаться по защищённому соединению." }
+        require(notes.length <= 4000) { "Описание обновления слишком длинное." }
+    }
+}
+
+internal data class ApkIdentity(val packageName: String, val versionCode: Long, val minSdk: Int, val signers: Set<String>)
+
+internal fun verifyIdentity(installed: ApkIdentity, archive: ApkIdentity, update: AppUpdate, sdk: Int) {
+    require(archive.packageName == installed.packageName) { "Этот файл предназначен для другого приложения." }
+    require(archive.versionCode == update.versionCode && archive.versionCode > installed.versionCode) { "Версия файла не соответствует обновлению или уже установлена." }
+    require(archive.minSdk == update.minSdk && archive.minSdk <= sdk) { "Обновление не поддерживает эту версию Android." }
+    require(installed.signers.isNotEmpty() && archive.signers == installed.signers) { "Подпись обновления не совпадает с установленным приложением." }
+}
+
+internal fun File.sha256(): String = inputStream().use { input ->
+    val digest = MessageDigest.getInstance("SHA-256")
+    val buffer = ByteArray(64 * 1024)
+    while (true) {
+        val read = input.read(buffer)
+        if (read == -1) break
+        digest.update(buffer, 0, read)
+    }
+    digest.digest().joinToString("") { "%02x".format(it) }
+}
+
+/** A partial download is never exposed to Android's installer. */
+internal suspend fun saveApk(input: InputStream, target: File, update: AppUpdate, progress: (Int) -> Unit) {
+    val partial = File(target.parentFile, target.name + ".part")
+    try {
+        var count = 0L
+        var lastPercent = -1
+        partial.outputStream().use { output ->
+            val buffer = ByteArray(64 * 1024)
+            while (true) {
+                coroutineContext.ensureActive()
+                val read = input.read(buffer)
+                if (read == -1) break
+                count += read
+                require(count <= update.sizeBytes && count <= MAX_APK_BYTES) { "Размер файла обновления не совпадает с заявленным." }
+                output.write(buffer, 0, read)
+                val percent = (count * 100 / update.sizeBytes).toInt()
+                if (percent != lastPercent) { progress(percent); lastPercent = percent }
+            }
+        }
+        require(count == update.sizeBytes && partial.sha256().equals(update.sha256, ignoreCase = true)) { "Файл скачан не полностью или повреждён. Скачайте его ещё раз." }
+        check(partial.renameTo(target)) { "Не удалось сохранить обновление. Проверьте свободное место." }
+    } finally {
+        partial.delete()
+    }
+}
+
+interface UpdateSource {
+    suspend fun latest(): AppUpdate
+    suspend fun download(update: AppUpdate, progress: (Int) -> Unit): File
+    suspend fun verify(file: File, update: AppUpdate)
+}
+
+class UpdateRepository(
+    private val directory: File,
+    private val verifyArchive: (File, AppUpdate) -> Unit,
+    private val manifestUrl: String = BuildConfig.APK_UPDATE_MANIFEST_URL,
+    // Deliberately independent of WMS API: no session token or API logging goes to the release host.
+    private val client: OkHttpClient = OkHttpClient.Builder()
+        .connectTimeout(20, TimeUnit.SECONDS).readTimeout(30, TimeUnit.SECONDS)
+        .callTimeout(5, TimeUnit.MINUTES).followSslRedirects(false).build(),
+) : UpdateSource {
+    private val json = Json { ignoreUnknownKeys = true }
+
+    override suspend fun latest(): AppUpdate = withContext(Dispatchers.IO) {
+        val url = manifestUrl.toHttpUrl()
+        require(url.isHttps) { "Адрес обновлений должен использовать защищённое соединение." }
+        val request = Request.Builder().url(url.newBuilder().addQueryParameter("check", System.currentTimeMillis().toString()).build())
+            .cacheControl(CacheControl.FORCE_NETWORK).build()
+        client.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) throw IOException("Не удалось проверить обновление (HTTP ${response.code}). Повторите позже.")
+            val body = response.body ?: throw IOException("Сервер обновлений вернул пустой ответ.")
+            val bytes = body.byteStream().use { it.readBytesLimited(32 * 1024) }
+            json.decodeFromString<AppUpdate>(bytes.toString(Charsets.UTF_8)).also { it.validate() }
+        }
+    }
+
+    override suspend fun download(update: AppUpdate, progress: (Int) -> Unit): File = withContext(Dispatchers.IO) {
+        update.validate()
+        check(directory.isDirectory || directory.mkdirs()) { "Не удалось создать папку обновления." }
+        val target = File(directory, "${update.versionCode}-${update.sha256.lowercase()}.apk")
+        if (target.isFile) {
+            try { verify(target, update); return@withContext target } catch (_: IllegalArgumentException) { target.delete() }
+        }
+        // Only this screen uses the restricted updates cache directory.
+        directory.listFiles()?.filter { it != target }?.forEach { it.delete() }
+        client.newCall(Request.Builder().url(update.apkUrl).build()).execute().use { response ->
+            if (!response.isSuccessful) throw IOException("Не удалось скачать обновление (HTTP ${response.code}). Повторите позже.")
+            val body = response.body ?: throw IOException("Сервер вернул пустой файл.")
+            require(body.contentLength() == -1L || body.contentLength() == update.sizeBytes) { "Размер файла обновления не совпадает с заявленным." }
+            body.byteStream().use { saveApk(it, target, update, progress) }
+        }
+        try { verify(target, update) } catch (error: Exception) { target.delete(); throw error }
+        target
+    }
+
+    override suspend fun verify(file: File, update: AppUpdate) = withContext(Dispatchers.IO) {
+        require(file.isFile && file.length() == update.sizeBytes && file.sha256().equals(update.sha256, ignoreCase = true)) { "Файл обновления отсутствует или повреждён. Скачайте его ещё раз." }
+        verifyArchive(file, update)
+    }
+}
+
+private fun InputStream.readBytesLimited(limit: Int): ByteArray {
+    val output = java.io.ByteArrayOutputStream()
+    val buffer = ByteArray(4096)
+    while (true) {
+        val read = read(buffer)
+        if (read == -1) break
+        require(output.size() + read <= limit) { "Сервер вернул слишком большой ответ об обновлении." }
+        output.write(buffer, 0, read)
+    }
+    return output.toByteArray()
+}
