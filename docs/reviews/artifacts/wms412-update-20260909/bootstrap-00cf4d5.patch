+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.ByteArrayInputStream
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+import java.security.MessageDigest
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class UpdateTest {
+    @get:Rule val tmp = TemporaryFolder()
+    private val bytes = "sample apk bytes".toByteArray()
+    private val update = AppUpdate(8, "0.1.7", "https://github.com/example/app.apk", MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }, bytes.size.toLong(), 24)
+    private val installed = ApkIdentity("ru.wms.tsd", 7, 24, setOf("signer"))
+    private val archive = installed.copy(versionCode = 8)
+    @Before fun setup() { Dispatchers.setMain(UnconfinedTestDispatcher()) }
+    @After fun teardown() { Dispatchers.resetMain() }
+
+    @Test fun `manifest rejects insecure authenticated oversized or malformed files`() {
+        update.validate()
+        listOf(
+            update.copy(apkUrl = "http://example.com/app.apk"),
+            update.copy(apkUrl = "https://user:password@example.com/app.apk"),
+            update.copy(sizeBytes = 0), update.copy(sizeBytes = 121L * 1024 * 1024),
+            update.copy(sha256 = "invalid"), update.copy(versionCode = 0),
+        ).forEach { assertThrows(IllegalArgumentException::class.java) { it.validate() } }
+    }
+
+    @Test fun `apk must match package signing certificate manifest version and Android support`() {
+        verifyIdentity(installed, archive, update, 24)
+        listOf(
+            archive.copy(packageName = "another.app"), archive.copy(signers = emptySet()),
+            archive.copy(signers = setOf("other-signer")), archive.copy(versionCode = 9),
+            archive.copy(minSdk = 26),
+        ).forEach { assertThrows(IllegalArgumentException::class.java) { verifyIdentity(installed, it, update, 24) } }
+        assertThrows(IllegalArgumentException::class.java) { verifyIdentity(installed, installed, update.copy(versionCode = 7), 24) }
+    }
+
+    @Test fun `only a complete matching download becomes installable`() = runTest {
+        val target = File(tmp.root, "update.apk"); val progress = mutableListOf<Int>()
+        saveApk(ByteArrayInputStream(bytes), target, update, progress::add)
+        assertArrayEquals(bytes, target.readBytes()); assertEquals(100, progress.last())
+        assertFalse(File(tmp.root, "update.apk.part").exists())
+    }
+
+    @Test fun `truncated corrupted and oversized downloads leave no installable or partial file`() = runTest {
+        for (body in listOf(bytes.dropLast(1).toByteArray(), ByteArray(bytes.size), bytes + 1)) {
+            val target = File(tmp.root, "update.apk")
+            try { saveApk(ByteArrayInputStream(body), target, update) {}; fail("Accepted damaged download") } catch (_: IllegalArgumentException) { }
+            assertFalse(target.exists()); assertFalse(File(tmp.root, "update.apk.part").exists())
+        }
+    }
+
+    @Test fun `network interruption cleans partial download and retry succeeds`() = runTest {
+        val target = File(tmp.root, "update.apk")
+        val input = object : InputStream() { override fun read(): Int = throw IOException("Connection lost") }
+        try { saveApk(input, target, update) {}; fail("Expected network error") } catch (_: IOException) { }
+        assertFalse(target.exists()); assertFalse(File(tmp.root, "update.apk.part").exists())
+        saveApk(ByteArrayInputStream(bytes), target, update) {}; assertTrue(target.exists())
+    }
+
+    @Test fun `cancelled download is not left ready to install`() = runTest {
+        val target = File(tmp.root, "update.apk")
+        val job = launch {
+            coroutineContext[kotlinx.coroutines.Job]!!.cancel()
+            saveApk(ByteArrayInputStream(bytes), target, update) {}
+        }
+        job.join(); assertFalse(target.exists()); assertFalse(File(tmp.root, "update.apk.part").exists())
+    }
+
+    @Test fun `current or older version never offers download`() = runTest {
+        val source = mockk<UpdateSource>(); coEvery { source.latest() } returns update.copy(versionCode = 7)
+        val vm = UpdateViewModel(source, 7, 24); vm.check()
+        assertTrue(vm.state.value.checked); assertNull(vm.state.value.available)
+        vm.download(); coVerify(exactly = 0) { source.download(any(), any()) }
+    }
+
+    @Test fun `check failure stays retryable and does not report latest installed`() = runTest {
+        val source = mockk<UpdateSource>(); coEvery { source.latest() } throws IOException("offline")
+        val vm = UpdateViewModel(source, 7, 24); vm.check()
+        assertFalse(vm.state.value.checked); assertNotNull(vm.state.value.error); assertFalse(vm.state.value.busy)
+        coEvery { source.latest() } returns update; vm.check(); assertEquals(update, vm.state.value.available); assertNull(vm.state.value.error)
+    }
+
+    @Test fun `incompatible Android cannot download update`() = runTest {
+        val source = mockk<UpdateSource>(); coEvery { source.latest() } returns update.copy(minSdk = 26)
+        val vm = UpdateViewModel(source, 7, 24); vm.check(); vm.download()
+        assertNull(vm.state.value.available); assertNotNull(vm.state.value.error)
+        coVerify(exactly = 0) { source.download(any(), any()) }
+    }
+
+    @Test fun `double download tap does not start duplicate download`() = runTest {
+        val source = mockk<UpdateSource>(); val downloaded = CompletableDeferred<File>(); val target = tmp.newFile("update.apk")
+        coEvery { source.latest() } returns update
+        coEvery { source.download(update, any()) } coAnswers { downloaded.await() }
+        val vm = UpdateViewModel(source, 7, 24); vm.check(); vm.download(); vm.download()
+        assertTrue(vm.state.value.busy); downloaded.complete(target)
+        assertEquals(target, vm.state.value.file); coVerify(exactly = 1) { source.download(update, any()) }
+    }
+
+    @Test fun `returning from denied permission or cancelled install keeps file and revalidates on next tap`() = runTest {
+        val source = mockk<UpdateSource>(); val target = tmp.newFile("update.apk")
+        coEvery { source.latest() } returns update; coEvery { source.download(update, any()) } returns target
+        coEvery { source.verify(target, update) } returns Unit
+        val vm = UpdateViewModel(source, 7, 24); vm.check(); vm.download()
+        var launches = 0; vm.prepareInstall { launches++ }; vm.installMessage("Permission denied")
+        vm.prepareInstall { launches++ }; assertEquals(2, launches)
+        assertEquals(target, vm.state.value.file); coVerify(exactly = 2) { source.verify(target, update) }
+    }
+
+    @Test fun `changed or deleted cached file cannot reach installer`() = runTest {
+        val source = mockk<UpdateSource>(); val target = tmp.newFile("update.apk")
+        coEvery { source.latest() } returns update; coEvery { source.download(update, any()) } returns target
+        coEvery { source.verify(target, update) } throws IllegalArgumentException("Bad checksum")
+        val vm = UpdateViewModel(source, 7, 24); vm.check(); vm.download()
+        vm.prepareInstall { fail("Installer opened with invalid APK") }
+        assertNull(vm.state.value.file); assertNotNull(vm.state.value.error)
+    }
+}
