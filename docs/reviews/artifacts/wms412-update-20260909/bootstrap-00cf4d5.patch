+package ru.wms.tsd.features.update
+
+import android.app.Activity
+import android.os.Build
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.Button
+import androidx.compose.material3.LinearProgressIndicator
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.OutlinedButton
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.ViewModelProvider
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import androidx.lifecycle.viewmodel.compose.viewModel
+import ru.wms.tsd.BuildConfig
+import ru.wms.tsd.ui.patterns.ScanFlash
+import ru.wms.tsd.ui.patterns.ScanScaffold
+import java.io.File
+
+@Composable
+fun UpdateScreen(onBack: () -> Unit) {
+    val context = LocalContext.current
+    val installer = remember { UpdateInstaller(context.applicationContext) }
+    val vm: UpdateViewModel = viewModel(factory = remember {
+        object : ViewModelProvider.Factory {
+            @Suppress("UNCHECKED_CAST")
+            override fun <T : ViewModel> create(modelClass: Class<T>): T = UpdateViewModel(
+                UpdateRepository(File(context.cacheDir, "updates"), installer::verify),
+                BuildConfig.VERSION_CODE.toLong(), Build.VERSION.SDK_INT,
+            ) as T
+        }
+    })
+    val state by vm.state.collectAsStateWithLifecycle()
+    val permissionLauncher = rememberLauncherForActivityResult(ActivityResultContracts.StartActivityForResult()) {
+        vm.installMessage(if (installer.allowed()) "Разрешение получено. Нажмите «Установить обновление»." else "Установка пока не разрешена. Текущая версия продолжает работать.")
+    }
+    val installLauncher = rememberLauncherForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
+        // A successful self-update restarts the process. Returning to this version is not success proof.
+        if (result.resultCode != Activity.RESULT_OK) vm.installMessage("Установка не завершена. Можно повторить её или продолжить работу.")
+    }
+    ScanScaffold(title = "Обновление приложения", flash = ScanFlash.None, onExit = onBack, cameraScanner = false) {
+        Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp), verticalArrangement = Arrangement.spacedBy(16.dp)) {
+            Text("Установлена версия ${BuildConfig.VERSION_NAME}", fontSize = 22.sp)
+            Text("Обновляйте приложение между заданиями. Вход, адрес сервера и сохранённые данные останутся на устройстве.")
+            state.error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+            if (state.busy) {
+                val percent = state.downloadPercent
+                if (percent == null) { LinearProgressIndicator(Modifier.fillMaxWidth()); Text("Проверяем обновление…") }
+                else { LinearProgressIndicator(progress = { percent / 100f }, modifier = Modifier.fillMaxWidth()); Text("Скачивание: $percent %") }
+            }
+            val update = state.available
+            if (update != null) {
+                Text("Доступна версия ${update.versionName}", fontSize = 22.sp)
+                Text("Размер: ${update.sizeBytes / (1024 * 1024)} МБ")
+                if (update.notes.isNotBlank()) Text(update.notes)
+                if (state.file == null) Button(onClick = vm::download, enabled = !state.busy, modifier = Modifier.fillMaxWidth()) { Text("Скачать обновление", fontSize = 20.sp) }
+                else {
+                    Text("Обновление скачано и проверено. Android попросит подтвердить установку.")
+                    Button(onClick = {
+                        vm.prepareInstall { file ->
+                            if (installer.allowed()) installLauncher.launch(installer.installIntent(file))
+                            else permissionLauncher.launch(installer.permissionIntent())
+                        }
+                    }, enabled = !state.busy, modifier = Modifier.fillMaxWidth()) { Text("Установить обновление", fontSize = 20.sp) }
+                }
+            } else if (state.checked) Text("Установлена последняя версия.", fontSize = 22.sp)
+            OutlinedButton(onClick = vm::check, enabled = !state.busy, modifier = Modifier.fillMaxWidth()) { Text("Проверить обновление", fontSize = 20.sp) }
+        }
+    }
+}
diff --git a/android/app/src/main/java/ru/wms/tsd/features/update/UpdateViewModel.kt b/android/app/src/main/java/ru/wms/tsd/features/update/UpdateViewModel.kt
new file mode 100644
index 0000000..44a7dcc
--- /dev/null
+++ b/android/app/src/main/java/ru/wms/tsd/features/update/UpdateViewModel.kt
@@ -0,0 +1,70 @@
+package ru.wms.tsd.features.update
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import java.io.File
+
+data class UpdateState(
+    val busy: Boolean = false,
+    val checked: Boolean = false,
+    val available: AppUpdate? = null,
+    val downloadPercent: Int? = null,
+    val file: File? = null,
+    val error: String? = null,
+)
+
+class UpdateViewModel(private val source: UpdateSource, private val currentVersion: Long, private val sdk: Int) : ViewModel() {
+    private val mutableState = MutableStateFlow(UpdateState())
+    val state = mutableState.asStateFlow()
+
+    fun check() = action {
+        mutableState.value = UpdateState(busy = true)
+        val update = source.latest()
+        if (update.versionCode > currentVersion) {
+            require(update.minSdk <= sdk) { "Новая версия требует более новый Android. На этом устройстве продолжайте работать в установленной версии." }
+            mutableState.update { it.copy(checked = true, available = update) }
+        } else mutableState.update { it.copy(checked = true) }
+    }
+
+    fun download() {
+        if (state.value.available == null) return
+        action {
+        val update = state.value.available ?: return@action
+        mutableState.update { it.copy(file = null, downloadPercent = 0) }
+        val file = source.download(update) { percent -> mutableState.update { it.copy(downloadPercent = percent) } }
+        mutableState.update { it.copy(file = file, downloadPercent = null) }
+        }
+    }
+
+    fun prepareInstall(onReady: (File) -> Unit) {
+        if (state.value.available == null || state.value.file == null) return
+        action {
+        val update = state.value.available ?: return@action
+        val file = state.value.file ?: return@action
+        try { source.verify(file, update) } catch (error: Exception) {
+            if (error is CancellationException) throw error
+            mutableState.update { it.copy(file = null) }
+            throw error
+        }
+        onReady(file)
+        }
+    }
+
+    fun installMessage(message: String) { mutableState.update { it.copy(error = message) } }
+
+    private fun action(block: suspend () -> Unit) {
+        if (state.value.busy) return
+        mutableState.update { it.copy(busy = true, error = null) }
+        viewModelScope.launch {
+            try { block() } catch (error: Exception) {
+                if (error is CancellationException) throw error
+                mutableState.update { it.copy(error = error.message ?: "Не удалось обновить приложение. Проверьте сеть и свободное место.") }
+            } finally { mutableState.update { it.copy(busy = false, downloadPercent = null) } }
+        }
+    }
+}
