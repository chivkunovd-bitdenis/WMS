From d15f09d4c09c74438ebd6b31632db0c346525a6f Mon Sep 17 00:00:00 2001
From: Denis Civkunov <denischivkunov@icloud.com>
Date: Wed, 9 Sep 2026 12:38:40 +0300
Subject: [PATCH] WMS-401: open password login from saved staff selection

---
 .../src/main/java/ru/wms/tsd/features/auth/LoginScreen.kt    | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/android/app/src/main/java/ru/wms/tsd/features/auth/LoginScreen.kt b/android/app/src/main/java/ru/wms/tsd/features/auth/LoginScreen.kt
index 91cb8a4..dda82a9 100644
--- a/android/app/src/main/java/ru/wms/tsd/features/auth/LoginScreen.kt
+++ b/android/app/src/main/java/ru/wms/tsd/features/auth/LoginScreen.kt
@@ -87,13 +87,14 @@ fun LoginScreen(
     val coroutineScope = rememberCoroutineScope()
     val savedStaff = remember { authStore.getSavedStaff() }
     var showPinDialog by remember { mutableStateOf(false) }
+    var showPasswordLogin by remember { mutableStateOf(false) }
     var selectedEmail by remember { mutableStateOf("") }
 
     Surface(
         modifier = Modifier.fillMaxSize(),
         color = WmsColors.Background,
     ) {
-        if (savedStaff.isNotEmpty() && !showPinDialog) {
+        if (savedStaff.isNotEmpty() && !showPinDialog && !showPasswordLogin) {
             StaffSelectionScreen(
                 staff = savedStaff,
                 onStaffSelected = { email ->
@@ -101,7 +102,7 @@ fun LoginScreen(
                     showPinDialog = true
                 },
                 onLoginWithPassword = {
-                    showPinDialog = false
+                    showPasswordLogin = true
                 },
                 authStore = authStore,
                 authManager = authManager,
