+          [[ "$target_sha" =~ ^[0123456789abcdef]{40}$ ]]
+          python3 scripts/deploy/verify-ci.py --repository "$GITHUB_REPOSITORY" --sha "$target_sha"
+          echo "sha=$target_sha" >> "$GITHUB_OUTPUT"
