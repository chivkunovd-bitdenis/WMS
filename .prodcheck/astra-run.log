    27	export class FbsPrintOutcomeUnknownError extends Error {
    28	  readonly printOutcomeUnknown = true
    29	
    30	  constructor(message: string, options?: ErrorOptions) {
    31	    super(message, options)
    32	    this.name = 'FbsPrintOutcomeUnknownError'
    33	  }
    34	}
