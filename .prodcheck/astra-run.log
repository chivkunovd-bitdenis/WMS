    16	export type FbsAutomaticPrintClaimApi<TClaim extends FbsAutomaticPrintClaimState> = {
    17	  claim: (attemptKey: string) => Promise<TClaim>
    18	  markStarted: (attemptKey: string) => Promise<FbsAutomaticPrintClaimState>
    19	  releaseClaim: (attemptKey: string) => Promise<unknown>
