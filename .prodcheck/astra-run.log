    36	type PrintOutcomeError = Error & { printOutcomeUnknown?: boolean }
    37	
    38	function outcomeMayBeUnknown(cause: unknown): boolean {
    39	  return cause instanceof Error && (cause as PrintOutcomeError).printOutcomeUnknown === true
    40	}
