    81	type TokenClaims = { sub?: unknown; tenant_id?: unknown }
    82	
    83	function tokenIdentity(token: string): { tenant: string; user: string } {
    84	  try {
    85	    const payload = token.split('.')[1]
    86	    if (!payload) throw new Error('token payload is absent')
    87	    const claims = JSON.parse(atob(payload.replace(/-/g, '+').replace(/_/g, '/'))) as TokenClaims
    88	    const tenant = typeof claims.tenant_id === 'string' && claims.tenant_id ? claims.tenant_id : 'unknown-tenant'
    89	    const user = typeof claims.sub === 'string' && claims.sub ? claims.sub : 'unknown-user'
    90	    return { tenant, user }
    91	  } catch {
    92	    // A malformed token must never turn on a printer unexpectedly.
    93	    return { tenant: 'unknown-tenant', user: 'unknown-user' }
    94	  }
    95	}
    96	
    97	/** The setting belongs to one FF operator in one browser, not to a supply or warehouse. */
    98	export function fbsKizAutoReprintStorageKey(token: string): string {
    99	  const identity = tokenIdentity(token)
   100	  return `${PREFERENCE_PREFIX}:${identity.tenant}:${identity.user}`
   101	}
   102	
   103	export function loadFbsKizAutoReprintEnabled(token: string): boolean {
   104	  try {
   105	    return window.localStorage.getItem(fbsKizAutoReprintStorageKey(token)) === 'true'
   106	  } catch {
   107	    return false
   108	  }
   109	}
   110	
   111	export function saveFbsKizAutoReprintEnabled(token: string, value: boolean): void {
   112	  try {
   113	    window.localStorage.setItem(fbsKizAutoReprintStorageKey(token), value ? 'true' : 'false')
   114	  } catch {
   115	    // Storage can be disabled on a hardened warehouse workstation. The in-memory
   116	    // checkbox state still applies to the current open workspace.
   117	  }
   118	}
   119	
   120	function attemptStorageKey(attemptId: string): string {
   121	  return `${ATTEMPT_PREFIX}:${attemptId}`
   122	}
   123	
   124	/**
   125	 * A scan commit can be replayed after a lost response. Claim the browser-side
   126	 * print before scheduling it, then retain that claim for the current browser
   127	 * session. The queue keeps rapid scans in their original order.
   128	 */
   129	export class FbsKizAutoPrintQueue {
   130	  private readonly startedAttempts = new Set<string>()
   131	  private tail: Promise<void> = Promise.resolve()
   132	
   133	  enqueue(snapshot: FbsKizAutoPrintSnapshot, print: FbsKizAutoPrint): Promise<boolean> {
   134	    if (!snapshot.enabled || !this.claim(snapshot.attemptId)) return Promise.resolve(false)
   135	
   136	    const job = this.tail.then(async () => {
   137	      try {
   138	        await print(snapshot.kiz)
   139	      } catch (cause) {
   140	        // Release only a proven pre-print failure. If window.print() may have
   141	        // run, retaining the claim is the only safe way to avoid a blind copy.
   142	        if (!outcomeMayBeUnknown(cause)) this.release(snapshot.attemptId)
   143	        throw cause
   144	      }
   145	    })
   146	    // A failed print must not prevent the next saved scan from reaching its printer.
   147	    this.tail = job.catch(() => undefined)
   148	    return job.then(() => true)
   149	  }
   150	
   151	  private claim(attemptId: string): boolean {
   152	    if (this.startedAttempts.has(attemptId)) return false
   153	    this.startedAttempts.add(attemptId)
   154	    try {
   155	      const key = attemptStorageKey(attemptId)
   156	      if (window.sessionStorage.getItem(key) === 'true') return false
   157	      window.sessionStorage.setItem(key, 'true')
   158	    } catch {
   159	      // The in-memory claim is still enough for this open page.
   160	    }
   161	    return true
   162	  }
   163	
   164	  private release(attemptId: string): void {
   165	    this.startedAttempts.delete(attemptId)
   166	    try {
   167	      window.sessionStorage.removeItem(attemptStorageKey(attemptId))
   168	    } catch {
   169	      // In-memory release is sufficient for the open page.
   170	    }
   171	  }
   172	}
