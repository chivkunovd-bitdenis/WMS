   695	    if marking.meta_status == META_STATUS_REJECTED:
   696	        reason = (marking.reason or "").strip()
   697	        return _WbVerdictBlocksPrint(
   698	            "meta_validation_fail",
   699	            f"WB не принял маркировку: {reason}" if reason else "WB не принял маркировку.",
   700	        )
   701	    if marking.meta_status == META_STATUS_REPLACEMENT_REQUIRED:
   702	        details = marking.meta_details_json if isinstance(marking.meta_details_json, dict) else {}
   703	        remote_value = details.get("value")
   704	        if isinstance(remote_value, str) and marking_svc._same_marking_value(
   705	            marking.value, remote_value
   706	        ):
   707	            return _WbVerdictBlocksPrint(
   708	                "replacement_required", "WB требует заменить код маркировки."
   709	            )
   710	        return _WbVerdictBlocksPrint(
   711	            "replacement_required", "WB подтвердил другой код маркировки."
   712	        )
   713	    return None
