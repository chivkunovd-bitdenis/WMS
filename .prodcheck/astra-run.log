   575	    const response = await fetch(apiUrl(path), { ...init, headers: {
   576	      ...authHeaders(token), 'Content-Type': 'application/json', ...init?.headers,
   577	    } })
   578	    if (!response.ok) {
   579	      const error = await response.json().catch(() => null)
   580	      throw new Error(error?.detail?.message ?? error?.detail?.code ?? 'Не удалось сохранить упаковку.')
   581	    }
   582	    return response.json()
   583	  }
