async def test_undo_removes_rejected_but_recorded_remote_code(async_client, monkeypatch):
    seed = await base._seed(async_client, 9996351)
    order, value = seed['order'], seed['value']
    remote = {'value': None}
    async def put(*args, **kwargs): remote['value'] = kwargs['value']
    async def get(*args, **kwargs): return base._wb_row(order.wb_order_id, remote['value'], 'sgtinApplied')
    async def delete(*args, **kwargs): remote['value'] = None
    monkeypatch.setattr(marking, 'put_marketplace_order_meta', put)
    monkeypatch.setattr(marking, 'fetch_marketplace_orders_meta_batch', get)
    monkeypatch.setattr(kiz, 'delete_marketplace_order_meta', delete)
    res = await async_client.post('/operations/fbs-orders/kiz/commit', headers=seed['headers'], json={'idempotency_key':'probe-rejected', 'scan_no_wb_wait':True, 'pairs':[{'order_id':str(order.order_id),'value':value,'confirmed':False}]})
    assert res.json()[0]['code'] == 'wb_rejected_kept'
    async with SessionLocal() as session:
        task = await session.scalar(select(base.PackagingTask))
        task.status = base.STATUS_IN_PROGRESS
        supply = await session.get(base.FbsSupply, seed['supply_id'])
        supply.packaging_task_id = task.id
        await session.commit()
    res = await async_client.post(f"/operations/fbs-supplies/{seed['supply_id']}/scan-undo", headers=seed['headers'], json={'order_id':str(order.order_id),'kiz_keys':['probe-rejected']})
    assert res.status_code == 200, res.text
    assert remote['value'] is None, 'UNDO_REPORTED_SUCCESS_BUT_REMOTE_KIZ_REMAINS'

async def test_own_accepted_kiz_can_reach_retry(async_client, monkeypatch):
    seed = await base._seed(async_client, 9996352)
    order, value = seed['order'], seed['value']
    async def put(*args, **kwargs): pass
    async def get(*args, **kwargs): return base._wb_row(order.wb_order_id, value, 'sgtinIntroduced')
    monkeypatch.setattr(marking, 'put_marketplace_order_meta', put)
    monkeypatch.setattr(marking, 'fetch_marketplace_orders_meta_batch', get)
    res = await async_client.post('/operations/fbs-orders/kiz/commit', headers=seed['headers'], json={'idempotency_key':'probe-own', 'scan_no_wb_wait':True, 'pairs':[{'order_id':str(order.order_id),'value':value,'confirmed':False}]})
    assert res.json()[0]['status'] == 'ok', res.text
    res = await async_client.post('/operations/fbs-orders/kiz/validate', headers=seed['headers'], json={'order_id':str(order.order_id),'value':value})
    assert res.status_code == 200, res.text

