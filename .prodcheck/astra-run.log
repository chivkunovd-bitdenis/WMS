   585	    const size = resolveLabelSize(sizeId)
   586	    return dispatchPreparedQrInKiosk({ imageDataUrl, idempotencyKey, widthMm: size.widthMm, heightMm: size.heightMm })
   587	  }
   588	  // WMS-633: one job per copy, one after another; WMS Print returns the saved
