   199	  let remaining = controllers
   200	  if (selectedRow) {
   201	    try { await selectedRow.scan(raw); return }
   202	    catch (cause) {
   203	      if (selectedRow.hasSelectedRow?.() || selectedRow.hasPending()
   204	        || !(cause instanceof FbsApiError)
   205	        || !NOT_FOUND_CODES.includes(cause.code)) throw cause
