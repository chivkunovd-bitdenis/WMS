+            raise_fbs_http(status.HTTP_404_NOT_FOUND, exc.code, message=exc.message)
+        raise_fbs_http(status.HTTP_409_CONFLICT, exc.code, message=exc.message)
+    return FbsScanUndoOut(warning=warning)
