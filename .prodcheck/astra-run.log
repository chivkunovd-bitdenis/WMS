    async with SessionLocal() as session:
        saved = await session.scalar(select(FbsOrderMarking).where(FbsOrderMarking.order_id == order.order_id, FbsOrderMarking.value == value))
        assert saved is None, 'FOREIGN_GTIN_BOUND_TO_SELECTED_PRODUCT: ' + res.json()[0]['code']

