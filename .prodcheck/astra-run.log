   673	def _wb_accepted_code_without_echo(exc: marking_svc.FbsMarkingError) -> bool:
   674	    """True when WB answered this call's KIZ write but has not echoed the value yet.
   675	
   676	    ``_send_or_reconcile_printed_marking`` raises ``wb_pending_confirmation``
   677	    for this case, after a lost WB answer (transport, 408, 5xx) and after a
   678	    reconciling read that returned no row for the order. Only the first one is
   679	    chained from ``FbsMarkingWriteAcceptedError``, which the write raises
   680	    itself once WB has answered its PUT (WMS-579). A readback that failed after
   681	    that PUT carries its own WB error code and is not printed either (WMS-560
   682	    R2): the next print reconciles and, on an empty value, resends the code.
   683	    """
   684	    if exc.code != "wb_pending_confirmation":
   685	        return False
   686	    cause = exc.__cause__
   687	    return (
   688	        isinstance(cause, marking_svc.FbsMarkingWriteAcceptedError)
   689	        and cause.code == "wb_pending_confirmation"
   690	    )
