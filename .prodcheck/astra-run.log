    42	/**
    43	 * Persist a print claim around one browser print invocation. A target already
    44	 * marked started is complete without another copy; an outstanding foreign
    45	 * claim is an unknown physical outcome and must never be retried blindly.
    46	 */
    47	export async function startClaimedAutomaticPrint<
    48	  TClaim extends FbsAutomaticPrintClaimState = FbsAutomaticPrintClaimState,
    49	>(
    50	  attemptKey: string,
    51	  print: (claim: TClaim) => Promise<void>,
    52	  api: FbsAutomaticPrintClaimApi<TClaim>,
    53	): Promise<FbsAutomaticPrintResult> {
    54	  const claim = await api.claim(attemptKey)
    55	  if (!claim.claimed) {
    56	    if (claim.started) return { started: true, printedNow: false }
    57	    throw new FbsPrintOutcomeUnknownError(
    58	      'Предыдущий запуск печати не подтверждён; автоматический повтор остановлен.',
    59	    )
    60	  }
    61	  try {
    62	    await print(claim)
    63	  } catch (cause) {
    64	    await api.releaseClaim(attemptKey).catch(() => undefined)
    65	    throw cause
    66	  }
    67	  try {
    68	    const started = await api.markStarted(attemptKey)
    69	    return { started: started.started, printedNow: true }
    70	  } catch (cause) {
    71	    throw new FbsPrintOutcomeUnknownError(
    72	      'Печать была запущена, но подтверждение результата не получено.',
    73	      { cause },
    74	    )
    75	  }
    76	}
