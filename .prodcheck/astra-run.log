    18	export type ScanIntakeOptions = {
    19	  /**
    20	   * Экран готов принимать сканы: вкладка открыта, работа не закрыта. Окна
    21	   * поверх экрана хук учитывает сам (см. bindRoot).
    22	   */
    23	  enabled: boolean
    24	  /**
    25	   * Обработчик одного кода. Вернул промис — следующий код ждёт его и
    26	   * передаётся уже после перерисовки, то есть обработчик видит состояние,
    27	   * которое оставил предыдущий скан. Звук и отметку обработчик даёт сам в тот
    28	   * момент, когда результат появился на экране.
    29	   */
    30	  onScan: (code: string) => unknown
    31	  /**
    32	   * Зовётся сразу, как только код принят, — ещё до очереди. Нужен, чтобы
    33	   * убрать следы скана там, где стоял курсор, пока они никуда не ушли.
    34	   */
    35	  onReceived?: (code: string) => void
    36	  isScanOnlyField?: BarcodeScannerOptions['isScanOnlyField']
    37	  scanOnlyFieldMinLength?: number
    38	  /** Отдавать обработчику сырую пачку клавиатуры (см. useBarcodeScanner). Дефолт false. */
    39	  emitRaw?: boolean
    40	}
    41	
    42	export type ScanIntake = {
    43	  /**
    44	   * Корневой узел экрана. По нему видно, не открыто ли поверх окно: MUI при
    45	   * открытии окна помечает всё остальное на странице aria-hidden, и пока окно
    46	   * открыто, экран сканы не принимает — работает окно (если у него свой
    47	   * сканер), как у всех экранов со сканером.
    48	   */
    49	  bindRoot: (node: HTMLElement | null) => void
    50	  /** Экран слушает прямо сейчас: включён и поверх него нет окна. Для плашки. */
    51	  listening: boolean
    52	  /** Отдать код в ту же очередь — например, введённый руками в поле скана. */
    53	  submit: (code: string) => void
    54	}
    55	
    56	/** Прямой ребёнок body, внутри которого стоит узел: окно карточки или корень приложения. */
    57	function topLevelElement(node: HTMLElement): HTMLElement | null {
    58	  const body = node.ownerDocument.body
    59	  let current: HTMLElement = node
    60	  while (current.parentElement && current.parentElement !== body) current = current.parentElement
    61	  return current.parentElement === body ? current : null
    62	}
    63	
    64	/** Поверх узла открыто окно: MUI скрыл его ветку от программы чтения на время окна. */
    65	export function scanTargetCovered(node: HTMLElement | null): boolean {
    66	  if (!node) return false
    67	  return topLevelElement(node)?.getAttribute('aria-hidden') === 'true'
    68	}
    69	
    70	export function useScanIntake({
    71	  enabled,
    72	  onScan,
    73	  onReceived,
    74	  isScanOnlyField,
    75	  scanOnlyFieldMinLength,
    76	  emitRaw = false,
    77	}: ScanIntakeOptions): ScanIntake {
    78	  const [node, setNode] = useState<HTMLElement | null>(null)
    79	  const bindRoot = useCallback((next: HTMLElement | null) => setNode(next), [])
    80	
    81	  const subscribe = useCallback(
    82	    (notify: () => void) => {
    83	      const top = node ? topLevelElement(node) : null
    84	      if (!top) return () => undefined
    85	      const observer = new MutationObserver(notify)
    86	      observer.observe(top, { attributes: true, attributeFilter: ['aria-hidden'] })
    87	      return () => observer.disconnect()
    88	    },
    89	    [node],
    90	  )
    91	  const covered = useSyncExternalStore(
    92	    subscribe,
    93	    () => scanTargetCovered(node),
    94	    () => false,
    95	  )
    96	  const listening = enabled && !covered
    97	
    98	  // Последний обработчик экрана. Обновляется до эффектов этого же рендера,
    99	  // поэтому очередь всегда зовёт обработчик со свежим состоянием.
   100	  const onScanRef = useRef(onScan)
   101	  const onReceivedRef = useRef(onReceived)
   102	  useLayoutEffect(() => {
   103	    onScanRef.current = onScan
   104	    onReceivedRef.current = onReceived
   105	  })
   106	
   107	  const queueRef = useRef<string[]>([])
   108	  const runningRef = useRef(false)
   109	  const [queueTick, setQueueTick] = useState(0)
   110	
   111	  const submit = useCallback((code: string) => {
   112	    try {
   113	      onReceivedRef.current?.(code)
   114	    } catch {
   115	      // Уборка следов — не повод потерять сам код.
   116	    }
   117	    queueRef.current.push(code)
   118	    setQueueTick((tick) => tick + 1)
   119	  }, [])
   120	
   121	  // Один код за раз. Следующий уходит только после того, как предыдущий
   122	  // обработан и экран перерисован: иначе второй код прочитал бы состояние до
   123	  // первого (например, ЧЗ ушёл бы как поиск стикера, а не как код заказа).
   124	  useEffect(() => {
   125	    if (runningRef.current) return
   126	    const code = queueRef.current.shift()
   127	    if (code === undefined) return
   128	    runningRef.current = true
   129	    let pending: unknown
   130	    try {
   131	      pending = onScanRef.current(code)
   132	    } catch {
   133	      // Обработчик сам показывает свои ошибки; очередь не должна вставать.
   134	      pending = undefined
   135	    }
