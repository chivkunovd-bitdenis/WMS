# Copy to wb_emulator/.env for docker-compose.emulator.yml (env_file is optional).
WB_EMULATOR_DB_PATH=/data/wb_emulator.sqlite

# JSON map: Authorization token -> seller_key (used by emulator auth).
WB_EMULATOR_TOKEN_MAP={"dev-token":"seller_a"}

# Optional: load/override tokens from mounted seed dir (see docker-compose.emulator.yml).
# WB_EMULATOR_TOKEN_MAP_FILE=/seed/tokens.json
