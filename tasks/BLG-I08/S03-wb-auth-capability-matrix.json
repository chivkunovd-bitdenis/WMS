  "last_success_contract": {
    "identity_dimensions": ["tenant_id", "seller_id", "capability", "environment"],
    "failure_states": ["NOT_CONFIGURED", "EXPIRED", "AUTH_REJECTED", "INSUFFICIENT_ACCESS", "CHECK_DELAYED", "NETWORK_UNAVAILABLE", "WB_UNAVAILABLE"],
    "failure_classes_covered": ["missing_configuration", "malformed_local_credential", "local_expiry", "http_401", "business_method_http_403", "http_429", "transport_timeout", "dns_failure", "http_5xx", "malformed_upstream_response"],
    "failure_rule": {
      "state": "replace_with_current_normalized_failure",
      "checked_at": "replace_with_attempt_time",
      "last_success_at": "preserve_previous_value_including_null",
      "success_source": "preserve_previous_value_including_null",
      "retry_after_at": "set_only_for_delayed_retry_when_available_or_locally_derived",
      "incident_ref": "replace_with_current_safe_reference_or_null"
    },
    "success_rule": {
      "accepted_evidence": ["valid_200_ping_shape", "successful_authorized_business_call"],
      "state": "CONNECTED",
      "checked_at": "replace_with_success_time",
      "last_success_at": "replace_with_success_time",
      "success_source": "replace_with_ping_or_business_call",
      "incident_ref": "clear_current_safe_reference",
      "environment_isolation": "sandbox_success_must_never_update_production_history"
    },
    "stale_rule": "STALE is derived from Product TTL and does not mutate checked_at, last_success_at or success_source.",
    "ui_interpretation": "Historical last_success_at is shown beside the current failure as a past fact, never as proof that the current connection works."
  },
  "redaction_contract": {
    "allowed_diagnostic_fields": ["capability", "environment", "configured", "normalized_state", "checked_at", "last_success_at", "success_source", "expires_at", "retry_after_at", "safe_incident_ref"],
    "denied_material": [
      "Authorization header or value",
      "X-Client-Secret header or value",
      "bearer token or any token fragment, mask or fingerprint",
      "encoded JWT or decoded JWT payload",
      "decoded JWT identifiers id, sid, asid and for",
      "JWT category bitmask and token-type internals",
      "request headers and request body",
      "raw response headers, body, detail or complete response",
      "raw upstream URL, query, path parameters or object identifiers",
      "derived material that can reconstruct or correlate a credential"
    ],
    "denied_sinks": [
      "persistent database or document storage",
      "cache",
      "queue, event or worker payload",
      "application or audit log",
      "trace, span or profiler payload",
      "metric value, label or exemplar",
      "exception message, stack, context or error reporter",
      "API response or websocket event",
      "UI state, DOM, browser storage or analytics",
      "support payload, export or ticket",
      "pipeline receipt, evidence, screenshot or attachment",
      "test snapshot or failure artifact"
    ],
    "adapter_rule": "Parse only an allowlisted normalized reason in adapter memory, discard raw material before returning, and construct exceptions from the sanitized normalized result.",
    "evidence_rule": "No test or pipeline artifact may contain credential or raw-upstream sentinels; evidence records only pass/fail, normalized state, safe reference and timestamps."
  },
  "emulator_case_defaults": {
