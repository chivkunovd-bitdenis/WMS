+                  <TableCell>
+                    <Typography variant="body2" sx={{ wordBreak: 'break-word' }} data-testid={`ff-packaging-line-barcode-${line.id}`}>
+                      {barcode || '—'}
+                    </Typography>
+                  </TableCell>
+                  <TableCell align="center">
+                    <Tooltip title={hasInstructions ? line.packaging_instructions : 'ТЗ не задано'}>
