+import { apiUrl } from '../../../api'
+import { fetchPendingMarking, pendingMarkingLineCount } from '../../../utils/pendingMarkingApi'
+import { readApiErrorMessage } from '../../../utils/readApiErrorMessage'
+
+const PACKAGING_API_MESSAGES_RU: Record<string, string> = {
+  unknown_barcode: 'ШК не найден в этом задании. Проверьте товар и выбранное задание.',
+  line_already_packed: 'По этому товару всё уже упаковано.',
+  undo_not_available: 'Нет действия, которое можно отменить.',
+  undo_not_supported: 'Это действие нельзя отменить.',
+}
+
+export async function readPackagingApiErrorMessage(res: Response): Promise<string> {
+  const message = await readApiErrorMessage(res)
+  return PACKAGING_API_MESSAGES_RU[message] ?? message
+}
+
+function authHeaders(token: string): Record<string, string> {
+  return { Authorization: `Bearer ${token}` }
+}
+
+function jsonHeaders(token: string): Record<string, string> {
+  return { ...authHeaders(token), 'Content-Type': 'application/json' }
+}
+
+export function fetchPackagingTask(token: string, taskId: string, includeJsonHeader = false) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}`), {
+    headers: includeJsonHeader ? jsonHeaders(token) : authHeaders(token),
+  })
+}
+
+export function markProductLabelPrinted(
+  token: string,
+  taskId: string,
+  lineId: string,
+  quantity: number,
+) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/product-label-printed`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ quantity }),
+  })
+}
+
+export function confirmPackagingLine(token: string, taskId: string, lineId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/confirm-packed`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({}),
+  })
+}
+
+export function packPackagingLine(token: string, taskId: string, lineId: string, quantity: number) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/pack`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ quantity }),
+  })
+}
+
+export function scanPackagingTask(token: string, taskId: string, barcode: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/scan`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ barcode }),
+  })
+}
+
+export function undoPackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/undo-last`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+  })
+}
+
+export function fetchPrintedMarkingCodes(token: string, lineId: string) {
+  return fetch(apiUrl(`/operations/marking-codes/packaging-task-lines/${lineId}/printed-codes`), {
+    headers: jsonHeaders(token),
+  })
+}
+
+export function defectMarkingCode(
+  token: string,
+  codeId: string,
+  lineId: string,
+  reason: string | null,
+) {
+  return fetch(apiUrl(`/operations/marking-codes/codes/${codeId}/defect`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ packaging_task_line_id: lineId, reason }),
+  })
+}
+
+export function cancelPackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/cancel`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+  })
+}
+
+export function completePackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/complete`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ acknowledge_all_packed: false }),
+  })
+}
+
+export function fetchWarehouses(token: string) {
+  return fetch(apiUrl('/warehouses'), { headers: jsonHeaders(token) })
+}
+
+export function fetchWarehouseLocations(token: string, warehouseId: string) {
+  return fetch(apiUrl(`/warehouses/${warehouseId}/locations`), { headers: jsonHeaders(token) })
+}
+
+export function fetchInventoryBalances(token: string, locationId: string) {
+  return fetch(apiUrl(`/operations/inventory-balances?storage_location_id=${locationId}`), {
+    headers: jsonHeaders(token),
+  })
+}
+
+export function createPackagingTask(
+  token: string,
+  warehouseId: string,
+  lines: Array<{ product_id: string; storage_location_id: string; quantity: number }>,
+) {
+  return fetch(apiUrl('/operations/packaging-tasks'), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ warehouse_id: warehouseId, lines }),
+  })
+}
+
+export function fetchPackagingTasks(token: string, params: URLSearchParams) {
+  return fetch(apiUrl(`/operations/packaging-tasks?${params}`), { headers: authHeaders(token) })
+}
+
+export async function fetchPendingMarkingCount(token: string): Promise<number> {
+  return pendingMarkingLineCount(await fetchPendingMarking(token))
+}
+
+export function fetchPackagingTaskByUnload(token: string, unloadId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/by-unload/${unloadId}`), {
+    headers: authHeaders(token),
+  })
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingCalculations.ts b/frontend/src/screens/ff/packaging/PackagingCalculations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e6af0539dd74be3f27406046255f391708f63eac
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingCalculations.ts
@@ -0,0 +1,105 @@
+import type { PackagingTask, PackagingTaskEvent, PackagingTaskLine } from './PackagingTypes'
+
+export const MARKING_NOT_DONE_MESSAGE =
+  'Не хватает напечатанных КМ по заданию на упаковку.'
+
+export function statusLabel(status: string): string {
+  if (status === 'draft') return 'Черновик'
+  if (status === 'in_progress') return 'В работе'
+  if (status === 'done') return 'Выполнено'
+  if (status === 'cancelled') return 'Отменено'
+  return status
+}
+
+export function locationLabel(code?: string | null): string {
+  if (!code) return '—'
+  return code === '__SORTING__' ? 'Сортировка' : code
+}
+
+export function taskTotals(task: PackagingTask): { total: number; done: number; remaining: number } {
+  const total = task.lines.reduce((sum, line) => sum + line.qty_total, 0)
+  const done = task.lines.reduce((sum, line) => sum + line.qty_done, 0)
+  return { total, done, remaining: Math.max(0, total - done) }
+}
+
+export function taskSellerLabel(task: PackagingTask): string {
+  return task.seller_name ?? task.lines[0]?.seller_name ?? 'Селлер не указан'
+}
+
+export function taskPlaceLabel(task: PackagingTask, addressStorageEnabled = true): string {
+  const warehouse = task.warehouse_name ?? task.warehouse_code ?? 'Склад'
+  if (!addressStorageEnabled) return warehouse
+  const cells = Array.from(new Set(task.lines.map((line) => locationLabel(line.storage_location_code))))
+  return `${warehouse} / ${cells.slice(0, 2).join(', ')}${cells.length > 2 ? ` +${cells.length - 2}` : ''}`
+}
+
+export function taskProductSummary(task: PackagingTask): string {
+  const names = task.lines.map((line) => line.product_name || line.sku_code).slice(0, 2)
+  return `${names.join(', ')}${task.lines.length > 2 ? ` +${task.lines.length - 2}` : ''}`
+}
+
+export function parseStrictPositiveInteger(raw: string): number | null {
+  const value = raw.trim()
+  if (!/^[1-9]\d*$/.test(value)) {
+    return null
+  }
+  return Number(value)
+}
+
+export function sellerCountLabel(count: number): string {
+  const mod10 = count % 10
+  const mod100 = count % 100
+  if (mod10 === 1 && mod100 !== 11) {
+    return `${count} селлер`
+  }
+  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) {
+    return `${count} селлера`
+  }
+  return `${count} селлеров`
+}
+
+export function comparePackagingEventsAsc(a: PackagingTaskEvent, b: PackagingTaskEvent): number {
+  return a.event_sequence - b.event_sequence
+}
+
+/** События без количества. manual_pack и undo_last собираются ниже — им нужно число. */
+const PACKAGING_EVENT_LABELS: Record<string, string> = {
+  scan_pack: '+1 скан',
+  product_label_print: 'Печать этикетки товара',
+  prepacked_external: 'Пришло готовым (без печати)',
+  cancel: 'Задание отменено',
+  complete: 'Задание выполнено',
+}
+
+export function packagingEventLabel(action: string, quantity: number): string {
+  if (action === 'manual_pack') {
+    return `+${quantity} вручную`
+  }
+  if (action === 'undo_last') {
+    return `Отмена ${quantity} шт`
+  }
+  return PACKAGING_EVENT_LABELS[action] ?? action
+}
+
+/** Mirrors backend assert_packaging_line_marking_done: marked = printed + external. */
+export function isLineMarkingIncomplete(line: PackagingTaskLine): boolean {
+  if (!line.requires_honest_sign) {
+    return false
+  }
+  const done = line.qty_done
+  const marked = line.qty_marking_printed + (line.qty_marking_external ?? 0)
+  return done > 0 && marked < done
+}
+
+/** Progress toward qty_need_pack — for ЧЗ column display and row highlight. */
+export function isLineMarkingProgressIncomplete(line: PackagingTaskLine): boolean {
+  if (!line.requires_honest_sign) {
+    return false
+  }
+  const marked = line.qty_marking_printed + (line.qty_marking_external ?? 0)
+  return marked < line.qty_need_pack
+}
+
+export function lineRemaining(line: PackagingTaskLine): number {
+  return Math.max(0, line.qty_need_pack - line.qty_packed_in_task)
+}
