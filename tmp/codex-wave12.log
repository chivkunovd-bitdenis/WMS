+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/confirm-packed`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({}),
+  })
+}
+
+export function packPackagingLine(token: string, taskId: string, lineId: string, quantity: number) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/pack`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ quantity }),
+  })
+}
+
+export function scanPackagingTask(token: string, taskId: string, barcode: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/scan`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ barcode }),
+  })
+}
+
+export function undoPackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/undo-last`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+  })
+}
+
+export function fetchPrintedMarkingCodes(token: string, lineId: string) {
+  return fetch(apiUrl(`/operations/marking-codes/packaging-task-lines/${lineId}/printed-codes`), {
+    headers: jsonHeaders(token),
+  })
+}
+
+export function defectMarkingCode(
+  token: string,
+  codeId: string,
+  lineId: string,
+  reason: string | null,
+) {
+  return fetch(apiUrl(`/operations/marking-codes/codes/${codeId}/defect`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ packaging_task_line_id: lineId, reason }),
+  })
+}
+
+export function cancelPackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/cancel`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+  })
+}
+
+export function completePackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/complete`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ acknowledge_all_packed: false }),
+  })
+}
+
+export function fetchWarehouses(token: string) {
+  return fetch(apiUrl('/warehouses'), { headers: jsonHeaders(token) })
+}
+
+export function fetchWarehouseLocations(token: string, warehouseId: string) {
+  return fetch(apiUrl(`/warehouses/${warehouseId}/locations`), { headers: jsonHeaders(token) })
+}
+
+export function fetchInventoryBalances(token: string, locationId: string) {
+  return fetch(apiUrl(`/operations/inventory-balances?storage_location_id=${locationId}`), {
+    headers: jsonHeaders(token),
+  })
+}
+
+export function createPackagingTask(
+  token: string,
+  warehouseId: string,
+  lines: Array<{ product_id: string; storage_location_id: string; quantity: number }>,
+) {
+  return fetch(apiUrl('/operations/packaging-tasks'), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ warehouse_id: warehouseId, lines }),
+  })
+}
+
+export function fetchPackagingTasks(token: string, params: URLSearchParams) {
+  return fetch(apiUrl(`/operations/packaging-tasks?${params}`), { headers: authHeaders(token) })
+}
+
+export async function fetchPendingMarkingCount(token: string): Promise<number> {
+  return pendingMarkingLineCount(await fetchPendingMarking(token))
+}
+
+export function fetchPackagingTaskByUnload(token: string, unloadId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/by-unload/${unloadId}`), {
+    headers: authHeaders(token),
+  })
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingCalculations.ts b/frontend/src/screens/ff/packaging/PackagingCalculations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e6af0539dd74be3f27406046255f391708f63eac
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingCalculations.ts
@@ -0,0 +1,105 @@
+import type { PackagingTask, PackagingTaskEvent, PackagingTaskLine } from './PackagingTypes'
+
+export const MARKING_NOT_DONE_MESSAGE =
+  'Не хватает напечатанных КМ по заданию на упаковку.'
+
+export function statusLabel(status: string): string {
+  if (status === 'draft') return 'Черновик'
+  if (status === 'in_progress') return 'В работе'
+  if (status === 'done') return 'Выполнено'
+  if (status === 'cancelled') return 'Отменено'
+  return status
+}
+
+export function locationLabel(code?: string | null): string {
+  if (!code) return '—'
+  return code === '__SORTING__' ? 'Сортировка' : code
+}
+
+export function taskTotals(task: PackagingTask): { total: number; done: number; remaining: number } {
+  const total = task.lines.reduce((sum, line) => sum + line.qty_total, 0)
+  const done = task.lines.reduce((sum, line) => sum + line.qty_done, 0)
+  return { total, done, remaining: Math.max(0, total - done) }
+}
+
+export function taskSellerLabel(task: PackagingTask): string {
+  return task.seller_name ?? task.lines[0]?.seller_name ?? 'Селлер не указан'
+}
+
+export function taskPlaceLabel(task: PackagingTask, addressStorageEnabled = true): string {
+  const warehouse = task.warehouse_name ?? task.warehouse_code ?? 'Склад'
+  if (!addressStorageEnabled) return warehouse
+  const cells = Array.from(new Set(task.lines.map((line) => locationLabel(line.storage_location_code))))
+  return `${warehouse} / ${cells.slice(0, 2).join(', ')}${cells.length > 2 ? ` +${cells.length - 2}` : ''}`
+}
+
+export function taskProductSummary(task: PackagingTask): string {
+  const names = task.lines.map((line) => line.product_name || line.sku_code).slice(0, 2)
+  return `${names.join(', ')}${task.lines.length > 2 ? ` +${task.lines.length - 2}` : ''}`
+}
+
+export function parseStrictPositiveInteger(raw: string): number | null {
+  const value = raw.trim()
+  if (!/^[1-9]\d*$/.test(value)) {
+    return null
+  }
+  return Number(value)
+}
+
+export function sellerCountLabel(count: number): string {
+  const mod10 = count % 10
+  const mod100 = count % 100
+  if (mod10 === 1 && mod100 !== 11) {
+    return `${count} селлер`
+  }
+  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) {
+    return `${count} селлера`
+  }
+  return `${count} селлеров`
+}
+
+export function comparePackagingEventsAsc(a: PackagingTaskEvent, b: PackagingTaskEvent): number {
+  return a.event_sequence - b.event_sequence
+}
+
+/** События без количества. manual_pack и undo_last собираются ниже — им нужно число. */
+const PACKAGING_EVENT_LABELS: Record<string, string> = {
+  scan_pack: '+1 скан',
+  product_label_print: 'Печать этикетки товара',
+  prepacked_external: 'Пришло готовым (без печати)',
+  cancel: 'Задание отменено',
+  complete: 'Задание выполнено',
+}
+
+export function packagingEventLabel(action: string, quantity: number): string {
+  if (action === 'manual_pack') {
+    return `+${quantity} вручную`
+  }
+  if (action === 'undo_last') {
+    return `Отмена ${quantity} шт`
+  }
+  return PACKAGING_EVENT_LABELS[action] ?? action
+}
+
+/** Mirrors backend assert_packaging_line_marking_done: marked = printed + external. */
+export function isLineMarkingIncomplete(line: PackagingTaskLine): boolean {
+  if (!line.requires_honest_sign) {
+    return false
+  }
+  const done = line.qty_done
+  const marked = line.qty_marking_printed + (line.qty_marking_external ?? 0)
+  return done > 0 && marked < done
+}
+
+/** Progress toward qty_need_pack — for ЧЗ column display and row highlight. */
+export function isLineMarkingProgressIncomplete(line: PackagingTaskLine): boolean {
+  if (!line.requires_honest_sign) {
+    return false
+  }
+  const marked = line.qty_marking_printed + (line.qty_marking_external ?? 0)
+  return marked < line.qty_need_pack
+}
+
+export function lineRemaining(line: PackagingTaskLine): number {
+  return Math.max(0, line.qty_need_pack - line.qty_packed_in_task)
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingScanner.tsx b/frontend/src/screens/ff/packaging/PackagingScanner.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2a524d7767f4d395f60266483c48806941572207
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingScanner.tsx
@@ -0,0 +1,92 @@
+import type { RefObject } from 'react'
+import { UndoOutlined } from '@mui/icons-material'
+import { Alert, Button as LegacyButton, Paper, Stack, TextField, Typography } from '@mui/material'
+
+type Props = {
+  scannerRef: RefObject<HTMLInputElement | null>
+  scannerValue: string
+  scannerFeedback: string | null
+  busy: boolean
+  canUndo: boolean
+  isMpUnloadTask: boolean
+  onScannerValueChange: (value: string) => void
+  onSubmit: () => void
+  onUndo: () => void
+}
+
+export function PackagingScanner({
+  scannerRef,
+  scannerValue,
+  scannerFeedback,
+  busy,
+  canUndo,
+  isMpUnloadTask,
+  onScannerValueChange,
+  onSubmit,
+  onUndo,
+}: Props) {
+  return (
+    <Paper variant="outlined" sx={{ p: 2 }} data-testid="ff-packaging-scanner-panel">
+      <Stack direction={{ xs: 'column', md: 'row' }} spacing={1.5} sx={{ alignItems: { xs: 'stretch', md: 'flex-start' } }}>
+        <TextField
+          inputRef={scannerRef}
+          label={isMpUnloadTask ? 'Сканируйте ШК товара для поиска строки' : 'Сканируйте ШК товара'}
+          value={scannerValue}
+          onChange={(event) => onScannerValueChange(event.target.value)}
+          onKeyDown={(event) => {
+            if (event.key === 'Enter') {
+              event.preventDefault()
+              onSubmit()
+            }
+          }}
+          disabled={busy}
+          size="small"
+          fullWidth
+          data-testid="ff-packaging-scanner-field"
+          slotProps={{
+            htmlInput: {
+              'data-testid': 'ff-packaging-scanner-input',
+            },
+          }}
+        />
+        <LegacyButton
+          variant="contained"
+          disabled={busy}
+          onClick={onSubmit}
+          data-testid="ff-packaging-scan-submit"
+          sx={{ minWidth: isMpUnloadTask ? 140 : 120 }}
+        >
+          {isMpUnloadTask ? 'Найти строку' : '+1'}
+        </LegacyButton>
+        {isMpUnloadTask ? null : (
+          <LegacyButton
+            variant="outlined"
+            color="inherit"
+            startIcon={<UndoOutlined fontSize="small" />}
+            disabled={busy || !canUndo}
+            onClick={onUndo}
+            data-testid="ff-packaging-undo-last"
+            sx={{ minWidth: 190 }}
+          >
+            Отменить последнее
+          </LegacyButton>
+        )}
+      </Stack>
+      <Typography
+        variant="caption"
+        color="text.secondary"
+        sx={{ display: 'block', mt: 1 }}
+        data-testid="ff-packaging-scan-status"
+      >
+        {isMpUnloadTask
+          ? 'Сканер активен — пикните ШК товара или короба (WHB-…).'
+          : 'Сканер активен — пикните ШК товара.'}
+      </Typography>
+      {scannerFeedback ? (
+        <Alert severity="success" sx={{ mt: 1.5 }} data-testid="ff-packaging-scan-feedback">
+          {scannerFeedback}
+        </Alert>
+      ) : null}
+    </Paper>
+  )
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingTaskDialogs.tsx b/frontend/src/screens/ff/packaging/PackagingTaskDialogs.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0449c605177838bd05e457a2a46774cf99bd27dd
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingTaskDialogs.tsx
@@ -0,0 +1,226 @@
+import {
+  Alert,
+  Button as LegacyButton,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  FormControl,
+  InputLabel,
+  Menu,
+  MenuItem,
+  Select,
+  Stack,
+  TextField,
+  Typography,
+} from '@mui/material'
+import type { PackagingTaskEvent, PackagingTaskLine, PrintedMarkingCode } from './PackagingTypes'
+
+type UndoConfirmDialogProps = {
+  event: PackagingTaskEvent | null
+  busy: boolean
+  onCancel: () => void
+  onConfirm: (event: PackagingTaskEvent) => void
+}
+
+export function PackagingUndoConfirmDialog({ event, busy, onCancel, onConfirm }: UndoConfirmDialogProps) {
+  return (
+    <Dialog
+      open={Boolean(event)}
+      onClose={busy ? undefined : onCancel}
+      maxWidth="xs"
+      fullWidth
+      data-testid="ff-packaging-undo-confirm-dialog"
+    >
+      <DialogTitle>Отменить ручное добавление?</DialogTitle>
+      <DialogContent>
+        <Typography variant="body2" data-testid="ff-packaging-undo-confirm-message">
+          Из задания будет снято {event?.quantity ?? 0} шт
+          {event?.product_name ? ` · ${event.product_name}` : ''}.
+          Количество вернётся в «Осталось». Подтвердите только если оператор добавил
+          количество ошибочно.
+        </Typography>
+      </DialogContent>
+      <DialogActions>
+        <LegacyButton onClick={onCancel} disabled={busy} data-testid="ff-packaging-undo-confirm-cancel">
+          Не отменять
+        </LegacyButton>
+        <LegacyButton
+          color="error"
+          variant="contained"
+          disabled={busy}
+          onClick={() => event && onConfirm(event)}
+          data-testid="ff-packaging-undo-confirm-submit"
+        >
+          Отменить +{event?.quantity ?? 0}
+        </LegacyButton>
+      </DialogActions>
+    </Dialog>
+  )
+}
+
+type InstructionsDialogProps = {
+  line: PackagingTaskLine | null
+  onClose: () => void
+}
+
+export function PackagingInstructionsDialog({ line, onClose }: InstructionsDialogProps) {
+  return (
+    <Dialog
+      open={Boolean(line)}
+      onClose={onClose}
+      maxWidth="xs"
+      fullWidth
+      data-testid="ff-packaging-instructions-dialog"
+    >
+      <DialogTitle>Задание на упаковку</DialogTitle>
+      <DialogContent>
+        {line ? (
+          <Typography variant="caption" color="text.secondary" sx={{ display: 'block', mb: 1 }}>
+            {line.product_name} · SKU {line.sku_code}
+          </Typography>
+        ) : null}
+        <Typography
+          variant="body2"
+          sx={{ whiteSpace: 'pre-wrap' }}
+          data-testid="ff-packaging-instructions-dialog-text"
+        >
+          {line?.packaging_instructions?.trim() || 'ТЗ не задано'}
+        </Typography>
+      </DialogContent>
+      <DialogActions>
+        <LegacyButton onClick={onClose} data-testid="ff-packaging-instructions-dialog-close">
+          Закрыть
+        </LegacyButton>
+      </DialogActions>
+    </Dialog>
+  )
+}
+
+type LineMenuProps = {
+  anchor: HTMLElement | null
+  line: PackagingTaskLine | null
+  busy: boolean
+  isMpUnloadTask: boolean
+  onClose: () => void
+  onReprint: (line: PackagingTaskLine) => void
+  onDefect: (lineId: string) => void
+}
+
+export function PackagingLineMenu({
+  anchor,
+  line,
+  busy,
+  isMpUnloadTask,
+  onClose,
+  onReprint,
+  onDefect,
+}: LineMenuProps) {
+  return (
+    <Menu anchorEl={anchor} open={Boolean(anchor)} onClose={onClose} data-testid="ff-packaging-line-menu">
+      {line && line.requires_honest_sign && !isMpUnloadTask && line.qty_marking_printed > 0 ? (
+        <MenuItem
+          disabled={busy}
+          onClick={() => {
+            onClose()
+            onReprint(line)
+          }}
+          data-testid="ff-packaging-reprint-marking"
+        >
+          Повтор
+        </MenuItem>
+      ) : null}
+      {line && line.requires_honest_sign && line.qty_marking_printed > 0 ? (
+        <MenuItem
+          disabled={busy}
+          onClick={() => {
+            onClose()
+            onDefect(line.id)
+          }}
+          data-testid="ff-packaging-defect-marking"
+        >
+          Брак
+        </MenuItem>
+      ) : null}
+    </Menu>
+  )
+}
+
+type DefectDialogProps = {
+  open: boolean
+  busy: boolean
+  error: string | null
+  codes: PrintedMarkingCode[]
+  selectedCodeId: string
+  reason: string
+  onClose: () => void
+  onSelectedCodeIdChange: (value: string) => void
+  onReasonChange: (value: string) => void
+  onConfirm: () => void
+}
+
+export function PackagingDefectDialog({
+  open,
+  busy,
+  error,
+  codes,
+  selectedCodeId,
+  reason,
+  onClose,
+  onSelectedCodeIdChange,
+  onReasonChange,
+  onConfirm,
+}: DefectDialogProps) {
+  return (
+    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth data-testid="ff-packaging-defect-dialog">
+      <DialogTitle>Отметить брак КМ</DialogTitle>
+      <DialogContent>
+        <Stack spacing={2} sx={{ pt: 1 }}>
+          {error ? <Alert severity="error" data-testid="ff-packaging-defect-dialog-error">{error}</Alert> : null}
+          <FormControl fullWidth disabled={busy || codes.length < 1}>
+            <InputLabel id="ff-packaging-defect-code-label">КМ</InputLabel>
+            <Select
+              labelId="ff-packaging-defect-code-label"
+              label="КМ"
+              value={selectedCodeId}
+              onChange={(event) => onSelectedCodeIdChange(event.target.value)}
+              data-testid="ff-packaging-defect-code-select"
+            >
+              {codes.map((code) => (
+                <MenuItem
+                  key={code.id}
+                  value={code.id}
+                  sx={{ fontFamily: 'ui-monospace, SFMono-Regular, Menlo, monospace' }}
+                >
+                  {code.cis_code}
+                </MenuItem>
+              ))}
+            </Select>
+          </FormControl>
+          <TextField
+            label="Причина брака"
+            value={reason}
+            onChange={(event) => onReasonChange(event.target.value)}
+            disabled={busy}
+            multiline
+            minRows={2}
+            slotProps={{ htmlInput: { maxLength: 512 } }}
+            data-testid="ff-packaging-defect-reason"
+          />
+        </Stack>
+      </DialogContent>
+      <DialogActions>
+        <LegacyButton onClick={onClose} disabled={busy}>Отмена</LegacyButton>
+        <LegacyButton
+          variant="contained"
+          color="warning"
+          disabled={busy || !selectedCodeId}
+          onClick={onConfirm}
+          data-testid="ff-packaging-defect-confirm"
+        >
+          Подтвердить брак
+        </LegacyButton>
+      </DialogActions>
+    </Dialog>
+  )
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingTypes.ts b/frontend/src/screens/ff/packaging/PackagingTypes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c2d44d9d84825dd21cf6f47ba9b51038183d25f7
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingTypes.ts
@@ -0,0 +1,127 @@
+import type { ReactNode } from 'react'
+
+export type PackagingTaskLine = {
+  id: string
+  product_id: string
+  seller_id?: string | null
+  seller_name?: string | null
+  sku_code: string
+  product_name: string
+  storage_location_id: string
+  storage_location_code: string
+  packaging_instructions: string | null
+  requires_honest_sign: boolean
+  qty_total: number
+  qty_suggested_packed: number
+  qty_confirmed_packed: number
+  qty_need_pack: number
+  qty_packed_in_task: number
+  qty_done: number
+  qty_marking_printed: number
+  qty_marking_external: number
+  qty_product_label_printed: number
+  marking_available_count: number
+  is_complete: boolean
+}
+
+export type PackagingTaskEvent = {
+  id: string
+  event_sequence: number
+  action: string
+  line_id: string | null
+  product_id: string | null
+  product_name: string | null
+  storage_location_id: string | null
+  storage_location_code: string | null
+  quantity: number
+  note: string | null
+  created_by_user_id: string | null
+  created_by_user_email: string | null
+  created_at: string
+  reversed_at: string | null
+}
+
+export type PackagingTask = {
+  id: string
+  document_number: string | null
+  display_number?: string | null
+  public_number?: string | null
+  human_number?: string | null
+  warehouse_id: string
+  warehouse_name?: string | null
+  warehouse_code?: string | null
+  seller_id?: string | null
+  seller_name?: string | null
+  status: string
+  marketplace_unload_request_id: string | null
+  inbound_intake_request_id: string | null
+  is_complete: boolean
+  pick_resync_warning?: boolean
+  created_at?: string | null
+  updated_at?: string | null
+  completed_at?: string | null
+  completed_by_user_id?: string | null
+  lines: PackagingTaskLine[]
+  events?: PackagingTaskEvent[]
+}
+
+export type PackProgress = {
+  packaging_task: PackagingTask
+  fulfilled_order: {
+    id: string
+    wb_order_id: number
+    pack_status: string
+    marking_status: string | null
+    sticker_status: string
+  } | null
+}
+
+export type PrintedMarkingCode = {
+  id: string
+  cis_code: string
+  cis_masked: string
+  status: string
+}
+
+export type PackagingTaskPanelProps = {
+  token: string
+  task: PackagingTask
+  addressStorageEnabled?: boolean
+  unloadLabel?: string | null
+  /** Hide status chip + «Упаковка» + document numbers when embedded in MP unload modal. */
+  hideDocumentHeader?: boolean
+  /** Compact operator cards for narrow embedded workspaces such as FBS. */
+  compactLayout?: boolean
+  /** Keep the standard table but collapse duplicate quantity columns for operator workspaces. */
+  simplifiedQuantities?: boolean
+  /** Expose the standard product print action even when Honest Sign is not required. */
+  alwaysShowPrintAction?: boolean
+  /** Add workflow-specific actions to the existing product row without creating a second table. */
+  renderLineActions?: (line: PackagingTaskLine) => ReactNode
+  /** Separate printing stage: reuses the standard ЧЗ/ШК dialog without packing actions. */
+  printOnly?: boolean
+  /** Embedded packing stage can keep physical packing free of print controls. */
+  hidePrintActions?: boolean
+  /** Единое поле скана также принимает штрихкод готового короба (WHB-/INB-);
+      состоянием коробов владеет родитель, поэтому скан короба делегируется наверх. */
+  onBoxBarcodeScan?: (barcode: string) => void
+  onClose?: () => void
+  onUpdated: (task: PackagingTask) => void
+}
+
+export type WarehouseRow = { id: string; name: string; code: string }
+
+export type SortingBalanceRow = {
+  product_id: string
+  sku_code: string
+  product_name: string
+  seller_id?: string | null
+  seller_name?: string | null
+  packaging_instructions?: string | null
+  requires_honest_sign?: boolean
+  quantity_unpacked: number
+}
+
+export type LocationRow = { id: string; code: string; barcode: string }
+
+export type PackagingTaskStatusFilter = 'open' | 'done' | 'cancelled'

diff --git a/frontend/src/screens/ff/packaging/PackagingApi.ts b/frontend/src/screens/ff/packaging/PackagingApi.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f70d17327c3cca47267d62b2b1916aa2b3009809
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingApi.ts
@@ -0,0 +1,147 @@
+import { apiUrl } from '../../../api'
+import { fetchPendingMarking, pendingMarkingLineCount } from '../../../utils/pendingMarkingApi'
+import { readApiErrorMessage } from '../../../utils/readApiErrorMessage'
+
+const PACKAGING_API_MESSAGES_RU: Record<string, string> = {
+  unknown_barcode: 'ШК не найден в этом задании. Проверьте товар и выбранное задание.',
+  line_already_packed: 'По этому товару всё уже упаковано.',
+  undo_not_available: 'Нет действия, которое можно отменить.',
+  undo_not_supported: 'Это действие нельзя отменить.',
+}
+
+export async function readPackagingApiErrorMessage(res: Response): Promise<string> {
+  const message = await readApiErrorMessage(res)
+  return PACKAGING_API_MESSAGES_RU[message] ?? message
+}
+
+function authHeaders(token: string): Record<string, string> {
+  return { Authorization: `Bearer ${token}` }
+}
+
+function jsonHeaders(token: string): Record<string, string> {
+  return { ...authHeaders(token), 'Content-Type': 'application/json' }
+}
+
+export function fetchPackagingTask(token: string, taskId: string, includeJsonHeader = false) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}`), {
+    headers: includeJsonHeader ? jsonHeaders(token) : authHeaders(token),
+  })
+}
+
+export function markProductLabelPrinted(
+  token: string,
+  taskId: string,
+  lineId: string,
+  quantity: number,
+) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/product-label-printed`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ quantity }),
+  })
+}
+
+export function confirmPackagingLine(token: string, taskId: string, lineId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/confirm-packed`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({}),
+  })
+}
+
+export function packPackagingLine(token: string, taskId: string, lineId: string, quantity: number) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/pack`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ quantity }),
+  })
+}
+
+export function scanPackagingTask(token: string, taskId: string, barcode: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/scan`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ barcode }),
+  })
+}
+
+export function undoPackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/undo-last`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+  })
+}
+
+export function fetchPrintedMarkingCodes(token: string, lineId: string) {
+  return fetch(apiUrl(`/operations/marking-codes/packaging-task-lines/${lineId}/printed-codes`), {
+    headers: jsonHeaders(token),
+  })
+}
+
+export function defectMarkingCode(
+  token: string,
+  codeId: string,
+  lineId: string,
+  reason: string | null,
+) {
+  return fetch(apiUrl(`/operations/marking-codes/codes/${codeId}/defect`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ packaging_task_line_id: lineId, reason }),
+  })
+}
+
+export function cancelPackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/cancel`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+  })
+}
+
+export function completePackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/complete`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ acknowledge_all_packed: false }),
+  })
+}
+
+export function fetchWarehouses(token: string) {
+  return fetch(apiUrl('/warehouses'), { headers: jsonHeaders(token) })
+}
+
+export function fetchWarehouseLocations(token: string, warehouseId: string) {
+  return fetch(apiUrl(`/warehouses/${warehouseId}/locations`), { headers: jsonHeaders(token) })
+}
+
+export function fetchInventoryBalances(token: string, locationId: string) {
+  return fetch(apiUrl(`/operations/inventory-balances?storage_location_id=${locationId}`), {
+    headers: jsonHeaders(token),
+  })
+}
+
+export function createPackagingTask(
+  token: string,
+  warehouseId: string,
+  lines: Array<{ product_id: string; storage_location_id: string; quantity: number }>,
+) {
+  return fetch(apiUrl('/operations/packaging-tasks'), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ warehouse_id: warehouseId, lines }),
+  })
+}
+
+export function fetchPackagingTasks(token: string, params: URLSearchParams) {
+  return fetch(apiUrl(`/operations/packaging-tasks?${params}`), { headers: authHeaders(token) })
+}
+
+export async function fetchPendingMarkingCount(token: string): Promise<number> {
+  return pendingMarkingLineCount(await fetchPendingMarking(token))
+}
+
+export function fetchPackagingTaskByUnload(token: string, unloadId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/by-unload/${unloadId}`), {
+    headers: authHeaders(token),
+  })
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingCalculations.ts b/frontend/src/screens/ff/packaging/PackagingCalculations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e6af0539dd74be3f27406046255f391708f63eac
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingCalculations.ts
@@ -0,0 +1,105 @@
+import type { PackagingTask, PackagingTaskEvent, PackagingTaskLine } from './PackagingTypes'
+
+export const MARKING_NOT_DONE_MESSAGE =
+  'Не хватает напечатанных КМ по заданию на упаковку.'
+
+export function statusLabel(status: string): string {
+  if (status === 'draft') return 'Черновик'
+  if (status === 'in_progress') return 'В работе'
+  if (status === 'done') return 'Выполнено'
+  if (status === 'cancelled') return 'Отменено'
+  return status
+}
+
+export function locationLabel(code?: string | null): string {
+  if (!code) return '—'
+  return code === '__SORTING__' ? 'Сортировка' : code
+}
+
+export function taskTotals(task: PackagingTask): { total: number; done: number; remaining: number } {
+  const total = task.lines.reduce((sum, line) => sum + line.qty_total, 0)
+  const done = task.lines.reduce((sum, line) => sum + line.qty_done, 0)
+  return { total, done, remaining: Math.max(0, total - done) }
+}
+
+export function taskSellerLabel(task: PackagingTask): string {
+  return task.seller_name ?? task.lines[0]?.seller_name ?? 'Селлер не указан'
+}
+
+export function taskPlaceLabel(task: PackagingTask, addressStorageEnabled = true): string {
+  const warehouse = task.warehouse_name ?? task.warehouse_code ?? 'Склад'
+  if (!addressStorageEnabled) return warehouse
+  const cells = Array.from(new Set(task.lines.map((line) => locationLabel(line.storage_location_code))))
+  return `${warehouse} / ${cells.slice(0, 2).join(', ')}${cells.length > 2 ? ` +${cells.length - 2}` : ''}`
+}
+
+export function taskProductSummary(task: PackagingTask): string {
+  const names = task.lines.map((line) => line.product_name || line.sku_code).slice(0, 2)
+  return `${names.join(', ')}${task.lines.length > 2 ? ` +${task.lines.length - 2}` : ''}`
+}
+
+export function parseStrictPositiveInteger(raw: string): number | null {
+  const value = raw.trim()
+  if (!/^[1-9]\d*$/.test(value)) {
+    return null
+  }
+  return Number(value)
+}
+
+export function sellerCountLabel(count: number): string {
+  const mod10 = count % 10
+  const mod100 = count % 100
+  if (mod10 === 1 && mod100 !== 11) {
+    return `${count} селлер`
+  }
+  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) {
+    return `${count} селлера`
+  }
+  return `${count} селлеров`
+}
+
+export function comparePackagingEventsAsc(a: PackagingTaskEvent, b: PackagingTaskEvent): number {
+  return a.event_sequence - b.event_sequence
+}
+
+/** События без количества. manual_pack и undo_last собираются ниже — им нужно число. */
+const PACKAGING_EVENT_LABELS: Record<string, string> = {
+  scan_pack: '+1 скан',
+  product_label_print: 'Печать этикетки товара',
+  prepacked_external: 'Пришло готовым (без печати)',
+  cancel: 'Задание отменено',
+  complete: 'Задание выполнено',
+}
+
+export function packagingEventLabel(action: string, quantity: number): string {
+  if (action === 'manual_pack') {
+    return `+${quantity} вручную`
+  }
+  if (action === 'undo_last') {
+    return `Отмена ${quantity} шт`
+  }
+  return PACKAGING_EVENT_LABELS[action] ?? action
+}
+
+/** Mirrors backend assert_packaging_line_marking_done: marked = printed + external. */
+export function isLineMarkingIncomplete(line: PackagingTaskLine): boolean {
+  if (!line.requires_honest_sign) {
+    return false
+  }
+  const done = line.qty_done
+  const marked = line.qty_marking_printed + (line.qty_marking_external ?? 0)
+  return done > 0 && marked < done
+}
+
+/** Progress toward qty_need_pack — for ЧЗ column display and row highlight. */
+export function isLineMarkingProgressIncomplete(line: PackagingTaskLine): boolean {
+  if (!line.requires_honest_sign) {
+    return false
+  }
+  const marked = line.qty_marking_printed + (line.qty_marking_external ?? 0)
+  return marked < line.qty_need_pack
+}
+
+export function lineRemaining(line: PackagingTaskLine): number {
+  return Math.max(0, line.qty_need_pack - line.qty_packed_in_task)
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingScanner.tsx b/frontend/src/screens/ff/packaging/PackagingScanner.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2a524d7767f4d395f60266483c48806941572207
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingScanner.tsx
@@ -0,0 +1,92 @@
+import type { RefObject } from 'react'
+import { UndoOutlined } from '@mui/icons-material'
+import { Alert, Button as LegacyButton, Paper, Stack, TextField, Typography } from '@mui/material'
+
+type Props = {
+  scannerRef: RefObject<HTMLInputElement | null>
+  scannerValue: string
+  scannerFeedback: string | null
+  busy: boolean
+  canUndo: boolean
+  isMpUnloadTask: boolean
+  onScannerValueChange: (value: string) => void
+  onSubmit: () => void
+  onUndo: () => void
+}
+
+export function PackagingScanner({
+  scannerRef,
+  scannerValue,
+  scannerFeedback,
+  busy,
+  canUndo,
+  isMpUnloadTask,
+  onScannerValueChange,
+  onSubmit,
+  onUndo,
+}: Props) {
+  return (
+    <Paper variant="outlined" sx={{ p: 2 }} data-testid="ff-packaging-scanner-panel">
+      <Stack direction={{ xs: 'column', md: 'row' }} spacing={1.5} sx={{ alignItems: { xs: 'stretch', md: 'flex-start' } }}>
+        <TextField
+          inputRef={scannerRef}
+          label={isMpUnloadTask ? 'Сканируйте ШК товара для поиска строки' : 'Сканируйте ШК товара'}
+          value={scannerValue}
+          onChange={(event) => onScannerValueChange(event.target.value)}
+          onKeyDown={(event) => {
+            if (event.key === 'Enter') {
+              event.preventDefault()
+              onSubmit()
+            }
+          }}
+          disabled={busy}
+          size="small"
+          fullWidth
+          data-testid="ff-packaging-scanner-field"
+          slotProps={{
+            htmlInput: {
+              'data-testid': 'ff-packaging-scanner-input',
+            },
+          }}
+        />
+        <LegacyButton
+          variant="contained"
+          disabled={busy}
+          onClick={onSubmit}
+          data-testid="ff-packaging-scan-submit"
+          sx={{ minWidth: isMpUnloadTask ? 140 : 120 }}
+        >
+          {isMpUnloadTask ? 'Найти строку' : '+1'}
+        </LegacyButton>
+        {isMpUnloadTask ? null : (
+          <LegacyButton
+            variant="outlined"
+            color="inherit"
+            startIcon={<UndoOutlined fontSize="small" />}
+            disabled={busy || !canUndo}
+            onClick={onUndo}
+            data-testid="ff-packaging-undo-last"
+            sx={{ minWidth: 190 }}
+          >
+            Отменить последнее
+          </LegacyButton>
+        )}
+      </Stack>
+      <Typography
+        variant="caption"
+        color="text.secondary"
+        sx={{ display: 'block', mt: 1 }}
+        data-testid="ff-packaging-scan-status"
+      >
+        {isMpUnloadTask
+          ? 'Сканер активен — пикните ШК товара или короба (WHB-…).'
+          : 'Сканер активен — пикните ШК товара.'}
+      </Typography>
+      {scannerFeedback ? (
+        <Alert severity="success" sx={{ mt: 1.5 }} data-testid="ff-packaging-scan-feedback">
+          {scannerFeedback}
+        </Alert>
+      ) : null}
+    </Paper>
+  )
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingTaskDialogs.tsx b/frontend/src/screens/ff/packaging/PackagingTaskDialogs.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0449c605177838bd05e457a2a46774cf99bd27dd
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingTaskDialogs.tsx
@@ -0,0 +1,226 @@
+import {
+  Alert,
+  Button as LegacyButton,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  FormControl,
+  InputLabel,
+  Menu,
+  MenuItem,
+  Select,
+  Stack,
+  TextField,
+  Typography,
+} from '@mui/material'
+import type { PackagingTaskEvent, PackagingTaskLine, PrintedMarkingCode } from './PackagingTypes'
+
+type UndoConfirmDialogProps = {
+  event: PackagingTaskEvent | null
+  busy: boolean
+  onCancel: () => void
+  onConfirm: (event: PackagingTaskEvent) => void
+}
+
+export function PackagingUndoConfirmDialog({ event, busy, onCancel, onConfirm }: UndoConfirmDialogProps) {
+  return (
+    <Dialog
+      open={Boolean(event)}
+      onClose={busy ? undefined : onCancel}
+      maxWidth="xs"
+      fullWidth
+      data-testid="ff-packaging-undo-confirm-dialog"
+    >
+      <DialogTitle>Отменить ручное добавление?</DialogTitle>
+      <DialogContent>
+        <Typography variant="body2" data-testid="ff-packaging-undo-confirm-message">
+          Из задания будет снято {event?.quantity ?? 0} шт
+          {event?.product_name ? ` · ${event.product_name}` : ''}.
+          Количество вернётся в «Осталось». Подтвердите только если оператор добавил
+          количество ошибочно.
+        </Typography>
+      </DialogContent>
+      <DialogActions>
+        <LegacyButton onClick={onCancel} disabled={busy} data-testid="ff-packaging-undo-confirm-cancel">
+          Не отменять
+        </LegacyButton>
+        <LegacyButton
+          color="error"
+          variant="contained"
+          disabled={busy}
+          onClick={() => event && onConfirm(event)}
+          data-testid="ff-packaging-undo-confirm-submit"
+        >
+          Отменить +{event?.quantity ?? 0}
+        </LegacyButton>
+      </DialogActions>
+    </Dialog>
+  )
+}
+
+type InstructionsDialogProps = {
+  line: PackagingTaskLine | null
+  onClose: () => void
+}
+
+export function PackagingInstructionsDialog({ line, onClose }: InstructionsDialogProps) {
+  return (
+    <Dialog
+      open={Boolean(line)}
+      onClose={onClose}
+      maxWidth="xs"
+      fullWidth
+      data-testid="ff-packaging-instructions-dialog"
+    >
+      <DialogTitle>Задание на упаковку</DialogTitle>
+      <DialogContent>
+        {line ? (
+          <Typography variant="caption" color="text.secondary" sx={{ display: 'block', mb: 1 }}>
+            {line.product_name} · SKU {line.sku_code}
+          </Typography>
+        ) : null}
+        <Typography
+          variant="body2"
+          sx={{ whiteSpace: 'pre-wrap' }}
+          data-testid="ff-packaging-instructions-dialog-text"
+        >
+          {line?.packaging_instructions?.trim() || 'ТЗ не задано'}
+        </Typography>
+      </DialogContent>
+      <DialogActions>
+        <LegacyButton onClick={onClose} data-testid="ff-packaging-instructions-dialog-close">
+          Закрыть
+        </LegacyButton>
+      </DialogActions>
+    </Dialog>
+  )
+}
+
+type LineMenuProps = {
+  anchor: HTMLElement | null
+  line: PackagingTaskLine | null
+  busy: boolean
+  isMpUnloadTask: boolean
+  onClose: () => void
+  onReprint: (line: PackagingTaskLine) => void
+  onDefect: (lineId: string) => void
+}
+
+export function PackagingLineMenu({
+  anchor,
+  line,
+  busy,
+  isMpUnloadTask,
+  onClose,
+  onReprint,
+  onDefect,
+}: LineMenuProps) {
+  return (
+    <Menu anchorEl={anchor} open={Boolean(anchor)} onClose={onClose} data-testid="ff-packaging-line-menu">
+      {line && line.requires_honest_sign && !isMpUnloadTask && line.qty_marking_printed > 0 ? (
+        <MenuItem
+          disabled={busy}
+          onClick={() => {
+            onClose()
+            onReprint(line)
+          }}
+          data-testid="ff-packaging-reprint-marking"
+        >
+          Повтор
+        </MenuItem>
+      ) : null}
+      {line && line.requires_honest_sign && line.qty_marking_printed > 0 ? (
+        <MenuItem
+          disabled={busy}
+          onClick={() => {
+            onClose()
+            onDefect(line.id)
+          }}
+          data-testid="ff-packaging-defect-marking"
+        >
+          Брак
+        </MenuItem>
+      ) : null}
+    </Menu>
+  )
+}
+
+type DefectDialogProps = {
+  open: boolean
+  busy: boolean
+  error: string | null
+  codes: PrintedMarkingCode[]
+  selectedCodeId: string
+  reason: string
+  onClose: () => void
+  onSelectedCodeIdChange: (value: string) => void
+  onReasonChange: (value: string) => void
+  onConfirm: () => void
+}
+
+export function PackagingDefectDialog({
+  open,
+  busy,
+  error,
+  codes,
+  selectedCodeId,
+  reason,
+  onClose,
+  onSelectedCodeIdChange,
+  onReasonChange,
+  onConfirm,
+}: DefectDialogProps) {
+  return (
+    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth data-testid="ff-packaging-defect-dialog">
+      <DialogTitle>Отметить брак КМ</DialogTitle>
+      <DialogContent>
+        <Stack spacing={2} sx={{ pt: 1 }}>
+          {error ? <Alert severity="error" data-testid="ff-packaging-defect-dialog-error">{error}</Alert> : null}
+          <FormControl fullWidth disabled={busy || codes.length < 1}>
+            <InputLabel id="ff-packaging-defect-code-label">КМ</InputLabel>
+            <Select
+              labelId="ff-packaging-defect-code-label"
+              label="КМ"
+              value={selectedCodeId}
+              onChange={(event) => onSelectedCodeIdChange(event.target.value)}
+              data-testid="ff-packaging-defect-code-select"
+            >
+              {codes.map((code) => (
+                <MenuItem
+                  key={code.id}
+                  value={code.id}
+                  sx={{ fontFamily: 'ui-monospace, SFMono-Regular, Menlo, monospace' }}
+                >
+                  {code.cis_code}
+                </MenuItem>
+              ))}
+            </Select>
+          </FormControl>
+          <TextField
+            label="Причина брака"
+            value={reason}
+            onChange={(event) => onReasonChange(event.target.value)}
+            disabled={busy}
+            multiline
+            minRows={2}
+            slotProps={{ htmlInput: { maxLength: 512 } }}
+            data-testid="ff-packaging-defect-reason"
+          />
+        </Stack>
+      </DialogContent>
+      <DialogActions>
+        <LegacyButton onClick={onClose} disabled={busy}>Отмена</LegacyButton>
+        <LegacyButton
+          variant="contained"
+          color="warning"
+          disabled={busy || !selectedCodeId}
+          onClick={onConfirm}
+          data-testid="ff-packaging-defect-confirm"
+        >
+          Подтвердить брак
+        </LegacyButton>
+      </DialogActions>
+    </Dialog>
+  )
+}
diff --git a/frontend/src/screens/ff/packaging/PackagingTypes.ts b/frontend/src/screens/ff/packaging/PackagingTypes.ts
