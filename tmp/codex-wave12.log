index 0000000000000000000000000000000000000000..f70d17327c3cca47267d62b2b1916aa2b3009809
--- /dev/null
+++ b/frontend/src/screens/ff/packaging/PackagingApi.ts
@@ -0,0 +1,147 @@
+import { apiUrl } from '../../../api'
+import { fetchPendingMarking, pendingMarkingLineCount } from '../../../utils/pendingMarkingApi'
+import { readApiErrorMessage } from '../../../utils/readApiErrorMessage'
+
+const PACKAGING_API_MESSAGES_RU: Record<string, string> = {
+  unknown_barcode: 'ШК не найден в этом задании. Проверьте товар и выбранное задание.',
+  line_already_packed: 'По этому товару всё уже упаковано.',
+  undo_not_available: 'Нет действия, которое можно отменить.',
+  undo_not_supported: 'Это действие нельзя отменить.',
+}
+
+export async function readPackagingApiErrorMessage(res: Response): Promise<string> {
+  const message = await readApiErrorMessage(res)
+  return PACKAGING_API_MESSAGES_RU[message] ?? message
+}
+
+function authHeaders(token: string): Record<string, string> {
+  return { Authorization: `Bearer ${token}` }
+}
+
+function jsonHeaders(token: string): Record<string, string> {
+  return { ...authHeaders(token), 'Content-Type': 'application/json' }
+}
+
+export function fetchPackagingTask(token: string, taskId: string, includeJsonHeader = false) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}`), {
+    headers: includeJsonHeader ? jsonHeaders(token) : authHeaders(token),
+  })
+}
+
+export function markProductLabelPrinted(
+  token: string,
+  taskId: string,
+  lineId: string,
+  quantity: number,
+) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/product-label-printed`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ quantity }),
+  })
+}
+
+export function confirmPackagingLine(token: string, taskId: string, lineId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/confirm-packed`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({}),
+  })
+}
+
+export function packPackagingLine(token: string, taskId: string, lineId: string, quantity: number) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/lines/${lineId}/pack`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ quantity }),
+  })
+}
+
+export function scanPackagingTask(token: string, taskId: string, barcode: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/scan`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ barcode }),
+  })
+}
+
+export function undoPackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/undo-last`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+  })
+}
+
+export function fetchPrintedMarkingCodes(token: string, lineId: string) {
+  return fetch(apiUrl(`/operations/marking-codes/packaging-task-lines/${lineId}/printed-codes`), {
+    headers: jsonHeaders(token),
+  })
+}
+
+export function defectMarkingCode(
+  token: string,
+  codeId: string,
+  lineId: string,
+  reason: string | null,
+) {
+  return fetch(apiUrl(`/operations/marking-codes/codes/${codeId}/defect`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ packaging_task_line_id: lineId, reason }),
+  })
+}
+
+export function cancelPackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/cancel`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+  })
+}
+
+export function completePackagingTask(token: string, taskId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/${taskId}/complete`), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ acknowledge_all_packed: false }),
+  })
+}
+
+export function fetchWarehouses(token: string) {
+  return fetch(apiUrl('/warehouses'), { headers: jsonHeaders(token) })
+}
+
+export function fetchWarehouseLocations(token: string, warehouseId: string) {
+  return fetch(apiUrl(`/warehouses/${warehouseId}/locations`), { headers: jsonHeaders(token) })
+}
+
+export function fetchInventoryBalances(token: string, locationId: string) {
+  return fetch(apiUrl(`/operations/inventory-balances?storage_location_id=${locationId}`), {
+    headers: jsonHeaders(token),
+  })
+}
+
+export function createPackagingTask(
+  token: string,
+  warehouseId: string,
+  lines: Array<{ product_id: string; storage_location_id: string; quantity: number }>,
+) {
+  return fetch(apiUrl('/operations/packaging-tasks'), {
+    method: 'POST',
+    headers: jsonHeaders(token),
+    body: JSON.stringify({ warehouse_id: warehouseId, lines }),
+  })
+}
+
+export function fetchPackagingTasks(token: string, params: URLSearchParams) {
+  return fetch(apiUrl(`/operations/packaging-tasks?${params}`), { headers: authHeaders(token) })
+}
+
+export async function fetchPendingMarkingCount(token: string): Promise<number> {
+  return pendingMarkingLineCount(await fetchPendingMarking(token))
+}
+
+export function fetchPackagingTaskByUnload(token: string, unloadId: string) {
+  return fetch(apiUrl(`/operations/packaging-tasks/by-unload/${unloadId}`), {
+    headers: authHeaders(token),
+  })
+}
