            InboundIntakeBox.tenant_id == tenant_id,
            InboundIntakeBox.request_id == request_id,
        )
        .order_by(InboundIntakeBox.box_number.asc())
    )
    res = await session.execute(stmt)
    return list(res.scalars().all())


