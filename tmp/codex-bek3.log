+async def create_sorting_object(
+    session: AsyncSession,
+    tenant_id: uuid.UUID,
+    warehouse_id: uuid.UUID,
+    *,
+    kind: Literal["pallet", "box", "cargo_place"],
+) -> dict[str, str | None]:
