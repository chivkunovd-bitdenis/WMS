+        code=f"B-{suffix[-6:]}",
+    )
+    sku = f"SKU-OPTIONS-{suffix}"
+    barcode = f"BAR-OPTIONS-{suffix[-8:]}"
+    product_id = await _create_product(
+        async_client, headers, seller_id, sku=sku, barcode=barcode
+    )
+    supply_id, _order_ids, _location_code = await _seed_pick_supply(
+        async_client,
+        headers,
+        tenant_id,
+        seller_id,
+        warehouse_id,
