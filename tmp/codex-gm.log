+    assert updated.json()["lines"][0]["id"] == created_line["id"]
+    assert updated.json()["lines"][0]["quantity"] == 7
+
+    scanned = await async_client.post(
+        f"{BASE}/{request_id}/cargo-places/{place_id}/scan",
