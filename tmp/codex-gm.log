        .where(InboundIntakeBox.id == box_id)
        .options(
            selectinload(InboundIntakeBox.lines).selectinload(InboundIntakeBoxLine.product),
        )
    )
    res = await session.execute(stmt)
    box = res.scalar_one()
    return box
