+    foreign_product_id, foreign_sku = await _create_product(
+        async_client, headers, seller_id, "not-on-request"
+    )
+
+    quantity = await async_client.put(
+        f"{BASE}/{request_id}/cargo-places/{place_id}/lines/{foreign_product_id}",
+        headers=headers,
+        json={"quantity": 1},
