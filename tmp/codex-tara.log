+    """Keep one inbound document's containers and their active pallet ancestors.
+
+    The unfiltered warehouse-map tree intentionally mixes operational containers.
+    Under a document filter, product rows on a pallet itself and every unrelated
+    child (including WarehouseBox) must disappear; a pallet stays only as the
+    ancestor of one of the document's selected boxes or cargo places.
+    """
+
+    def visit(node: dict[str, Any], *, include_product: bool) -> dict[str, Any] | None:
