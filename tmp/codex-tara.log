+def _filter_sorting_tree_for_inbound_request(
+    nodes: list[dict[str, Any]],
+    *,
+    selected_box_ids: set[str],
+    selected_cargo_place_ids: set[str],
+) -> list[dict[str, Any]]:
+    """Keep one inbound document's containers and their active pallet ancestors.
+
+    The unfiltered warehouse-map tree intentionally mixes operational containers.
+    Under a document filter, product rows on a pallet itself and every unrelated
+    child (including WarehouseBox) must disappear; a pallet stays only as the
+    ancestor of one of the document's selected boxes or cargo places.
+    """
+
+    def visit(node: dict[str, Any], *, include_product: bool) -> dict[str, Any] | None:
+        kind = node["kind"]
+        if kind == "product":
+            return dict(node) if include_product else None
+
+        selected = (kind == "box" and node["id"] in selected_box_ids) or (
+            kind == "cargo_place" and node["id"] in selected_cargo_place_ids
+        )
+        children = [
+            filtered
+            for child in node["children"]
+            if (
+                filtered := visit(child, include_product=selected)
+            )
+            is not None
+        ]
+        if not selected and not children:
+            return None
+        return {**node, "children": children}
+
+    return [
+        filtered
+        for node in nodes
+        if (filtered := visit(node, include_product=False)) is not None
+    ]
