+def _allocation_id(
+    supply_id: uuid.UUID,
+    product_id: uuid.UUID,
+    storage_location_id: uuid.UUID,
+) -> uuid.UUID:
+    """Stable adapter id for the shipment-compatible allocation response."""
+    return uuid.uuid5(
+        uuid.NAMESPACE_URL,
+        f"wms:fbs-pick:{supply_id}:{product_id}:{storage_location_id}",
+    )
+
