+        uuid.NAMESPACE_URL,
+        f"wms:fbs-pick:{supply_id}:{product_id}:{storage_location_id}",
+    )
+
+
+def _derived_idempotency_key(
+    operation_key: str,
+    *,
+    action: str,
+    order_id: uuid.UUID,
+    ordinal: int,
+) -> str:
+    return str(
+        uuid.uuid5(
+            uuid.NAMESPACE_URL,
+            f"wms:fbs-pick:{operation_key}:{action}:{order_id}:{ordinal}",
+        )
+    )
