    session: AsyncSession,
    *,
    tenant_id: uuid.UUID,
    warehouse_id: uuid.UUID,
    actor_user_id: uuid.UUID,
    kind: ObjectKind,
    object_id: uuid.UUID,
    to_kind: DestinationKind,
    to_id: uuid.UUID | None,
    quantity: int,
) -> dict[str, Any]:
