    db_session.add_all(
        [
            MarketplaceAccount(
                tenant_id=tenant.id,
                seller_id=seller.id,
                marketplace="ozon",
                account_slot="primary",
                external_account_id="client-id",
                secret_encrypted=encrypt_secret("api-key"),
