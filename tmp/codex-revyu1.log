+async def test_parallel_pallet_creation_reserves_distinct_codes(
+    async_client: AsyncClient,
+) -> None:
+    # TC-NEW-PALLET-CONCURRENT-CODE-001
+    # Дано один склад. Когда две транзакции одновременно создают палеты, тогда
