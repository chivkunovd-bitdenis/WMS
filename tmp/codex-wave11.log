    16	// Одна таблица на весь экран. Вложенность видна отступом, где стоит объект —
    17	// колонкой, а не второй таблицей: две таблицы с двумя шапками читаются как два
    18	// разных отчёта.
    19	//
    20	// Цвета здесь намеренно почти нет. Это складской инструмент: значок отличает
    21	// палету от короба формой, а не цветом, и единственное, что имеет право быть
    22	// заметным, — то, что требует действия.
    23	
    24	const INDENT_STEP = 20
    25	const INDENT_STEP_COMPACT = 14
    26	const ROW_HEIGHT = 30
    27	// Направляющая вложенности — единственная линия, которую мы рисуем сами.
    28	// Берём цвет разделителя темы, чтобы она была ровно такой же силы, как границы
    29	// строк, и не читалась как ещё один смысл.
    30	const GUIDE = 'rgba(15, 23, 42, 0.11)'
    31	
    32	/**
    33	 * Товар внутри закрытой тары нельзя переложить одним движением — сначала его
    34	 * надо вынуть. Это не придирка интерфейса, а порядок работы руками: короб и
    35	 * грузоместо закрыты, и «переложить из закрытого короба сразу на палету» на
    36	 * складе не происходит. Поэтому у такой строки нет ни плюса, ни возможности
    37	 * утащить её мышкой — доступно только «вынуть».
    38	 *
    39	 * С палеты брать напрямую можно: там вещи лежат открыто, ничего не вскрывают.
    40	 */
    41	function insideClosed(row: ObjectRow, objects: WarehouseObject[]): boolean {
    42	  const holder = row.kind === 'object' ? row.object.holder : row.line.holder
    43	  if (row.kind !== 'goods' || !holder || !holder.startsWith('obj:')) return false
    44	  const host = objects.find((one) => objRef(one.id) === holder)
    45	  return host?.kind === 'box' || host?.kind === 'cargo_place'
    46	}
