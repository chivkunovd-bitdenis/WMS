   349	def _http_error(exc: service.InventoryCountError) -> HTTPException:
   350	    if exc.code in {
   351	        "not_found",
   352	        "line_not_found",
   353	        "seller_not_found",
   354	        "warehouse_not_found",
   355	        "object_not_found",
   356	    }:
   357	        return HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=exc.code)
   358	    if exc.code in {
   359	        "not_editable",
   360	        "already_posted",
   361	        "not_cancellable",
   362	        "empty_count",
   363	        "balance_changed_during_post",
   364	    }:
   365	        return HTTPException(status_code=status.HTTP_409_CONFLICT, detail=exc.code)
   366	    return HTTPException(status_code=status.HTTP_422_UNPROCESSABLE_CONTENT, detail=exc.code)
