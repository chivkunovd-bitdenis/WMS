   646	async def _place_container(
   647	    session: AsyncSession,
   648	    tenant_id: uuid.UUID,
   649	    warehouse_id: uuid.UUID,
   650	    kind: ContainerKind,
   651	    container_id: uuid.UUID,
   652	    to_kind: DestinationKind,
   653	    to_id: uuid.UUID | None,
   654	    destination_location_id: uuid.UUID,
   655	) -> None:
   656	    if kind == "pallet":
   657	        if to_kind not in {"cell", "unassigned", "sorting"}:
   658	            raise WarehouseMapError("invalid_container_destination")
   659	        pallet = await session.get(Pallet, container_id)
   660	        if (
   661	            pallet is None
   662	            or pallet.tenant_id != tenant_id
   663	            or pallet.warehouse_id != warehouse_id
   664	            or pallet.disbanded_at is not None
   665	        ):
   666	            raise WarehouseMapError("object_not_found")
   667	        pallet.storage_location_id = destination_location_id if to_kind == "cell" else None
   668	        return
   669	    if to_kind not in {"cell", "unassigned", "sorting", "pallet"}:
   670	        raise WarehouseMapError("invalid_container_destination")
   671	    pallet_id = to_id if to_kind == "pallet" else None
   672	    if pallet_id == container_id:
   673	        raise WarehouseMapError("container_cycle")
   674	    if kind == "box":
   675	        warehouse_box = await session.get(WarehouseBox, container_id)
   676	        if (
   677	            warehouse_box is not None
   678	            and warehouse_box.tenant_id == tenant_id
   679	            and warehouse_box.warehouse_id == warehouse_id
   680	        ):
   681	            warehouse_box.pallet_id = pallet_id
   682	            warehouse_box.storage_location_id = (
   683	                destination_location_id if to_kind == "cell" else None
   684	            )
   685	            return
   686	        inbound = await session.scalar(
   687	            select(InboundIntakeBox)
   688	            .join(InboundIntakeRequest)
   689	            .where(
   690	                InboundIntakeBox.id == container_id,
   691	                InboundIntakeBox.tenant_id == tenant_id,
   692	                InboundIntakeRequest.warehouse_id == warehouse_id,
   693	            )
   694	        )
   695	        if inbound is None:
   696	            raise WarehouseMapError("object_not_found")
   697	        inbound.pallet_id = pallet_id
   698	        return
   699	    cargo = await session.scalar(
   700	        select(InboundIntakeCargoPlace)
   701	        .join(InboundIntakeRequest)
   702	        .where(
   703	            InboundIntakeCargoPlace.id == container_id,
   704	            InboundIntakeCargoPlace.tenant_id == tenant_id,
   705	            InboundIntakeRequest.warehouse_id == warehouse_id,
   706	        )
   707	    )
   708	    if cargo is None:
   709	        raise WarehouseMapError("object_not_found")
   710	    cargo.pallet_id = pallet_id
