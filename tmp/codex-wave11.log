   238	def _map_error(exc: WarehouseMapError) -> HTTPException:
   239	    if exc.code in {
   240	        "warehouse_not_found",
   241	        "object_not_found",
   242	        "destination_not_found",
   243	        "cell_not_found",
   244	        "pallet_not_found",
   245	    }:
   246	        return HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=exc.code)
   247	    if exc.code in {
   248	        "address_storage_disabled",
   249	        "container_cycle",
   250	        "invalid_container_destination",
   251	        "insufficient_stock",
   252	        "pallet_disbanded",
   253	    }:
   254	        return HTTPException(status_code=status.HTTP_409_CONFLICT, detail=exc.code)
   255	    return HTTPException(status_code=status.HTTP_422_UNPROCESSABLE_ENTITY, detail=exc.code)
