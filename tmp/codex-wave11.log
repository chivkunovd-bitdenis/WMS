     1	import type {
     2	  CellNode as MapCell,
     3	  MapNode,
     4	  WarehouseMapData,
     5	} from '../warehouse-map/WarehouseMapTypes'
     6	import { UNASSIGNED_ID, UNASSIGNED_LABEL } from '../warehouse-map/WarehouseMapTypes'
     7	import type { CellNode, InventoryCount, InventoryNode } from './InventoryTypes'
     8	
     9	// Пересчёт со строки карты склада.
    10	//
    11	// Документ рождается наполненным составом ровно того объекта, на котором нажали:
    12	// нажал на короб — в документе только его товары. Ничего лишнего рядом: человек
    13	// стоит у конкретной полки и не должен видеть весь склад.
    14	
    15	function toInventoryNode(node: MapNode): InventoryNode {
    16	  if (node.kind === 'product') {
    17	    return {
    18	      kind: 'product',
    19	      id: node.id,
    20	      name: node.name,
    21	      sku: node.product_id,
    22	      seller: node.seller_name ?? '—',
    23	      category: node.category ?? '—',
    24	      barcode: node.barcode ?? '',
    25	      photoUrl: node.photo_url,
    26	      // Числится ровно столько, сколько показывает карта. Факт пока не введён.
    27	      expected: node.qty,
    28	      actual: null,
    29	    }
    30	  }
    31	  return {
    32	    kind: node.kind,
    33	    id: node.id,
    34	    code: node.code,
    35	    barcode: node.barcode,
    36	    children: node.children.map(toInventoryNode),
    37	  }
    38	}
    39	
    40	type Found = { node: MapNode; cellLabel: string | null }
    41	
    42	function findNode(data: WarehouseMapData, id: string): Found | null {
    43	  function walk(nodes: MapNode[], cellLabel: string | null): Found | null {
    44	    for (const node of nodes) {
    45	      if (node.id === id) return { node, cellLabel }
    46	      if (node.kind !== 'product') {
    47	        const inner = walk(node.children, cellLabel)
    48	        if (inner) return inner
    49	      }
    50	    }
    51	    return null
    52	  }
    53	  for (const cell of data.cells) {
    54	    const found = walk(cell.children, cell.code)
    55	    if (found) return found
    56	  }
    57	  return walk(data.unassigned, UNASSIGNED_LABEL)
    58	}
    59	
    60	function cellById(data: WarehouseMapData, id: string): MapCell | undefined {
    61	  return data.cells.find((cell) => cell.id === id)
    62	}
    63	
    64	export type MapInventoryTarget = {
    65	  kind: 'cell' | 'unassigned' | 'pallet' | 'box' | 'cargo_place' | 'product'
    66	  id: string
    67	  title: string
    68	}
    69	
    70	/** Где лежит объект: показываем в шапке диалога, а не отдельным уровнем дерева. */
    71	export function placeOf(data: WarehouseMapData, target: MapInventoryTarget): string | null {
    72	  if (target.kind === 'cell' || target.kind === 'unassigned') return null
    73	  const found = findNode(data, target.id)
    74	  return found?.cellLabel ?? null
    75	}
    76	
    77	/**
    78	 * Собрать документ пересчёта по одной строке карты.
    79	 *
    80	 * Возвращает `null`, если строку не нашли: молча показать пустой документ хуже,
    81	 * чем не открыть его вовсе — человек решит, что на месте действительно пусто.
    82	 */
    83	export function countFromMapRow(
    84	  data: WarehouseMapData,
    85	  target: MapInventoryTarget,
    86	  warehouseName: string,
    87	  addressStorage: boolean,
    88	): InventoryCount | null {
    89	  let cells: CellNode[]
    90	  if (target.kind === 'cell') {
    91	    const cell = cellById(data, target.id)
    92	    if (!cell) return null
    93	    cells = [{ id: cell.id, label: cell.code, children: cell.children.map(toInventoryNode) }]
    94	  } else if (target.kind === 'unassigned' || target.id === UNASSIGNED_ID) {
    95	    cells = [
    96	      { id: UNASSIGNED_ID, label: UNASSIGNED_LABEL, children: data.unassigned.map(toInventoryNode) },
    97	    ]
    98	  } else {
    99	    const found = findNode(data, target.id)
   100	    if (!found) return null
   101	    cells = [
   102	      {
   103	        id: `scope-${target.id}`,
   104	        label: found.cellLabel ?? UNASSIGNED_LABEL,
   105	        children: [toInventoryNode(found.node)],
   106	      },
   107	    ]
   108	  }
   109	
   110	  return {
   111	    id: `map-${target.id}`,
   112	    // Номер выдаёт сервер при сохранении. До этого документа в базе нет, и
   113	    // выдумывать ему номер на клиенте нельзя: он разойдётся с настоящим.
   114	    number: 'новый',
   115	    status: 'draft',
   116	    warehouseName,
   117	    fill: { mode: 'object', objectLabel: target.title },
   118	    createdAt: '',
   119	    createdBy: '',
   120	    postedAt: null,
   121	    postedBy: null,
   122	    comment: '',
   123	    addressStorage,
   124	    scoped: target.kind !== 'cell' && target.kind !== 'unassigned',
   125	    cells,
   126	  }
   127	}
   128	
   129	/**
   130	 * Как назвать то, что пересчитываем.
   131	 *
   132	 * У тары и товара строка карты уже называет себя целиком («Короб КР-000471»),
   133	 * поэтому добавлять слово «Короб» второй раз нельзя. Ячейка называет себя одним
   134	 * кодом, ей название нужно.
   135	 */
   136	export function targetTitle(kind: MapInventoryTarget['kind'], rowTitle: string): string {
   137	  if (kind === 'cell') return `Ячейка ${rowTitle}`
   138	  return rowTitle
   139	}

