   196	async def _summary_out(
   197	    session: AsyncSession,
   198	    count: InventoryCount,
   199	) -> InventoryCountSummaryOut:
   200	    current = await service.current_quantities(session, count)
   201	    counted = 0
   202	    discrepancies = 0
   203	    surplus = 0
   204	    shortage = 0
   205	    for line in count.lines:
   206	        if line.actual_quantity is None:
   207	            continue
   208	        counted += 1
   209	        delta = int(line.actual_quantity) - current[line.id]
   210	        if delta == 0:
   211	            continue
   212	        discrepancies += 1
   213	        if delta > 0:
   214	            surplus += delta
   215	        else:
   216	            shortage += -delta
   217	    fill, fill_label = _fill(count)
   218	    return InventoryCountSummaryOut(
   219	        id=str(count.id),
   220	        number=_number(count),
   221	        status=count.status,
   222	        source=count.source,
   223	        warehouse_id=str(count.warehouse_id) if count.warehouse_id is not None else None,
   224	        warehouse_name=count.warehouse.name if count.warehouse is not None else "Все склады",
   225	        seller_id=str(count.seller_id) if count.seller_id is not None else None,
   226	        category=count.category,
   227	        fill=fill,
   228	        fill_label=fill_label,
   229	        created_at=count.created_at.isoformat(),
   230	        created_by=count.created_by.email,
   231	        lines=len(count.lines),
   232	        counted=counted,
   233	        discrepancies=discrepancies,
