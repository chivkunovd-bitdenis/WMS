   389	async def post_count(
   390	    session: AsyncSession,
   391	    tenant_id: uuid.UUID,
   392	    count_id: uuid.UUID,
   393	    user_id: uuid.UUID,
   394	) -> PostResult:
   395	    result = await session.execute(
   396	        select(InventoryCount)
   397	        .where(
   398	            InventoryCount.id == count_id,
   399	            InventoryCount.tenant_id == tenant_id,
   400	        )
   401	        .with_for_update()
   402	    )
   403	    count = result.scalar_one_or_none()
   404	    if count is None:
   405	        raise InventoryCountError("not_found")
   406	    if count.status != STATUS_DRAFT:
   407	        raise InventoryCountError("already_posted")
   408	    lines_result = await session.execute(
   409	        select(InventoryCountLine)
   410	        .where(InventoryCountLine.count_id == count.id)
   411	        .order_by(InventoryCountLine.id)
   412	        .with_for_update()
   413	    )
   414	    entered_lines = [line for line in lines_result.scalars() if line.actual_quantity is not None]
   415	    if not entered_lines:
   416	        raise InventoryCountError("empty_count")
   417	
   418	    changed_balances: list[ChangedBalance] = []
   419	    posted_lines = 0
   420	    for line in entered_lines:
   421	        storage_location_id = line.storage_location_id
   422	        if storage_location_id is None:
   423	            raise InventoryCountError("line_storage_location_missing")
   424	        current = await _current_quantity(
   425	            session,
   426	            tenant_id=tenant_id,
   427	            line=line,
   428	            lock=True,
   429	        )
   430	        if current != line.expected_quantity:
   431	            changed_balances.append(
   432	                ChangedBalance(
   433	                    line_id=line.id,
   434	                    product_id=line.product_id,
   435	                    storage_location_id=storage_location_id,
   436	                    expected_quantity=line.expected_quantity,
   437	                    current_quantity=current,
   438	                )
   439	            )
   440	        assert line.actual_quantity is not None
   441	        delta = int(line.actual_quantity) - current
   442	        line.posted_delta = delta
   443	        if delta == 0:
   444	            continue
   445	        try:
   446	            await inventory_service.record_movement_and_adjust_balance(
   447	                session,
   448	                tenant_id=tenant_id,
   449	                product_id=line.product_id,
   450	                storage_location_id=storage_location_id,
   451	                quantity_delta=delta,
   452	                movement_type=MOVEMENT_TYPE_INVENTORY_COUNT,
   453	                inventory_count_line_id=line.id,
   454	                actor_user_id=user_id,
   455	            )
   456	        except ValueError as exc:
   457	            await session.rollback()
   458	            if str(exc) == "insufficient stock":
   459	                raise InventoryCountError("balance_changed_during_post") from exc
   460	            raise
   461	        posted_lines += 1
   462	
   463	    count.status = STATUS_POSTED
   464	    count.posted_at = datetime.now(UTC)
   465	    count.posted_by_user_id = user_id
   466	    await session.commit()
   467	    loaded = await get_count(session, tenant_id, count.id)
   468	    assert loaded is not None
   469	    return PostResult(
   470	        count=loaded,
   471	        posted_lines=posted_lines,
   472	        unchanged_lines=len(entered_lines) - posted_lines,
   473	        changed_balances=changed_balances,
   474	    )
