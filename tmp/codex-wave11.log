    55	function photo(letters: string): string {
    56	  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="240" height="240">
    57	    <rect width="240" height="240" fill="#eef1f6"/>
    58	    <rect x="48" y="60" width="144" height="120" rx="10" fill="#c7cedb"/>
    59	    <text x="120" y="141" font-family="Inter, sans-serif" font-size="46" font-weight="700"
    60	      fill="#5a6478" text-anchor="middle">${letters}</text>
    61	  </svg>`
    62	  return `data:image/svg+xml;utf8,${encodeURIComponent(svg.replace(/\s+/g, ' '))}`
    63	}
