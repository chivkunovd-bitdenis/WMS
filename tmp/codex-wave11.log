   113	/**
   114	 * Товар по идентификатору. Список передаётся снаружи, а не берётся из заглушки:
   115	 * иначе экран навсегда привязан к выдуманным данным и подключить его к серверу
   116	 * можно только переписав.
   117	 */
   118	export function productById(products: Product[], id: string): Product {
   119	  return (
   120	    products.find((one) => one.id === id) ?? {
   121	      // Товар, которого нет в списке, на экране всё равно называем: пустая
   122	      // строка вместо названия читается как поломка, а это просто рассинхрон.
   123	      id,
   124	      name: 'Товар не найден',
   125	      sku: '—',
   126	      seller: '—',
   127	      barcode: '',
   128	      photo: '',
   129	      size: null,
   130	      alreadyAt: [],
   131	    }
   132	  )
   133	}
   134	
   135	/** Сколько штук внутри объекта — вместе со всем вложенным. */
   136	export function objectQty(
   137	  objectId: string,
   138	  objects: WarehouseObject[],
   139	  lines: GoodsLine[],
   140	): number {
   141	  const own = lines
   142	    .filter((line) => line.holder === objRef(objectId))
   143	    .reduce((sum, line) => sum + line.qty, 0)
   144	  const inner = objects
   145	    .filter((one) => one.holder === objRef(objectId))
   146	    .reduce((sum, one) => sum + objectQty(one.id, objects, lines), 0)
   147	  return own + inner
   148	}
   149	
   150	/** Сколько штук стоит на ячейке — считается по составу, а не хранится. */
   151	export function cellQty(cellId: string, objects: WarehouseObject[], lines: GoodsLine[]): number {
   152	  const loose = lines
   153	    .filter((line) => line.holder === cellRef(cellId))
   154	    .reduce((sum, line) => sum + line.qty, 0)
   155	  const inside = objects
   156	    .filter((one) => one.holder === cellRef(cellId))
   157	    .reduce((sum, one) => sum + objectQty(one.id, objects, lines), 0)
   158	  return loose + inside
   159	}
   160	
   161	/** Цепочка держателей до ячейки: где физически лежит эта строка товара. */
   162	export function whereIs(
   163	  holder: Holder,
   164	  objects: WarehouseObject[],
   165	  cells: Cell[],
   166	): { cell: Cell | null; path: string[] } {
   167	  const path: string[] = []
   168	  let cursor = holder
   169	  while (cursor) {
   170	    if (isCellRef(cursor)) {
   171	      const cell = cells.find((one) => one.id === refId(cursor!)) ?? null
   172	      return { cell, path }
   173	    }
   174	    const object = objects.find((one) => one.id === refId(cursor!))
   175	    if (!object) return { cell: null, path }
   176	    path.unshift(`${KIND_TITLE[object.kind]} ${object.code}`)
   177	    cursor = object.holder
   178	  }
   179	  return { cell: null, path }
   180	}

