   571	async def _transfer_balance(
   572	    session: AsyncSession,
   573	    *,
   574	    tenant_id: uuid.UUID,
   575	    balance: InventoryBalance,
   576	    quantity: int,
   577	    destination_location_id: uuid.UUID,
   578	    destination_container_kind: ContainerKind | None,
   579	    destination_container_id: uuid.UUID | None,
   580	    transfer_group_id: uuid.UUID,
   581	) -> None:
   582	    source_kind = cast(ContainerKind | None, balance.container_kind)
   583	    await inventory_service.record_movement_and_adjust_balance(
   584	        session,
   585	        tenant_id=tenant_id,
   586	        product_id=balance.product_id,
   587	        storage_location_id=balance.storage_location_id,
   588	        quantity_delta=-quantity,
   589	        movement_type=MOVEMENT_TYPE_WAREHOUSE_MAP,
   590	        transfer_group_id=transfer_group_id,
   591	        container_kind=source_kind,
   592	        container_id=balance.container_id,
   593	    )
   594	    await inventory_service.record_movement_and_adjust_balance(
   595	        session,
   596	        tenant_id=tenant_id,
   597	        product_id=balance.product_id,
   598	        storage_location_id=destination_location_id,
   599	        quantity_delta=quantity,
   600	        movement_type=MOVEMENT_TYPE_WAREHOUSE_MAP,
   601	        transfer_group_id=transfer_group_id,
   602	        container_kind=destination_container_kind,
   603	        container_id=destination_container_id,
   604	    )
