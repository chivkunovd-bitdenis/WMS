diff --git a/frontend/src/screens/ff/inventory/inventoryApi.ts b/frontend/src/screens/ff/inventory/inventoryApi.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4aba50f5d8ddd4ffbe517a81701b1264a6e48e79
--- /dev/null
+++ b/frontend/src/screens/ff/inventory/inventoryApi.ts
@@ -0,0 +1,209 @@
+import { apiUrl } from '../../../api'
+import { readApiErrorMessage } from '../../../utils/readApiErrorMessage'
+import type {
+  CountStatus,
+  InventoryCount,
+  InventoryNode,
+  ProductNode,
+} from './InventoryTypes'
+
+export const INVENTORY_COUNTS_BASE = '/operations/inventory-counts'
+
+export type InventoryObjectType =
+  | 'product'
+  | 'storage_location'
+  | 'location'
+  | 'cell'
+  | 'pallet'
+  | 'box'
+  | 'cargo_place'
+
+export type InventoryObjectTarget = {
+  type: InventoryObjectType
+  id: string
+  warehouse_id?: string | null
+  storage_location_id?: string | null
+  container_kind?: 'pallet' | 'box' | 'cargo_place' | null
+  container_id?: string | null
+}
+
+type ApiProduct = {
+  kind: 'product'
+  id: string
+  product_id: string
+  name: string
+  sku: string
+  seller: string
+  category: string | null
+  barcode: string | null
+  photo_url: string | null
+  expected: number
+  actual: number | null
+  expected_now: number | null
+}
+
+type ApiContainer = {
+  kind: 'pallet' | 'box' | 'cargo_place'
+  id: string
+  code: string
+  barcode: string | null
+  children: ApiNode[]
+}
+
+type ApiNode = ApiProduct | ApiContainer
+
+type ApiCell = { id: string; label: string; children: ApiNode[] }
+
+export type ApiInventoryCountDetail = {
+  id: string
+  number: string
+  status: string
+  warehouse_name: string
+  fill: {
+    mode: 'object' | 'all' | 'filters'
+    seller_id: string | null
+    category: string | null
+    object_label: string | null
+  }
+  created_at: string
+  created_by: string
+  posted_at: string | null
+  posted_by: string | null
+  comment: string
+  address_storage: boolean
+  cells: ApiCell[]
+}
+
+export type InventoryPostResult = {
+  posted_lines: number
+  changed_balance_count: number
+}
+
+export function inventoryAuthHeaders(token: string): Record<string, string> {
+  return { Authorization: `Bearer ${token}` }
+}
+
+function toProduct(node: ApiProduct): ProductNode {
+  return {
+    kind: 'product',
+    id: node.id,
+    name: node.name,
+    sku: node.sku,
+    seller: node.seller,
+    category: node.category ?? '—',
+    barcode: node.barcode ?? '',
+    photoUrl: node.photo_url,
+    expected: node.expected,
+    actual: node.actual,
+    ...(node.expected_now === null || node.expected_now === node.expected
+      ? {}
+      : { expectedNow: node.expected_now }),
+  }
+}
+
+function toNode(node: ApiNode): InventoryNode {
+  if (node.kind === 'product') return toProduct(node)
+  return {
+    kind: node.kind,
+    id: node.id,
+    code: node.code,
+    barcode: node.barcode,
+    children: node.children.map(toNode),
+  }
+}
+
+export function inventoryCountFromApi(
+  detail: ApiInventoryCountDetail,
+  options: { scoped?: boolean } = {},
+): InventoryCount {
+  return {
+    id: detail.id,
+    number: detail.number,
+    status: detail.status as CountStatus,
+    warehouseName: detail.warehouse_name,
+    fill:
+      detail.fill.mode === 'object'
+        ? { mode: 'object', objectLabel: detail.fill.object_label ?? 'По объекту' }
+        : detail.fill.mode === 'all'
+          ? { mode: 'all' }
+          : {
+              mode: 'filters',
+              seller: detail.fill.seller_id,
+              category: detail.fill.category,
+            },
+    createdAt: detail.created_at,
+    createdBy: detail.created_by,
+    postedAt: detail.posted_at,
+    postedBy: detail.posted_by,
+    comment: detail.comment,
+    addressStorage: detail.address_storage,
+    ...(options.scoped ? { scoped: true } : {}),
+    cells: detail.cells.map((cell) => ({
+      id: cell.id,
+      label: cell.label,
+      children: cell.children.map(toNode),
+    })),
+  }
+}
+
+function collectActuals(
+  nodes: InventoryNode[],
+  lines: Array<{ line_id: string; actual_quantity: number | null }>,
+) {
+  for (const node of nodes) {
+    if (node.kind === 'product') {
+      lines.push({ line_id: node.id, actual_quantity: node.actual })
+    } else {
+      collectActuals(node.children, lines)
+    }
+  }
+}
+
+export function inventoryActualPayload(count: InventoryCount) {
+  const lines: Array<{ line_id: string; actual_quantity: number | null }> = []
+  for (const cell of count.cells) collectActuals(cell.children, lines)
+  return { lines, comment: count.comment || null }
+}
+
+export async function createObjectInventoryCount(
+  token: string,
+  target: InventoryObjectTarget,
+): Promise<InventoryCount> {
+  const res = await fetch(apiUrl(INVENTORY_COUNTS_BASE), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', ...inventoryAuthHeaders(token) },
+    body: JSON.stringify({ source: 'object', object: target, comment: null }),
+  })
+  if (!res.ok) throw new Error(await readApiErrorMessage(res))
+  return inventoryCountFromApi((await res.json()) as ApiInventoryCountDetail, {
+    scoped: target.type !== 'cell' && target.type !== 'location' && target.type !== 'storage_location',
+  })
+}
+
+export async function saveInventoryCount(
+  token: string,
+  count: InventoryCount,
+): Promise<InventoryCount> {
+  const res = await fetch(apiUrl(`${INVENTORY_COUNTS_BASE}/${count.id}/lines`), {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json', ...inventoryAuthHeaders(token) },
+    body: JSON.stringify(inventoryActualPayload(count)),
+  })
+  if (!res.ok) throw new Error(await readApiErrorMessage(res))
+  return inventoryCountFromApi((await res.json()) as ApiInventoryCountDetail, {
+    scoped: count.scoped,
+  })
+}
+
+export async function postInventoryCount(
+  token: string,
+  count: InventoryCount,
+): Promise<InventoryPostResult> {
+  await saveInventoryCount(token, count)
+  const res = await fetch(apiUrl(`${INVENTORY_COUNTS_BASE}/${count.id}/post`), {
+    method: 'POST',
+    headers: inventoryAuthHeaders(token),
+  })
+  if (!res.ok) throw new Error(await readApiErrorMessage(res))
+  return (await res.json()) as InventoryPostResult
+}

