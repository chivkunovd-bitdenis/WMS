   713	async def move_object(
   714	    session: AsyncSession,
   715	    *,
   716	    tenant_id: uuid.UUID,
   717	    warehouse_id: uuid.UUID,
   718	    actor_user_id: uuid.UUID,
   719	    kind: ObjectKind,
   720	    object_id: uuid.UUID,
   721	    to_kind: DestinationKind,
   722	    to_id: uuid.UUID | None,
   723	    quantity: int,
   724	) -> dict[str, Any]:
   725	    await _assert_warehouse(session, tenant_id, warehouse_id)
   726	    if quantity <= 0:
   727	        raise WarehouseMapError("quantity_must_be_positive")
   728	    if kind == "pallet" and to_kind == "pallet" and object_id == to_id:
   729	        raise WarehouseMapError("container_cycle")
   730	    destination_location_id, destination_kind, destination_id, to_label = await _destination(
   731	        session, tenant_id, warehouse_id, to_kind, to_id
   732	    )
   733	    transfer_group_id = uuid.uuid4()
   734	
   735	    if kind == "product":
   736	        balance = await session.scalar(
   737	            select(InventoryBalance)
   738	            .join(StorageLocation)
   739	            .where(
   740	                InventoryBalance.id == object_id,
   741	                InventoryBalance.tenant_id == tenant_id,
   742	                InventoryBalance.quantity > 0,
   743	                StorageLocation.warehouse_id == warehouse_id,
   744	            )
   745	            .with_for_update()
   746	        )
   747	        if balance is None:
   748	            raise WarehouseMapError("object_not_found")
   749	        if quantity > balance.quantity:
   750	            raise WarehouseMapError("insufficient_stock")
   751	        product = await session.get(Product, balance.product_id)
   752	        assert product is not None
   753	        from_label = await _location_label(session, balance.storage_location_id)
   754	        if balance.container_kind and balance.container_id:
   755	            code = await _container_code(
   756	                session,
   757	                tenant_id,
   758	                warehouse_id,
   759	                cast(ContainerKind, balance.container_kind),
   760	                balance.container_id,
   761	            )
   762	            from_label = _container_title(balance.container_kind, code)
   763	        await _transfer_balance(
   764	            session,
   765	            tenant_id=tenant_id,
   766	            balance=balance,
   767	            quantity=quantity,
   768	            destination_location_id=destination_location_id,
   769	            destination_container_kind=destination_kind,
   770	            destination_container_id=destination_id,
   771	            transfer_group_id=transfer_group_id,
   772	        )
   773	        subject = product.name
   774	        moved_quantity: int | None = quantity
   775	    else:
   776	        container_kind: ContainerKind = kind
   777	        try:
   778	            await validate_container(session, tenant_id, warehouse_id, container_kind, object_id)
   779	        except ValueError as exc:
   780	            raise WarehouseMapError("object_not_found") from exc
   781	        if to_kind in {"box", "cargo_place"}:
   782	            raise WarehouseMapError("invalid_container_destination")
   783	        source_location_id = await _container_location_id(
   784	            session, tenant_id, warehouse_id, container_kind, object_id
   785	        )
   786	        from_label = await _location_label(session, source_location_id)
   787	        balances = await _container_balances(
   788	            session, tenant_id, warehouse_id, container_kind, object_id
   789	        )
   790	        moved_total = sum(int(row.quantity) for row in balances)
   791	        for balance in balances:
   792	            await _transfer_balance(
   793	                session,
   794	                tenant_id=tenant_id,
   795	                balance=balance,
   796	                quantity=int(balance.quantity),
   797	                destination_location_id=destination_location_id,
   798	                destination_container_kind=cast(ContainerKind, balance.container_kind),
   799	                destination_container_id=balance.container_id,
   800	                transfer_group_id=transfer_group_id,
   801	            )
   802	        await _place_container(
   803	            session,
   804	            tenant_id,
   805	            warehouse_id,
   806	            container_kind,
   807	            object_id,
   808	            to_kind,
   809	            to_id,
   810	            destination_location_id,
   811	        )
   812	        code = await _container_code(session, tenant_id, warehouse_id, container_kind, object_id)
   813	        subject = _container_title(container_kind, code)
   814	        moved_quantity = moved_total
   815	
   816	    event = WarehouseMapEvent(
   817	        tenant_id=tenant_id,
   818	        warehouse_id=warehouse_id,
   819	        actor_user_id=actor_user_id,
   820	        subject=subject,
   821	        quantity=moved_quantity,
   822	        from_label=from_label,
   823	        to_label=to_label,
   824	    )
   825	    session.add(event)
   826	    await session.commit()
   827	    return {"id": str(event.id), "moved_qty": moved_quantity}
