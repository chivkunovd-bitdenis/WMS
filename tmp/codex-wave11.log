   201	  onCreate,
   202	}: {
   203	  warehouseName: string
   204	  existingCodes: string[]
   205	  onClose: () => void
   206	  onCreate: (code: string) => void
   207	}) {
   208	  const [rack, setRack] = useState('')
   209	  const [side, setSide] = useState('1')
   210	  // Позицию подставляем сами — первую свободную. Ручной ввод помним только для
   211	  // того стеллажа и стороны, для которых его набрали: сменил стеллаж — снова
   212	  // подсказка, а не число от прошлого ряда.
   213	  const [manual, setManual] = useState<{ signature: string; value: number | null } | null>(null)
   214	
   215	  const sideNumber = side === '2' ? 2 : 1
   216	  const signature = `${normalizeRackName(rack)}|${side}`
   217	  const suggestion = useMemo(
   218	    () => (rack.trim() ? suggestNextLocationForRack(rack, sideNumber, existingCodes) : null),
   219	    [existingCodes, rack, sideNumber],
   220	  )
   221	  const position =
   222	    manual && manual.signature === signature ? manual.value : (suggestion?.position ?? null)
   223	  const code = rack.trim() && position !== null ? formatLocationCode(rack, sideNumber, position) : ''
   224	
   225	  return (
