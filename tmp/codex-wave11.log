   237	            onClick={() => onCreate(code)}
   238	            disabledReason={code ? undefined : 'Укажите стеллаж'}
   239	            data-testid="warehouse-map-cell-submit"
   240	          >
   241	            Создать
   242	          </PrimaryAction>
   243	        </ActionGroup>
   244	      }
   245	    >
   246	      <Stack spacing={2}>
   247	        <Typography variant="body2" color="text.secondary">
   248	          Склад: {warehouseName}
   249	        </Typography>
   250	        <TextInput
   251	          label="Стеллаж"
   252	          value={rack}
   253	          onChange={setRack}
   254	          required
   255	          helperText="Как написано на стеллаже: А, Б, В1"
   256	          testId="warehouse-map-cell-rack"
   257	        />
   258	        <SelectInput
   259	          label="Сторона"
   260	          value={side}
   261	          onChange={setSide}
   262	          options={[
   263	            { value: '1', label: 'Сторона 1' },
   264	            { value: '2', label: 'Сторона 2' },
   265	          ]}
   266	          testId="warehouse-map-cell-side"
   267	        />
   268	        <NumberInput
   269	          label="Позиция"
   270	          value={position}
   271	          onChange={(value) => setManual({ signature, value })}
   272	          min={1}
   273	          helperText="Свободная позиция подставлена автоматически"
   274	          testId="warehouse-map-cell-position"
   275	        />
   276	        <Typography variant="subtitle2" data-testid="warehouse-map-cell-preview">
   277	          Код ячейки: {code || 'появится после стеллажа'}
   278	        </Typography>
   279	      </Stack>
   280	    </AppDialog>
   281	  )
   282	}
