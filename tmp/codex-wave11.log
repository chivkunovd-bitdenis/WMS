    67	async def _load_boxes(
    68	    session: AsyncSession, tenant_id: uuid.UUID, warehouse_id: uuid.UUID
    69	) -> tuple[list[WarehouseBox], list[InboundIntakeBox], list[InboundIntakeCargoPlace]]:
    70	    warehouse_boxes = list(
    71	        (
    72	            await session.scalars(
    73	                select(WarehouseBox).where(
    74	                    WarehouseBox.tenant_id == tenant_id,
    75	                    WarehouseBox.warehouse_id == warehouse_id,
    76	                )
    77	            )
    78	        ).all()
    79	    )
    80	    inbound_boxes = list(
    81	        (
    82	            await session.scalars(
    83	                select(InboundIntakeBox)
    84	                .join(InboundIntakeRequest)
    85	                .where(
    86	                    InboundIntakeBox.tenant_id == tenant_id,
    87	                    InboundIntakeRequest.tenant_id == tenant_id,
    88	                    InboundIntakeRequest.warehouse_id == warehouse_id,
    89	                )
    90	            )
    91	        ).all()
    92	    )
    93	    cargo_places = list(
    94	        (
    95	            await session.scalars(
    96	                select(InboundIntakeCargoPlace)
    97	                .join(InboundIntakeRequest)
    98	                .where(
    99	                    InboundIntakeCargoPlace.tenant_id == tenant_id,
   100	                    InboundIntakeRequest.tenant_id == tenant_id,
   101	                    InboundIntakeRequest.warehouse_id == warehouse_id,
   102	                )
   103	            )
   104	        ).all()
   105	    )
   106	    return warehouse_boxes, inbound_boxes, cargo_places
