   529	                    )
   530	                    for seller_id, nm_id in pairs
   531	                ]
   532	            ),
   533	        )
   534	    )
   535	    by_pair = {
   536	        (card.seller_id, card.nm_id): subject_name_from_card(card.raw_json or {})
   537	        for card in rows.scalars()
   538	    }
   539	    for product in missing:
   540	        seller_id = product.seller_id
   541	        nm_id = product.wb_nm_id
   542	        if seller_id is not None and nm_id is not None:
   543	            result[product.id] = by_pair.get((seller_id, nm_id))
