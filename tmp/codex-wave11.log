   108	
   109	async def _load_map_rows(
   110	    session: AsyncSession, tenant_id: uuid.UUID, warehouse_id: uuid.UUID
   111	) -> tuple[
   112	    list[tuple[InventoryBalance, StorageLocation, Product, Seller | None]],
   113	    list[StorageLocation],
   114	    list[Pallet],
   115	    list[WarehouseBox],
   116	    list[InboundIntakeBox],
   117	    list[InboundIntakeCargoPlace],
   118	    dict[tuple[uuid.UUID, int], SellerWildberriesImportedCard],
   119	]:
   120	    rows = cast(
   121	        list[tuple[InventoryBalance, StorageLocation, Product, Seller | None]],
   122	        list(
   123	            (
   124	                await session.execute(
   125	                    select(InventoryBalance, StorageLocation, Product, Seller)
   126	                    .join(
   127	                        StorageLocation, StorageLocation.id == InventoryBalance.storage_location_id
   128	                    )
   129	                    .join(Product, Product.id == InventoryBalance.product_id)
   130	                    .outerjoin(Seller, Seller.id == Product.seller_id)
   131	                    .where(
   132	                        InventoryBalance.tenant_id == tenant_id,
   133	                        InventoryBalance.quantity > 0,
   134	                        StorageLocation.tenant_id == tenant_id,
   135	                        StorageLocation.warehouse_id == warehouse_id,
   136	                        Product.tenant_id == tenant_id,
   137	                    )
   138	                )
   139	            ).all()
   140	        ),
   141	    )
   142	    locations = list(
   143	        (
   144	            await session.scalars(
   145	                select(StorageLocation)
   146	                .where(
   147	                    StorageLocation.tenant_id == tenant_id,
   148	                    StorageLocation.warehouse_id == warehouse_id,
   149	                    StorageLocation.deleted_at.is_(None),
   150	                )
   151	                .order_by(StorageLocation.code)
   152	            )
   153	        ).all()
   154	    )
   155	    pallets = list(
   156	        (
   157	            await session.scalars(
   158	                select(Pallet)
   159	                .where(
   160	                    Pallet.tenant_id == tenant_id,
   161	                    Pallet.warehouse_id == warehouse_id,
   162	                    Pallet.disbanded_at.is_(None),
   163	                )
   164	                .order_by(Pallet.code)
   165	            )
   166	        ).all()
   167	    )
   168	    warehouse_boxes, inbound_boxes, cargo_places = await _load_boxes(
   169	        session, tenant_id, warehouse_id
   170	    )
   171	    pairs = {
   172	        (product.seller_id, product.wb_nm_id)
   173	        for _balance, _location, product, _seller in rows
   174	        if product.seller_id is not None and product.wb_nm_id is not None
   175	    }
   176	    cards: dict[tuple[uuid.UUID, int], SellerWildberriesImportedCard] = {}
   177	    if pairs:
   178	        seller_ids = {pair[0] for pair in pairs}
   179	        nm_ids = {pair[1] for pair in pairs}
   180	        card_rows = await session.scalars(
   181	            select(SellerWildberriesImportedCard).where(
   182	                SellerWildberriesImportedCard.tenant_id == tenant_id,
   183	                SellerWildberriesImportedCard.seller_id.in_(seller_ids),
   184	                SellerWildberriesImportedCard.nm_id.in_(nm_ids),
   185	            )
   186	        )
   187	        cards = {(card.seller_id, int(card.nm_id)): card for card in card_rows.all()}
   188	    return (
   189	        rows,
   190	        locations,
   191	        pallets,
   192	        warehouse_boxes,
   193	        inbound_boxes,
   194	        cargo_places,
   195	        cards,
   196	    )
   197	
   198	
   199	def _normalize_container(node: dict[str, Any]) -> dict[str, Any]:
   200	    children = [
   201	        _normalize_container(child) if child["kind"] != "product" else child
   202	        for child in node["children"]
   203	    ]
   204	    sellers: set[str] = set()
   205	
   206	    def collect(child: dict[str, Any]) -> None:
   207	        if child["kind"] == "product":
   208	            if child["seller_name"]:
   209	                sellers.add(child["seller_name"])
   210	            return
   211	        for nested in child["children"]:
   212	            collect(nested)
   213	
   214	    for child in children:
   215	        collect(child)
   216	    return {
   217	        **node,
   218	        "children": children,
   219	        "qty": sum(int(child["qty"]) for child in children),
   220	        "seller_name": next(iter(sellers)) if len(sellers) == 1 else None,
   221	    }
   222	
   223	
   224	async def get_warehouse_map(
   225	    session: AsyncSession, tenant_id: uuid.UUID, warehouse_id: uuid.UUID
   226	) -> dict[str, Any]:
   227	    await _assert_warehouse(session, tenant_id, warehouse_id)
   228	    address_enabled = await is_address_storage_enabled(session, tenant_id)
   229	    (
   230	        rows,
   231	        locations,
   232	        pallets,
   233	        warehouse_boxes,
   234	        inbound_boxes,
   235	        cargo_places,
   236	        cards,
   237	    ) = await _load_map_rows(session, tenant_id, warehouse_id)
   238	
   239	    location_by_id = {location.id: location for location in locations}
   240	    balance_location: dict[tuple[str, uuid.UUID], uuid.UUID] = {}
   241	    for balance, location, _product, _seller in rows:
   242	        if balance.container_kind and balance.container_id:
   243	            balance_location.setdefault((balance.container_kind, balance.container_id), location.id)
   244	
   245	    nodes: dict[tuple[str, uuid.UUID], dict[str, Any]] = {}
   246	    holders: dict[tuple[str, uuid.UUID], tuple[str, uuid.UUID] | uuid.UUID | None] = {}
   247	    pallet_ids = {pallet.id for pallet in pallets}
   248	    for pallet in pallets:
   249	        key = ("pallet", pallet.id)
   250	        nodes[key] = {
   251	            "kind": "pallet",
   252	            "id": str(pallet.id),
   253	            "code": pallet.code,
   254	            "barcode": pallet.barcode,
   255	            "seller_name": None,
   256	            "qty": 0,
   257	            "children": [],
   258	        }
   259	        holders[key] = pallet.storage_location_id
   260	    for box in warehouse_boxes:
   261	        key = ("box", box.id)
   262	        nodes[key] = {
   263	            "kind": "box",
   264	            "id": str(box.id),
   265	            "code": box.internal_barcode,
   266	            "barcode": box.internal_barcode,
   267	            "seller_name": None,
   268	            "qty": 0,
   269	            "children": [],
   270	        }
   271	        holders[key] = (
   272	            ("pallet", box.pallet_id)
   273	            if box.pallet_id in pallet_ids
   274	            else box.storage_location_id or balance_location.get(key)
   275	        )
   276	    for inbound_box in inbound_boxes:
   277	        key = ("box", inbound_box.id)
   278	        nodes[key] = {
   279	            "kind": "box",
   280	            "id": str(inbound_box.id),
   281	            "code": f"КР-{inbound_box.box_number:06d}",
   282	            "barcode": inbound_box.internal_barcode,
   283	            "seller_name": None,
   284	            "qty": 0,
   285	            "children": [],
   286	        }
   287	        holders[key] = (
   288	            ("pallet", inbound_box.pallet_id)
   289	            if inbound_box.pallet_id in pallet_ids
   290	            else balance_location.get(key)
   291	        )
   292	    for place in cargo_places:
   293	        key = ("cargo_place", place.id)
   294	        nodes[key] = {
   295	            "kind": "cargo_place",
   296	            "id": str(place.id),
   297	            "code": f"ГМ-{place.place_number:06d}",
   298	            "barcode": place.internal_barcode,
   299	            "seller_name": None,
   300	            "qty": 0,
   301	            "children": [],
   302	        }
   303	        holders[key] = (
   304	            ("pallet", place.pallet_id)
   305	            if place.pallet_id in pallet_ids
   306	            else balance_location.get(key)
   307	        )
   308	
   309	    loose_by_location: dict[uuid.UUID, list[dict[str, Any]]] = defaultdict(list)
   310	    sellers: set[str] = set()
   311	    categories: set[str] = set()
   312	    for balance, location, product, seller in rows:
   313	        card = (
   314	            cards.get((product.seller_id, product.wb_nm_id))
   315	            if (product.seller_id is not None and product.wb_nm_id is not None)
   316	            else None
   317	        )
   318	        category, photo_url = _card_data(card)
   319	        seller_name = seller.name if seller is not None else None
   320	        if seller_name:
   321	            sellers.add(seller_name)
   322	        if category:
   323	            categories.add(category)
   324	        product_node = {
   325	            "kind": "product",
   326	            "id": str(balance.id),
   327	            "product_id": str(product.id),
   328	            "name": product.name,
   329	            "seller_name": seller_name,
   330	            "category": category,
   331	            "barcode": product.wb_barcode,
   332	            "photo_url": photo_url,
   333	            "qty": int(balance.quantity),
   334	        }
   335	        container_key = (
   336	            (balance.container_kind, balance.container_id)
   337	            if balance.container_kind and balance.container_id
   338	            else None
   339	        )
   340	        if container_key in nodes:
   341	            assert container_key is not None
   342	            nodes[container_key]["children"].append(product_node)
   343	        else:
   344	            loose_by_location[location.id].append(product_node)
   345	
   346	    root_by_location: dict[uuid.UUID, list[dict[str, Any]]] = defaultdict(list)
   347	    unassigned: list[dict[str, Any]] = []
   348	    for key, node in nodes.items():
   349	        holder = holders.get(key)
   350	        if isinstance(holder, tuple) and holder in nodes:
   351	            nodes[holder]["children"].append(node)
   352	            continue
   353	        root_location = location_by_id.get(holder) if isinstance(holder, uuid.UUID) else None
   354	        if (
   355	            address_enabled
   356	            and root_location is not None
   357	            and root_location.code != SORTING_LOCATION_CODE
   358	        ):
   359	            root_by_location[root_location.id].append(node)
   360	        else:
   361	            unassigned.append(node)
   362	
   363	    cells: list[dict[str, Any]] = []
   364	    if address_enabled:
   365	        for location in locations:
   366	            if location.code == SORTING_LOCATION_CODE:
   367	                unassigned.extend(loose_by_location.pop(location.id, []))
   368	                continue
   369	            children = [
   370	                *root_by_location.get(location.id, []),
   371	                *loose_by_location.pop(location.id, []),
   372	            ]
   373	            normalized = [
   374	                _normalize_container(child) if child["kind"] != "product" else child
   375	                for child in children
   376	            ]
   377	            cells.append(
   378	                {
   379	                    "id": str(location.id),
   380	                    "code": location.code,
   381	                    "barcode": location.barcode,
   382	                    "qty": sum(int(child["qty"]) for child in normalized),
   383	                    "children": normalized,
   384	                }
   385	            )
   386	    else:
   387	        for loose in loose_by_location.values():
   388	            unassigned.extend(loose)
   389	    normalized_unassigned = [
   390	        _normalize_container(node) if node["kind"] != "product" else node for node in unassigned
   391	    ]
   392	
   393	    warehouses = list(
   394	        (
   395	            await session.scalars(
   396	                select(Warehouse)
   397	                .where(
   398	                    Warehouse.tenant_id == tenant_id,
   399	                    Warehouse.is_operational.is_(True),
   400	                )
   401	                .order_by(Warehouse.name)
   402	            )
   403	        ).all()
   404	    )
   405	    event_rows = list(
   406	        (
   407	            await session.execute(
   408	                select(WarehouseMapEvent, User)
   409	                .outerjoin(User, User.id == WarehouseMapEvent.actor_user_id)
   410	                .where(
   411	                    WarehouseMapEvent.tenant_id == tenant_id,
   412	                    WarehouseMapEvent.warehouse_id == warehouse_id,
   413	                )
   414	                .order_by(WarehouseMapEvent.created_at.desc(), WarehouseMapEvent.id.desc())
   415	                .limit(100)
   416	            )
   417	        ).all()
   418	    )
   419	    journal = [
   420	        {
   420	        {
   421	            "id": str(event.id),
   422	            "at": event.created_at.astimezone(UTC).isoformat().replace("+00:00", "Z"),
   423	            "actor_name": actor.email if actor is not None else "Система",
   424	            "subject": event.subject,
   425	            "qty": event.quantity,
   426	            "from_label": event.from_label,
   427	            "to_label": event.to_label,
   428	        }
   429	        for event, actor in event_rows
   430	    ]
   431	    return {
   432	        "warehouses": [{"id": str(row.id), "name": row.name} for row in warehouses],
   433	        "sellers": sorted(sellers),
   434	        "categories": sorted(categories),
   435	        "cells": cells,
   436	        "unassigned": normalized_unassigned,
   437	        "journal": journal,
   438	    }
   439	
