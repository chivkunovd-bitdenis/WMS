   607	async def _container_balances(
   608	    session: AsyncSession,
   609	    tenant_id: uuid.UUID,
   610	    warehouse_id: uuid.UUID,
   611	    kind: ContainerKind,
   612	    container_id: uuid.UUID,
   613	) -> list[InventoryBalance]:
   614	    refs: list[tuple[str, uuid.UUID]] = [(kind, container_id)]
   615	    if kind == "pallet":
   616	        warehouse_boxes, inbound_boxes, cargo_places = await _load_boxes(
   617	            session, tenant_id, warehouse_id
   618	        )
   619	        refs.extend(("box", row.id) for row in warehouse_boxes if row.pallet_id == container_id)
   620	        refs.extend(("box", row.id) for row in inbound_boxes if row.pallet_id == container_id)
   621	        refs.extend(
   622	            ("cargo_place", row.id) for row in cargo_places if row.pallet_id == container_id
   623	        )
   624	    predicates = [
   625	        (InventoryBalance.container_kind == ref_kind) & (InventoryBalance.container_id == ref_id)
   626	        for ref_kind, ref_id in refs
   627	    ]
   628	    rows = list(
   629	        (
   630	            await session.scalars(
   631	                select(InventoryBalance)
   632	                .join(StorageLocation)
   633	                .where(
   634	                    InventoryBalance.tenant_id == tenant_id,
   635	                    InventoryBalance.quantity > 0,
   636	                    StorageLocation.warehouse_id == warehouse_id,
   637	                    or_(*predicates),
   638	                )
   639	                .with_for_update()
   640	            )
   641	        ).all()
   642	    )
   643	    return rows
