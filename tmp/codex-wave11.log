     1	import type { LabelSize } from './labelSize'
     2	
     3	/** Print a CODE128 label (58×40 workflow — same iframe pattern as catalog cell labels). */
     4	function escapeHtml(text: string): string {
     5	  return text
     6	    .replaceAll('&', '&amp;')
     7	    .replaceAll('<', '&lt;')
     8	    .replaceAll('>', '&gt;')
     9	    .replaceAll('"', '&quot;')
    10	}
    11	
    12	declare global {
    13	  interface Window {
    14	    __WMS_CAPTURE_PRINT_HTML__?: boolean
    15	    __WMS_LAST_PRINT_HTML__?: string
    16	    __WMS_PRINT_JOB_COUNT__?: number
    17	    __WMS_PRINT_CLEANUP_EVENTS__?: string[]
    18	  }
    19	}
    20	
    21	export type BarcodeLabelLayout = 'default' | 'storageCell' | 'internalBox'
    22	
    23	export type BarcodeLabelPrintOptions = {
    24	  title: string
    25	  barcode: string
    26	  barcodeDataUrl: string
    27	  /** Физический размер этикетки (см. utils/labelSize.ts). Без него — прежнее поведение (авто-размер листа браузера). */
    28	  labelSize?: LabelSize
    29	  /** Ячейки печатаются на крупной складской этикетке, а не на товарном термоформате. */
    30	  layout?: BarcodeLabelLayout
    31	}
    32	
    33	function labelPageHtml(options: BarcodeLabelPrintOptions, index: number, total: number): string {
    34	  const { title, barcode, barcodeDataUrl } = options
    35	  const safeTitle = escapeHtml(title)
    36	  const safeBarcode = escapeHtml(barcode)
    37	  const safeBarcodeDataUrl = escapeHtml(barcodeDataUrl)
    38	  return `<section class="label${index + 1 < total ? ' label--next' : ''}" data-barcode="${safeBarcode}">
    39	      <div class="wrap">
    40	        <div class="title">${safeTitle}</div>
    41	        <img class="barcode" src="${safeBarcodeDataUrl}" alt="barcode" />
    42	        <div class="code">${safeBarcode}</div>
    43	      </div>
    44	    </section>`
    45	}
    46	
    47	/**
    48	 * Одна печатная задача для одной или нескольких внутренних этикеток.
    49	 * Массовая печать намеренно собирает все страницы в один iframe: термопринтер
    50	 * получает непрерывную ленту, а не набор отдельных браузерных заданий.
    51	 */
    52	export function printBarcodeLabels(optionsList: BarcodeLabelPrintOptions[]): void {
    53	  if (optionsList.length === 0) return
    54	  const first = optionsList[0]!
    55	  const { labelSize, layout = 'default' } = first
    56	  if (optionsList.some((options) => options.labelSize?.id !== labelSize?.id || (options.layout ?? 'default') !== layout)) {
    57	    throw new Error('Все этикетки в одной печати должны иметь одинаковый размер и макет.')
    58	  }
    59	  const pageStyle = layout === 'storageCell'
    60	    ? `@page { margin: 4mm; }
    61	      .wrap { min-height: calc(100vh - 8mm); padding: 2mm; box-sizing: border-box; }
    62	      .title { font-size: 24pt; }
    63	      .code { font-size: 18pt; }
    64	      .barcode { width: 96%; max-width: 190mm; height: 48mm; object-fit: fill; }`
    65	    : layout === 'internalBox' && labelSize
    66	      ? `@page { size: ${labelSize.widthMm}mm ${labelSize.heightMm}mm; margin: 0; }
    67	      html, body { width: ${labelSize.widthMm}mm; height: ${labelSize.heightMm}mm; }
    68	      .label { width: ${labelSize.widthMm}mm; height: ${labelSize.heightMm}mm; box-sizing: border-box; }
    69	      .label--next { break-after: page; page-break-after: always; }
    70	      .wrap { width: 100%; height: 100%; box-sizing: border-box; padding: 1.5mm; display: grid; grid-template-rows: auto 1fr auto; gap: 1mm; justify-items: stretch; align-items: center; }
    71	      .title { font-size: 13pt; font-weight: 800; text-align: center; }
    72	      .code { font-size: 9pt; text-align: center; }
    73	      .barcode { width: 100%; max-width: none; height: auto; max-height: none; display: block; image-rendering: pixelated; }`
    74	    : labelSize
    75	      ? `@page { size: ${labelSize.widthMm}mm ${labelSize.heightMm}mm; margin: 0; }
    76	      html, body { width: ${labelSize.widthMm}mm; height: ${labelSize.heightMm}mm; }
    77	      .wrap { width: 100%; height: 100%; box-sizing: border-box; padding: 2mm; }
    78	      .barcode { width: auto; max-width: 90%; max-height: 55%; }`
    79	      : `@page { margin: 10mm; }
    80	        .barcode { width: 320px; height: auto; }`
    81	  const html = `<!doctype html>
    82	<html>
    83	  <head>
    84	    <meta charset="utf-8" />
    85	    <meta name="viewport" content="width=device-width, initial-scale=1" />
    86	    <title>Print barcode</title>
    87	    <style>
    88	      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; padding: 0; margin: 0; }
    89	      .wrap { display: grid; gap: 8px; justify-items: center; align-content: center; }
    90	      .title { font-size: 14px; font-weight: 700; text-align: center; }
    91	      .code { font-size: 12px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; text-align: center; word-break: break-all; }
    92	      ${pageStyle}
    93	    </style>
    94	  </head>
    95	  <body>
    96	    ${optionsList.map((options, index) => labelPageHtml(options, index, optionsList.length)).join('\n')}
    97	  </body>
    98	</html>`
    99	
   100	  if (window.__WMS_CAPTURE_PRINT_HTML__) {
   101	    window.__WMS_LAST_PRINT_HTML__ = html
   102	  }
   103	
   104	  const iframe = document.createElement('iframe')
   105	  iframe.setAttribute('aria-hidden', 'true')
   106	  iframe.style.position = 'fixed'
   107	  iframe.style.right = '0'
   108	  iframe.style.bottom = '0'
   109	  iframe.style.width = '0'
   110	  iframe.style.height = '0'
   111	  iframe.style.border = '0'
   112	  document.body.appendChild(iframe)
   113	
   114	  const cleanup = (reason: 'afterprint' | 'image-error') => {
   115	    if (window.__WMS_CAPTURE_PRINT_HTML__) {
   116	      window.__WMS_PRINT_CLEANUP_EVENTS__ = [
   117	        ...(window.__WMS_PRINT_CLEANUP_EVENTS__ ?? []),
   118	        reason,
   119	      ]
   120	    }
   121	    try {
   122	      document.body.removeChild(iframe)
   123	    } catch {
   124	      // ignore
   125	    }
   126	  }
   127	
   128	  const printNow = () => {
   129	    const w = iframe.contentWindow
   130	    if (!w) {
   131	      cleanup('image-error')
   132	      return
   133	    }
   134	    try {
   135	      w.focus()
   136	    } catch {
   137	      // ignore
   138	    }
   139	    setTimeout(() => {
   140	      // Нельзя удалять iframe сразу после print(): системное окно предпросмотра
   141	      // ещё читает data URL из этого документа. afterprint — единственный
   142	      // успешный конец печати; до него источник этикетки обязан оставаться жив.
   143	      w.addEventListener('afterprint', () => cleanup('afterprint'), { once: true })
   144	      try {
   145	        if (window.__WMS_CAPTURE_PRINT_HTML__) {
   146	          window.__WMS_PRINT_JOB_COUNT__ = (window.__WMS_PRINT_JOB_COUNT__ ?? 0) + 1
   147	        }
   148	        w.print()
   149	      } catch {
   150	        cleanup('image-error')
   151	      }
   152	    }, 100)
   153	  }
   154	
   155	  iframe.srcdoc = html
   156	  iframe.onload = () => {
   157	    const doc = iframe.contentDocument
   158	    const images = Array.from(doc?.querySelectorAll<HTMLImageElement>('img.barcode') ?? [])
   159	    if (images.length === 0) {
   160	      cleanup('image-error')
   161	      return
   162	    }
   163	    Promise.all(images.map((image) => image.decode()))
   164	      .then(printNow)
   165	      .catch(() => cleanup('image-error'))
   166	  }
   167	}
   168	
   169	/** Обратная совместимость для одиночной печати. */
   170	export function printBarcodeLabel(options: BarcodeLabelPrintOptions): void {
   171	  printBarcodeLabels([options])
   172	}
     1	/**
     2	 * Единый источник размеров этикетки для всех модалок печати.
     3	 * Дефолт 58×40 совпадает с ранее «зашитым» физическим размером термоэтикетки.
     4	 */
     5	
     6	export type LabelSizeId = '58x40' | '60x80' | '60x40' | '70x120'
     7	
     8	export type LabelSize = {
     9	  id: LabelSizeId
    10	  /** Подпись для выпадающего списка, напр. «58 × 40 мм». */
    11	  label: string
    12	  widthMm: number
    13	  heightMm: number
    14	}
    15	
    16	export const LABEL_SIZES: LabelSize[] = [
    17	  { id: '58x40', label: '58 × 40 мм', widthMm: 58, heightMm: 40 },
    18	  { id: '60x80', label: '60 × 80 мм', widthMm: 60, heightMm: 80 },
    19	  { id: '60x40', label: '60 × 40 мм', widthMm: 60, heightMm: 40 },
    20	  { id: '70x120', label: '70 × 120 мм', widthMm: 70, heightMm: 120 },
    21	]
    22	
    23	/** Дефолт — как было зашито в CSS печати до появления выбора. */
    24	export const DEFAULT_LABEL_SIZE_ID: LabelSizeId = '58x40'
    25	
    26	export const DEFAULT_LABEL_SIZE: LabelSize = LABEL_SIZES[0]!
    27	
    28	export function resolveLabelSize(id: LabelSizeId | null | undefined): LabelSize {
    29	  return LABEL_SIZES.find((size) => size.id === id) ?? DEFAULT_LABEL_SIZE
    30	}
    31	
    32	const STORAGE_KEY = 'wms.print.labelSizeId'
    33	
    34	/**
    35	 * Скоуп запоминания размера: при раздельной печати ЧЗ и ШК ВБ
    36	 * у каждого типа этикетки свой последний выбранный размер.
    37	 */
    38	export type LabelSizeScope = 'default' | 'cz' | 'label'
    39	
    40	function storageKey(scope: LabelSizeScope): string {
    41	  return scope === 'default' ? STORAGE_KEY : `${STORAGE_KEY}.${scope}`
    42	}
    43	
    44	function isLabelSizeId(value: unknown): value is LabelSizeId {
    45	  return typeof value === 'string' && LABEL_SIZES.some((size) => size.id === value)
    46	}
    47	
    48	/** Последний выбранный пользователем размер (или дефолт). Безопасно в тестах/SSR. */
    49	export function loadLabelSizeId(scope: LabelSizeScope = 'default'): LabelSizeId {
    50	  try {
    51	    const raw = window.localStorage.getItem(storageKey(scope))
    52	    if (isLabelSizeId(raw)) {
    53	      return raw
    54	    }
    55	  } catch {
    56	    // localStorage недоступен — используем дефолт
    57	  }
    58	  return DEFAULT_LABEL_SIZE_ID
    59	}
    60	
    61	export function saveLabelSizeId(id: LabelSizeId, scope: LabelSizeScope = 'default'): void {
    62	  try {
    63	    window.localStorage.setItem(storageKey(scope), id)
    64	  } catch {
    65	    // localStorage недоступен — молча пропускаем запоминание
    66	  }
    67	}
    68	
    69	export type LabelPrintOrientation = 'portrait' | 'landscape'
    70	
    71	const ORIENTATION_STORAGE_KEY = 'wms.print.labelOrientation.cz'
    72	
    73	export function loadLabelPrintOrientation(): LabelPrintOrientation {
    74	  try {
    75	    const raw = window.localStorage.getItem(ORIENTATION_STORAGE_KEY)
    76	    if (raw === 'landscape' || raw === 'portrait') {
    77	      return raw
    78	    }
    79	  } catch {
    80	    // localStorage недоступен
    81	  }
    82	  return 'portrait'
    83	}
    84	
    85	export function saveLabelPrintOrientation(orientation: LabelPrintOrientation): void {
    86	  try {
    87	    window.localStorage.setItem(ORIENTATION_STORAGE_KEY, orientation)
    88	  } catch {
    89	    // localStorage недоступен
    90	  }
    91	}
    92	
    93	/** Физический размер страницы печати с учётом ориентации. */
    94	export function resolvePrintPageSize(
    95	  size: LabelSize,
    96	  orientation: LabelPrintOrientation,
    97	): LabelSize {
    98	  if (orientation === 'portrait') {
    99	    return size
   100	  }
   101	  return { ...size, widthMm: size.heightMm, heightMm: size.widthMm }
   102	}

