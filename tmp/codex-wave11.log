   199	def _normalize_container(node: dict[str, Any]) -> dict[str, Any]:
   200	    children = [
   201	        _normalize_container(child) if child["kind"] != "product" else child
   202	        for child in node["children"]
   203	    ]
   204	    sellers: set[str] = set()
   205	
   206	    def collect(child: dict[str, Any]) -> None:
   207	        if child["kind"] == "product":
   208	            if child["seller_name"]:
   209	                sellers.add(child["seller_name"])
   210	            return
   211	        for nested in child["children"]:
   212	            collect(nested)
   213	
   214	    for child in children:
   215	        collect(child)
   216	    return {
   217	        **node,
   218	        "children": children,
   219	        "qty": sum(int(child["qty"]) for child in children),
   220	        "seller_name": next(iter(sellers)) if len(sellers) == 1 else None,
   221	    }
