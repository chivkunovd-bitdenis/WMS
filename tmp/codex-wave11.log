   132	            whiteSpace: 'nowrap',
   133	            overflow: 'hidden',
   134	            textOverflow: 'ellipsis',
   135	          }}
   136	        >
   137	          {row.kind === 'object' ? row.object.barcode : row.barcode}
   138	        </Typography>
   139	      ),
