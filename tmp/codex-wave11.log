   441	async def _container_location_id(
   442	    session: AsyncSession,
   443	    tenant_id: uuid.UUID,
   444	    warehouse_id: uuid.UUID,
   445	    kind: ContainerKind,
   446	    container_id: uuid.UUID,
   447	) -> uuid.UUID:
   448	    await validate_container(session, tenant_id, warehouse_id, kind, container_id)
   449	    if kind == "pallet":
   450	        pallet = await session.get(Pallet, container_id)
   451	        assert pallet is not None
   452	        if pallet.storage_location_id is not None:
   453	            return pallet.storage_location_id
   454	    if kind == "box":
   455	        box = await session.get(WarehouseBox, container_id)
   456	        if box is not None and box.tenant_id == tenant_id:
   457	            if box.pallet_id is not None:
   458	                pallet = await session.get(Pallet, box.pallet_id)
   459	                if pallet is not None and pallet.storage_location_id is not None:
   460	                    return pallet.storage_location_id
   461	            if box.storage_location_id is not None:
   462	                return box.storage_location_id
   463	    balance_location = await session.scalar(
   464	        select(InventoryBalance.storage_location_id)
   465	        .where(
   466	            InventoryBalance.tenant_id == tenant_id,
   467	            InventoryBalance.container_kind == kind,
   468	            InventoryBalance.container_id == container_id,
   469	            InventoryBalance.quantity > 0,
   470	        )
   471	        .limit(1)
   472	    )
   473	    if balance_location is not None:
   474	        location = await session.get(StorageLocation, balance_location)
   475	        if location is not None and location.warehouse_id == warehouse_id:
   476	            return balance_location
   477	    sorting = await get_or_create_sorting_location(session, tenant_id, warehouse_id)
   478	    return sorting.id
   479	
   480	
   481	async def _destination(
   482	    session: AsyncSession,
   483	    tenant_id: uuid.UUID,
   484	    warehouse_id: uuid.UUID,
   485	    to_kind: DestinationKind,
   486	    to_id: uuid.UUID | None,
   487	) -> tuple[uuid.UUID, ContainerKind | None, uuid.UUID | None, str]:
   488	    if to_kind == "cell":
   489	        if not await is_address_storage_enabled(session, tenant_id):
   490	            raise WarehouseMapError("address_storage_disabled")
   491	        if to_id is None:
   492	            raise WarehouseMapError("destination_required")
   493	        location = await session.get(StorageLocation, to_id)
   494	        if (
   495	            location is None
   496	            or location.tenant_id != tenant_id
   497	            or location.warehouse_id != warehouse_id
   498	            or location.deleted_at is not None
   499	            or location.code == SORTING_LOCATION_CODE
   500	        ):
   501	            raise WarehouseMapError("cell_not_found")
   502	        return location.id, None, None, f"Ячейка {location.code}"
   503	    if to_kind in {"unassigned", "sorting"}:
   504	        sorting = await get_or_create_sorting_location(session, tenant_id, warehouse_id)
   505	        return sorting.id, None, None, "Без ячеек"
   506	    if to_id is None:
   507	        raise WarehouseMapError("destination_required")
   508	    container_kind = cast(ContainerKind, to_kind)
   509	    try:
   510	        location_id = await _container_location_id(
   511	            session, tenant_id, warehouse_id, container_kind, to_id
   512	        )
   513	    except ValueError as exc:
   514	        raise WarehouseMapError("destination_not_found") from exc
   515	    code = await _container_code(session, tenant_id, warehouse_id, container_kind, to_id)
   516	    return location_id, container_kind, to_id, _container_title(container_kind, code)
   517	
   518	
   519	async def _container_code(
   520	    session: AsyncSession,
   521	    tenant_id: uuid.UUID,
   522	    warehouse_id: uuid.UUID,
   523	    kind: ContainerKind,
   524	    container_id: uuid.UUID,
   525	) -> str:
   526	    if kind == "pallet":
   527	        row = await session.get(Pallet, container_id)
   528	        if row is not None and row.tenant_id == tenant_id and row.warehouse_id == warehouse_id:
   529	            return row.code
   530	    elif kind == "box":
   531	        warehouse_box = await session.get(WarehouseBox, container_id)
   532	        if (
   533	            warehouse_box is not None
   534	            and warehouse_box.tenant_id == tenant_id
   535	            and warehouse_box.warehouse_id == warehouse_id
   536	        ):
   537	            return warehouse_box.internal_barcode
   538	        inbound = await session.scalar(
   539	            select(InboundIntakeBox)
   540	            .join(InboundIntakeRequest)
   541	            .where(
   542	                InboundIntakeBox.id == container_id,
   543	                InboundIntakeBox.tenant_id == tenant_id,
   544	                InboundIntakeRequest.warehouse_id == warehouse_id,
   545	            )
   546	        )
   547	        if inbound is not None:
   548	            return f"КР-{inbound.box_number:06d}"
   549	    else:
   550	        cargo = await session.scalar(
   551	            select(InboundIntakeCargoPlace)
   552	            .join(InboundIntakeRequest)
   553	            .where(
   554	                InboundIntakeCargoPlace.id == container_id,
   555	                InboundIntakeCargoPlace.tenant_id == tenant_id,
   556	                InboundIntakeRequest.warehouse_id == warehouse_id,
   557	            )
   558	        )
   559	        if cargo is not None:
   560	            return f"ГМ-{cargo.place_number:06d}"
   561	    raise WarehouseMapError("object_not_found")
