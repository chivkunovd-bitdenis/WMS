    14	} from '../../../ui-kit'
    15	import { CreateCellDialog } from '../warehouse-map/WarehouseMapToolbar'
    16	import { BoxLabelPrintDialog } from '../../../components/BoxLabelPrintDialog'
    17	import { LinearProgress } from '@mui/material'
    18	import { ObjectsTree } from './ObjectsTree'
    19	import {
    20	  CELLS,
    21	  INITIAL_LINES,
    22	  INITIAL_OBJECTS,
    23	  PRODUCTS,
    24	  KIND_TITLE,
    25	  cellQty,
    26	  cellRef,
    27	  productById,
    28	  type Cell,
    29	  type GoodsLine,
    30	  type Holder,
    31	  type Product,
    32	  whereIs,
    33	  type ObjKind,
    34	  type WarehouseObject,
    35	} from './objectsStub'
    36	import {
    37	  canPut,
    38	  cellRows,
    39	  destinationsFor,
    40	  objectTitle,
    41	  unplacedRows,
    42	  type Carried,
    43	  type ObjectRow,
    44	} from './objectsRows'
    45	
    46	// Раскладка объектами.
    47	//
    48	// Порядок работы обратный привычному: сначала собираем объект — товар в короб,
    49	// короб на палету, — и только готовый объект ставим на полку. Где лежит товар,
    50	// отдельно не хранится: это вычисляется по цепочке держателей, поэтому «что в
    51	// коробе» и «где короб» не могут разъехаться. Это одно знание.
    52	//
    53	// Список один. Короба, палеты и грузоместа стоят в нём как агрегаты со своим
    54	// содержимым внутри, товар россыпью — такими же строками верхнего уровня, а
    55	// разница между «ещё не поставлено» и «стоит на полке» видна колонкой «Где».
    56	
    57	/**
    58	 * Экран работает и от сервера, и от заглушки.
    59	 *
    60	 * Данные приходят пропсами, без них берутся выдуманные: превью макета обязано
    61	 * открываться без сервера, иначе посмотреть на экран можно будет только после
    62	 * готового бэка, а смотреть надо раньше.
    63	 */
    64	type SortingScreenProps = {
    65	  onNote: (note: string) => void
    66	  initialObjects?: WarehouseObject[]
    67	  initialLines?: GoodsLine[]
    68	  products?: Product[]
    69	  initialCells?: Cell[]
    70	  /** Поставить объект или товар на ячейку. Без него экран двигает только себя. */
    71	  onPlace?: (payload: {
    72	    kind: ObjKind | 'product'
    73	    id: string
    74	    cellId: string | null
    75	    toId: string | null
    76	    qty: number
    77	  }) => void
    78	}
    79	
    80	export function SortingObjectsScreen({
    81	  onNote,
    82	  initialObjects,
    83	  initialLines,
    84	  products: productsProp,
    85	  initialCells,
    86	  onPlace,
    87	}: SortingScreenProps) {
    88	  const theme = useTheme()
    89	  const products = productsProp ?? PRODUCTS
    90	  const [objects, setObjects] = useState<WarehouseObject[]>(initialObjects ?? INITIAL_OBJECTS)
    91	  const [lines, setLines] = useState<GoodsLine[]>(initialLines ?? INITIAL_LINES)
    92	  const [collapsed, setCollapsed] = useState<Set<string>>(new Set())
    93	  const [carried, setCarried] = useState<Carried | null>(null)
    94	  const [activeCellId, setActiveCellId] = useState<string | null>(null)
    95	  const [scanValue, setScanValue] = useState('')
    96	  const [scanError, setScanError] = useState<string | null>(null)
    97	  const [scanNotice, setScanNotice] = useState<string | null>(null)
    98	  const [asking, setAsking] = useState<Carried | null>(null)
    99	  const [askTarget, setAskTarget] = useState('')
   100	  const [askQty, setAskQty] = useState<number | null>(null)
   101	  const [created, setCreated] = useState(0)
   102	  const [printing, setPrinting] = useState<string | null>(null)
   103	  const [cellDialogOpen, setCellDialogOpen] = useState(false)
   104	  const [extraCells, setExtraCells] = useState<typeof CELLS>([])
   105	
   106	  const cells = [...(initialCells ?? CELLS), ...extraCells]
   107	  const activeCell = cells.find((one) => one.id === activeCellId) ?? null
   108	  const loose = lines.filter((line) => line.holder === null)
   109	  const unplaced = objects.filter((one) => one.holder === null)
   110	  const totalQty = lines.reduce((sum, line) => sum + line.qty, 0)
   111	  const leftQty = lines
   112	    .filter((line) => !whereIs(line.holder, objects, cells).cell)
   113	    .reduce((sum, line) => sum + line.qty, 0)
   114	
   115	  function toggle(objectId: string) {
   116	    setCollapsed((current) => {
   117	      const next = new Set(current)
   118	      if (next.has(objectId)) next.delete(objectId)
   119	      else next.add(objectId)
   120	      return next
   121	    })
   122	  }
   123	
   124	  /** Куда именно поставили: ячейка или другой объект. Сервер различает их. */
   125	  function targetParts(target: Holder): { cellId: string | null; toId: string | null } {
   126	    if (!target) return { cellId: null, toId: null }
   127	    if (target.startsWith('cell:')) return { cellId: target.slice(5), toId: null }
   128	    return { cellId: null, toId: target.slice(4) }
   129	  }
   130	
   131	  function moveGoods(line: GoodsLine, qty: number, target: Holder) {
   132	    // Экран двигает у себя сразу, не дожидаясь сервера: оператор ставит короба
   133	    // подряд, и пауза на каждый ответ превращает раскладку в ожидание.
   134	    onPlace?.({ kind: 'product', id: line.productId, qty, ...targetParts(target) })
   135	    setLines((current) => {
   136	      const rest = current.filter((one) => one.id !== line.id)
   137	      const left = line.qty - qty
   138	      const twin = rest.find((one) => one.productId === line.productId && one.holder === target)
   139	      const withTarget = twin
   140	        ? rest.map((one) => (one === twin ? { ...one, qty: one.qty + qty } : one))
   141	        : [...rest, { id: `l-${Date.now()}-${line.id}`, productId: line.productId, qty, holder: target }]
   142	      return left > 0 ? [...withTarget, { ...line, qty: left }] : withTarget
   143	    })
   144	  }
   145	
   146	  function moveObject(object: WarehouseObject, target: Holder, label: string) {
   147	    onPlace?.({ kind: object.kind, id: object.id, qty: 1, ...targetParts(target) })
   148	    setObjects((current) => current.map((one) => (one.id === object.id ? { ...one, holder: target } : one)))
   149	    onNote(`${KIND_TITLE[object.kind]} ${object.code} → ${label}`)
   150	  }
   151	
   152	  function labelOf(target: Holder): string {
   153	    if (!target) return 'россыпь'
   154	    if (target.startsWith('cell:')) {
   155	      const cell = cells.find((one) => cellRef(one.id) === target)
   156	      return cell ? `ячейку ${cell.code}` : 'ячейку'
   157	    }
   158	    const object = objects.find((one) => `obj:${one.id}` === target)
   159	    return object ? objectTitle(object) : 'объект'
   160	  }
   161	
   162	  /** Перетащили: контейнер едет целиком, у товара спрашиваем количество. */
   163	  function drop(target: Holder) {
   164	    if (!carried) return
   165	    if (!canPut(carried, target, objects)) {
   166	      setCarried(null)
   167	      return
   168	    }
   169	    if (carried.kind === 'object') {
   170	      moveObject(carried.object, target, labelOf(target))
   171	    } else {
   172	      openDialog(carried, target)
   173	    }
   174	    setCarried(null)
   175	  }
   176	
   177	  /** Снять с ячейки: уезжает целиком и вместе с содержимым, без вопросов. */
   178	  function takeOffCell(row: ObjectRow) {
   179	    if (row.kind === 'goods') {
   180	      moveGoods(row.line, row.line.qty, null)
   181	      return
   182	    }
   183	    setObjects((current) =>
   184	      current.map((one) => (one.id === row.object.id ? { ...one, holder: null } : one)),
   185	    )
   186	    onNote(`${KIND_TITLE[row.object.kind]} ${row.object.code} снят с ячейки`)
   187	  }
   188	
   189	  /** Вынуть наружу: то же окно, но место уже выбрано — россыпь. */
   190	  function takeOut(row: ObjectRow) {
   191	    openDialog(
   192	      row.kind === 'goods' ? { kind: 'goods', line: row.line } : { kind: 'object', object: row.object },
   193	      null,
   194	    )
   195	  }
   196	
   197	  /** Нажали плюс: то же самое, только место выбирается в диалоге. */
   198	  function openDialog(what: Carried, target?: Holder) {
   199	    setAsking(what)
   200	    setAskTarget(target === undefined ? (activeCell ? cellRef(activeCell.id) : '') : (target ?? 'none'))
   201	    setAskQty(what.kind === 'goods' ? what.line.qty : null)
   202	  }
   203	
   204	  function confirmDialog() {
   205	    if (!asking) return
   206	    const target: Holder = askTarget === 'none' || askTarget === '' ? null : askTarget
   207	    if (asking.kind === 'object') {
   208	      moveObject(asking.object, target, labelOf(target))
   209	    } else if (askQty && askQty > 0) {
   210	      moveGoods(asking.line, Math.min(askQty, asking.line.qty), target)
   211	    }
   212	    setAsking(null)
   213	  }
   214	
   215	  function createObject(kind: ObjKind) {
   216	    const number = created + 1
   217	    setCreated(number)
   218	    const code =
   219	      kind === 'pallet'
   220	        ? `П-${String(200 + number).padStart(6, '0')}`
   221	        : kind === 'box'
   222	          ? `КР-${String(500 + number).padStart(6, '0')}`
   223	          : `ГМ-${String(400 + number).padStart(6, '0')}`
   224	    setObjects((current) => [
   225	      ...current,
   226	      { id: `new-${number}`, kind, code, barcode: `29${String(number).padStart(11, '0')}`, holder: null },
   227	    ])
   228	    onNote(`Заглушка: создан ${KIND_TITLE[kind].toLowerCase()} ${code}`)
   229	  }
   230	
   231	  function handleScan(code: string) {
   232	    setScanValue('')
   233	    const cell = cells.find((one) => one.barcode === code || one.code.toLowerCase() === code.toLowerCase())
   234	    if (cell) {
   235	      setActiveCellId(cell.id)
   236	      setScanError(null)
   237	      setScanNotice(`Ячейка ${cell.code} — плюс у строки поставит сюда`)
   238	      return
   239	    }
   240	    const object = objects.find((one) => one.barcode === code)
   241	    if (object) {
   242	      if (!activeCell) {
   243	        setScanNotice(null)
   244	        setScanError('Сначала пикните ячейку — иначе непонятно, куда ставим')
   245	        return
   246	      }
   247	      moveObject(object, cellRef(activeCell.id), `ячейку ${activeCell.code}`)
   248	      setScanError(null)
   249	      setScanNotice(`${KIND_TITLE[object.kind]} ${object.code} → ячейка ${activeCell.code}`)
   250	      return
   251	    }
   252	    setScanNotice(null)
   253	    setScanError(`Штрихкод ${code} — ни ячейка, ни объект этой приёмки`)
   254	  }
   255	
   256	  const destinations = asking ? destinationsFor(asking, objects, cells) : []
   257	
   258	  return (
   259	    <Box data-testid="sorting-objects-screen">
   260	      <ScreenHeader
   261	        title="Раскладка по ячейкам"
   262	        purpose="Приёмка №1284 от 27.08.2026. Собираем объект и ставим готовый объект на полку."
   263	      />
   264	
   265	      <Paper variant="outlined" sx={{ p: 2, mb: 2 }}>
   266	        <Stack spacing={1.5}>
   267	          <ScannerField
   268	            value={scanValue}
   269	            onChange={(value) => {
   270	              setScanValue(value)
   271	              setScanError(null)
   272	            }}
   273	            onScan={handleScan}
   274	            expects={activeCell ? 'объект, который ставим' : 'ячейку с полки'}
   275	            error={scanError}
   276	            notice={scanNotice}
   277	            testId="objects-scan"
   278	          />
   279	        </Stack>
   280	      </Paper>
   281	
   282	      <Stack direction={{ xs: 'column', lg: 'row' }} spacing={2} sx={{ alignItems: 'flex-start' }}>
   283	        <Box sx={{
   284	            flexShrink: 0,
   285	            minWidth: 0,
   286	            // Ширина по содержимому, но не больше доли строки: числом её задавать
   287	            // нельзя — при другой ширине окна число всегда неверное. Доля же
   288	            // работает и на ноутбуке, и на большом мониторе.
   289	            // Ширина ровно по содержимому таблицы: она не тянется на пустоту и не
   290	            // жмёт названия. Число здесь задавать нельзя — при другой ширине окна
   291	            // оно всегда неверное.
   292	            width: { lg: 'max-content' },
   293	            // Предел только чтобы правая панель не схлопнулась совсем.
   294	            maxWidth: { xs: '100%', lg: 'calc(100% - 320px)' },
   295	          }}>
   296	          <Stack spacing={1} sx={{ mb: 1.5 }}>
   297	            <Stack direction="row" spacing={2} sx={{ alignItems: 'baseline' }}>
   298	              <Typography variant="h5" data-testid="objects-left-qty">
   299	                {leftQty.toLocaleString('ru-RU')}
   300	              </Typography>
   301	              <Typography variant="body2" color="text.secondary">
   302	                штук осталось поставить из {totalQty.toLocaleString('ru-RU')} принятых —
   303	                это {unplaced.length} объектов и {loose.length} позиций россыпью
   304	              </Typography>
   305	            </Stack>
   306	            <LinearProgress
   307	              variant="determinate"
   308	              value={totalQty === 0 ? 0 : ((totalQty - leftQty) / totalQty) * 100}
   309	              sx={{ height: 8, borderRadius: 4 }}
   310	            />
   311	          </Stack>
   312	          <Stack
   313	            direction="row"
   314	            spacing={1}
   315	            sx={{ mb: 1.5, alignItems: 'center', flexWrap: 'wrap', gap: 1, justifyContent: 'flex-end' }}
   316	          >
   317	            <SecondaryAction onClick={() => setCellDialogOpen(true)} data-testid="objects-create-cell">
   318	              Создать ячейку
   319	            </SecondaryAction>
   320	            <SecondaryAction onClick={() => createObject('pallet')} data-testid="objects-create-pallet">
   321	              Новая палета
   322	            </SecondaryAction>
   323	            <SecondaryAction onClick={() => createObject('box')} data-testid="objects-create-box">
   324	              Новый короб
   325	            </SecondaryAction>
   326	            <SecondaryAction
   327	              onClick={() => createObject('cargo_place')}
   328	              data-testid="objects-create-cargo_place"
   329	            >
   330	              Новое грузоместо
   331	            </SecondaryAction>
   332	          </Stack>
   333	          <ObjectsTree
   334	            rows={unplacedRows(objects, lines, products, collapsed)}
   335	            objects={objects}
   336	            carried={carried}
   337	            testId="objects-tree"
   338	            empty={{
   339	              title: 'Всё расставлено по ячейкам',
   340	              hint: 'Ни товара россыпью, ни собранных объектов не осталось.',
   341	            }}
   342	            onToggle={toggle}
   343	            onPlace={(row: ObjectRow) =>
   344	              openDialog(
   345	                row.kind === 'goods' ? { kind: 'goods', line: row.line } : { kind: 'object', object: row.object },
   346	              )
   347	            }
   348	            onDragStart={(row: ObjectRow) =>
   349	              setCarried(
   350	                row.kind === 'goods' ? { kind: 'goods', line: row.line } : { kind: 'object', object: row.object },
   351	              )
   352	            }
   353	            onDragEnd={() => setCarried(null)}
   354	            onDropOn={drop}
   355	            onTakeOut={takeOut}
   356	            onMinus={takeOffCell}
   357	            onPrint={(row) => setPrinting(row.kind === 'object' ? objectTitle(row.object) : row.name)}
   358	            onPickCell={setActiveCellId}
   359	          />
   360	        </Box>
   361	
   362	        <Stack spacing={2} sx={{ flexGrow: 1, minWidth: 0, width: '100%' }}>
   363	          <Paper variant="outlined" sx={{ p: 2 }} data-testid="objects-cells">
   364	            <Typography variant="subtitle1" sx={{ mb: 1.5 }}>
   365	              Ячейки склада
   366	            </Typography>
   367	            <Stack direction="row" spacing={1} sx={{ flexWrap: 'wrap', gap: 1 }}>
   368	              {cells.map((cell) => {
   369	                const active = activeCellId === cell.id
   370	                const qty = cellQty(cell.id, objects, lines)
   371	                const target = Boolean(carried && canPut(carried, cellRef(cell.id), objects))
   372	                return (
   373	                  <Box
   374	                    key={cell.id}
   375	                    role="button"
   376	                    tabIndex={0}
   377	                    onClick={() => setActiveCellId(cell.id)}
   378	                    onKeyDown={(event) => {
   379	                      if (event.key === 'Enter' || event.key === ' ') setActiveCellId(cell.id)
   380	                    }}
   381	                    onDragOver={(event) => {
   382	                      if (target) event.preventDefault()
   383	                    }}
   384	                    onDrop={() => {
   385	                      setActiveCellId(cell.id)
   386	                      drop(cellRef(cell.id))
   387	                    }}
   388	                    data-testid={`objects-cell-${cell.id}`}
   389	                    sx={{
   390	                      px: 1.25,
   391	                      py: 0.6,
   392	                      borderRadius: 1.5,
   393	                      cursor: 'pointer',
   394	                      border: '1px solid',
   395	                      borderColor: active ? 'primary.main' : 'divider',
   396	                      backgroundColor: active ? alpha(theme.palette.primary.main, 0.08) : 'transparent',
   397	                      outline: target && !active ? `1px dashed ${alpha(theme.palette.primary.main, 0.45)}` : 'none',
   398	                      outlineOffset: '-3px',
   399	                    }}
   400	                  >
   401	                    <Typography variant="body2" sx={{ fontWeight: 600, whiteSpace: 'nowrap' }}>
   402	                      {cell.code}
   403	                    </Typography>
   404	                    <Typography variant="caption" color="text.secondary">
   405	                      {qty === 0 ? 'пусто' : `${qty} шт`}
   406	                    </Typography>
   407	                  </Box>
   408	                )
   409	              })}
   410	            </Stack>
   411	          </Paper>
   412	          {activeCell ? (
   413	            <Paper
   414	          variant="outlined"
   415	          sx={{
   416	            p: 2,
   417	            outline:
   418	              carried && canPut(carried, cellRef(activeCell.id), objects)
   419	                ? `2px dashed ${alpha(theme.palette.primary.main, 0.5)}`
   420	                : 'none',
   421	            outlineOffset: '-4px',
   422	          }}
   423	          onDragOver={(event) => {
   424	            if (carried && canPut(carried, cellRef(activeCell.id), objects)) event.preventDefault()
   425	          }}
   426	          onDrop={() => drop(cellRef(activeCell.id))}
   427	          data-testid="objects-active-cell"
   428	            >
   429	          <Stack direction="row" spacing={1} sx={{ mb: 1, alignItems: 'center' }}>
   430	            {/* Код ячейки не переносится на вторую строку (канон R-36):
   431	                заголовок, разорванный пополам, перестаёт читаться как код. */}
   432	            <Typography variant="h6" sx={{ whiteSpace: 'nowrap' }}>
   433	              {activeCell.code}
   434	            </Typography>
   435	            <Typography
   436	              variant="body2"
   437	              color="text.secondary"
   438	              sx={{ minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}
   439	            >
   440	              {cellQty(activeCell.id, objects, lines)} шт — по составу того, что стоит
   441	            </Typography>
   442	            <Box sx={{ flexGrow: 1 }} />
   443	            <PrintAction
   444	              what="ШК ячейки"
   445	              placement="row"
   446	              onClick={() => setPrinting(`ячейка ${activeCell.code}`)}
   447	              testId="objects-print-cell"
   448	            />
   449	          </Stack>
   450	          <ObjectsTree
   451	            rows={cellRows(activeCell, objects, lines, products, collapsed)}
   452	            objects={objects}
   453	            carried={carried}
   454	            testId="objects-cell-tree"
   455	            compact
   456	            empty={{ title: 'На ячейке пусто', hint: 'Перетащите сюда объект или нажмите плюс в списке.' }}
   457	            onToggle={toggle}
   458	            onPlace={(row: ObjectRow) =>
   459	              openDialog(
   460	                row.kind === 'goods'
   461	                  ? { kind: 'goods', line: row.line }
   462	                  : { kind: 'object', object: row.object },
   463	              )
   464	            }
   465	            onDragStart={(row: ObjectRow) =>
   466	              setCarried(
   467	                row.kind === 'goods'
   468	                  ? { kind: 'goods', line: row.line }
   469	                  : { kind: 'object', object: row.object },
   470	              )
   471	            }
   472	            onDragEnd={() => setCarried(null)}
   473	            onDropOn={drop}
   474	            onTakeOut={takeOut}
   475	            onMinus={takeOffCell}
   476	            onPrint={(row) => setPrinting(row.kind === 'object' ? objectTitle(row.object) : row.name)}
   477	            onPickCell={setActiveCellId}
   478	          />
   479	            </Paper>
   480	          ) : null}
   481	
   482	        </Stack>
   483	      </Stack>
   484	
   485	      {/* Сортировка — это документ, и заканчивается он так же, как остальные
   486	          документы приёмки: сохранить черновик, завершить распределение, закрыть.
   487	          Отдельной кнопки «записать ячейку» здесь нет — записывается документ. */}
